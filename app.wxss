/**app.wxss**/

/* 已迁移至 TDesign 组件内联字体，移除此处全局字体与覆盖，避免绝对路径加载 */

page {
  --primary-color: #b8865c;
  --danger-color: #d24b41;
  --warning-color: #e6a15e;
  --bg-color: #f6f0e7;
  --card-bg: #fcfbf8;
  --text-main: #2c3e50;
  --text-sub: #6b6b6b;
  --border-radius: 20rpx;
  --shadow-sm: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 10rpx 28rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
  
  /* WeChat Green Theme */
  --wechat-green: #07C160;
  --wechat-green-dark: #06AD56;
  
  /* Package Pages Theme */
  --package-accent: #c9a86c;
  --package-accent-light: #f5efe3;
  --package-border: #efe7dc;
  --package-success: #5a8f7b;
  --package-card-radius: 24rpx;
  --package-item-radius: 16rpx;
  
  background-color: var(--bg-color);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
}

.tab-container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
}

.soft-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.soft-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}
