<view class="admin-container">
  <!-- 今日数据统计 -->
  <view class="section-header">
    <view class="section-title">今日数据概览</view>
  </view>
  <view class="stat-card-grid">
    <view class="stat-card" bindtap="onStatsTap" data-type="orders" hover-class="stat-card-hover">
      <view class="stat-card-value">{{todayStats.orders}}</view>
      <view class="stat-card-label">今日订单</view>
    </view>
    <view class="stat-card" bindtap="onStatsTap" data-type="users" hover-class="stat-card-hover">
      <view class="stat-card-value">{{todayStats.users}}</view>
      <view class="stat-card-label">用户总数</view>
    </view>
    <view class="stat-card">
      <view class="stat-card-value stat-card-value-highlight">¥{{todayStats.sales}}</view>
      <view class="stat-card-label">今日销售</view>
    </view>
    <view class="stat-card">
      <view class="stat-card-value stat-card-value-highlight">¥{{todayStats.revenue}}</view>
      <view class="stat-card-label">总收入</view>
    </view>
  </view>

  <!-- 订单状态分布（单一主状态） -->
  <view class="section-header">
    <view class="section-title">订单状态</view>
  </view>
  <view class="order-status-grid">
    <view class="status-item" bindtap="onStatusTap" data-workflow-milestone="{{workflowMilestoneFilters.pendingPayment}}">
      <view class="status-count status-pending">{{mainStatus.pendingPayment}}</view>
      <view class="status-label">待确认</view>
      <view class="status-hint">待认领/待确认</view>
    </view>
    <view class="status-item" bindtap="onStatusTap" data-workflow-milestone="{{workflowMilestoneFilters.confirmedReady}}">
      <view class="status-count status-wait-service">{{mainStatus.waitService}}</view>
      <view class="status-label">待服务</view>
      <view class="status-hint">已确认待安排</view>
    </view>
    <view class="status-item" bindtap="onStatusTap" data-workflow-milestone="{{workflowMilestoneFilters.processing}}">
      <view class="status-count status-processing">{{mainStatus.processing}}</view>
      <view class="status-label">服务中</view>
      <view class="status-hint">正在执行</view>
    </view>
    <view class="status-item" bindtap="onStatusTap" data-workflow-milestone="{{workflowMilestoneFilters.serviceDone}}">
      <view class="status-count status-served-unpaid">{{mainStatus.serviceDone}}</view>
      <view class="status-label">待尾款</view>
      <view class="status-hint">服务已完成</view>
    </view>
    <view class="status-item" bindtap="onStatusTap" data-workflow-milestone="{{workflowMilestoneFilters.completed}}">
      <view class="status-count status-completed">{{mainStatus.completed}}</view>
      <view class="status-label">已完成</view>
      <view class="status-hint">服务+付款完成</view>
    </view>
    <view class="status-item" bindtap="onStatusTap" data-workflow-milestone="{{workflowMilestoneFilters.cancelled}}">
      <view class="status-count status-cancelled">{{mainStatus.cancelled}}</view>
      <view class="status-label">已取消</view>
      <view class="status-hint">流程终止</view>
    </view>
  </view>
  
  <!-- 功能模块导航 - 卡片样式 -->
  <view class="section-header">
    <view class="section-title">功能模块</view>
  </view>
  <view class="module-card-grid">
    <view 
      class="module-card"
      wx:for="{{modules}}"
      wx:key="id"
      bindtap="onModuleTap"
      data-path="{{item.path}}"
      hover-class="module-card-hover"
    >
      <view class="module-card-icon">{{item.icon}}</view>
      <view class="module-card-content">
        <view class="module-card-name">{{item.name}}</view>
        <view class="module-card-desc">{{item.desc}}</view>
      </view>
      <view class="module-card-arrow">
        <text class="module-card-arrow-icon">›</text>
      </view>
    </view>
  </view>
  
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>
</view>
