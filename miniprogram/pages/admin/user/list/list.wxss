/* 用户管理页面 - 参考订单列表样式 */
.admin-users-container {
  padding: 24rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 页面标题 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-main, #333);
}

.stats-info {
  font-size: 26rpx;
  color: #999;
}

/* 搜索区域 - 卡片式 */
.search-container {
  display: flex;
  margin-bottom: 24rpx;
  background: #fff;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  align-items: center;
}

.search-box {
  flex: 1;
  min-width: 0;
  position: relative;
}

.search-input {
  width: 100%;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 70rpx 0 28rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.search-icon {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}

.search-icon-text {
  font-size: 32rpx;
  line-height: 1;
}

/* 标签页样式 - 与订单列表统一 */
.tabs {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  background-color: #fff;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  padding: 8rpx 16rpx;
}

.tabs::-webkit-scrollbar {
  display: none;
}

.tab-item {
  flex: 0 0 auto;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-sub, #666);
  position: relative;
  white-space: nowrap;
  transition: all 0.3s ease;
  border-radius: 24rpx;
  margin: 4rpx;
}

.tab-item.active {
  color: var(--admin-primary);
  font-weight: 600;
  background: var(--admin-primary-light);
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 6rpx;
  background-color: var(--admin-primary);
  border-radius: 3rpx;
}

/* 用户列表区域 */
.user-list {
  padding-bottom: 40rpx;
}

/* 加载状态 */
.loading-wrapper {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

.loading-text {
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* 用户卡片 - 与订单卡片统一 */
.user-item {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  position: relative;
}

/* 左侧状态条装饰 - 默认灰色 */
.user-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: #d9d9d9;
  border-radius: 8rpx 0 0 8rpx;
}

/* 管理员状态条 - 蓝色 */
.user-item.status-admin::before {
  background: var(--admin-primary);
}

/* 禁用状态条 - 红色 */
.user-item.status-disabled::before {
  background: var(--danger-color, #e34d59);
}

.user-item:active {
  transform: scale(0.985);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 卡片头部 */
.user-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 24rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: linear-gradient(135deg, #fafafa 0%, #ffffff 100%);
}

.user-avatar {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.user-avatar-image,
.user-avatar-fallback {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
}

.user-avatar-image {
  display: block;
}

.user-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--admin-primary-light);
  color: var(--admin-primary);
  font-size: 28rpx;
  font-weight: 600;
}

.user-name {
  font-size: 28rpx;
  color: var(--text-sub, #666);
  font-family: 'SF Mono', 'Monaco', 'Menlo', monospace;
  letter-spacing: 0.5rpx;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 状态标签样式 - 与订单状态统一 */
.user-status {
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  letter-spacing: 1rpx;
  margin-left: auto;
}

/* 管理员标签 - 主色 */
.status-tag-admin {
  color: var(--admin-primary);
  background: var(--admin-primary-light);
  border: 1rpx solid rgba(160, 114, 78, 0.2);
}

/* 普通用户标签 - 灰色 */
.status-tag-normal {
  color: #666;
  background: linear-gradient(135deg, #f5f5f5 0%, #eeeeee 100%);
  border: 1rpx solid rgba(153, 153, 153, 0.2);
}

/* 禁用标签 - 红色 */
.status-tag-disabled {
  color: #e34d59;
  background: linear-gradient(135deg, #fef0f0 0%, #fde2e2 100%);
  border: 1rpx solid rgba(227, 77, 89, 0.2);
}

/* 信息区域 */
.user-info {
  padding: 24rpx 32rpx 24rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: var(--text-main, #333);
  line-height: 1.6;
  align-items: flex-start;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  color: var(--text-sub, #999);
  margin-right: 12rpx;
  min-width: 140rpx;
  flex-shrink: 0;
}

.id-text {
  font-family: 'SF Mono', 'Monaco', 'Menlo', monospace;
  font-size: 24rpx;
  color: #666;
  word-break: break-all;
}

/* 操作按钮区 */
.user-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  padding: 20rpx 32rpx 20rpx 40rpx;
  background-color: #fafafa;
  gap: 16rpx;
}

/* 底部加载状态 */
.footer-status {
  padding: 32rpx 0 48rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.load-more {
  text-align: center;
  color: var(--admin-primary);
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(160, 114, 78, 0.12);
}

.load-more:active {
  background: #f5f5f5;
}

.no-more {
  text-align: center;
  color: #bbb;
  font-size: 26rpx;
}

/* 用户详情弹窗样式 */
.detail-popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-popup-container {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.detail-popup-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  padding: 32rpx 32rpx 24rpx;
}

.detail-popup-content {
  padding: 0 32rpx 24rpx;
}

.detail-row {
  display: flex;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.detail-row:last-child {
  margin-bottom: 0;
}

.detail-label {
  color: #999;
  width: 160rpx;
  flex-shrink: 0;
  text-align: right;
  padding-right: 16rpx;
}

.detail-value {
  color: #333;
  flex: 1;
  word-break: break-all;
}

.detail-id {
  font-family: 'SF Mono', 'Monaco', 'Menlo', monospace;
  font-size: 24rpx;
  color: #666;
}

.detail-popup-footer {
  padding: 16rpx 32rpx 32rpx;
}

.detail-popup-btn {
  text-align: center;
  padding: 24rpx;
  font-size: 32rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 12rpx;
}
