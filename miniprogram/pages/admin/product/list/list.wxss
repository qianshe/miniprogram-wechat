.admin-products-container {
  padding: 24rpx;
  background-color: var(--bg-color);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 头部样式 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  padding: 10rpx 0 30rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-main);
  letter-spacing: -1rpx;
  line-height: 1.2;
  white-space: nowrap;
  flex-shrink: 0;
}

.action-buttons {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  width: 420rpx;
  flex: 0 0 420rpx;
}

.action-btn-item,
.action-btn {
  width: 100%;
}

/* 搜索区域 */
.search-container {
  display: flex;
  padding: 20rpx 24rpx;
  background: #fff;
  align-items: center;
  margin-bottom: 20rpx;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
  position: sticky;
  top: 0;
  z-index: 99;
}

.search-box {
  flex: 1;
  min-width: 0;
  position: relative;
}

.search-input {
  width: 100%;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 70rpx 0 28rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.search-icon {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}

.search-icon-text {
  font-size: 32rpx;
  line-height: 1;
}

.category-filter-btn {
  min-width: 140rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  padding: 0 20rpx;
  background: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: var(--text-main);
  border: 1rpx solid #eee;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
}

.category-filter-btn:active {
  background-color: #f5f5f5;
}

.category-filter-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  margin-left: 8rpx;
  font-size: 24rpx;
  line-height: 1;
  font-weight: 600;
}

.filter-close-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  color: #666;
  font-size: 40rpx;
  line-height: 1;
}

.picker-check {
  color: var(--primary-color);
  font-size: 28rpx;
  line-height: 1;
  font-weight: 600;
}

.category-filter-btn.active {
  color: var(--primary-color);
  border-color: var(--primary-color);
  background-color: rgba(var(--primary-color-rgb), 0.05);
}

/* 排序选项 */
.sort-options {
  display: flex;
  background: var(--card-bg);
  padding: 8rpx;
  border-radius: var(--border-radius);
  margin-bottom: 30rpx;
  box-shadow: var(--shadow-sm);
}

.sort-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-sub);
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.sort-item.active {
  color: var(--primary-color);
  font-weight: 600;
  background-color: rgba(184, 134, 92, 0.1); /* primary-color with opacity */
}

.sort-icon {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  margin-left: 8rpx;
  opacity: 0.3;
  transition: all 0.3s;
}

.sort-item.active .sort-icon {
  opacity: 1;
}

.sort-icon.asc {
  border-bottom: 10rpx solid currentColor;
}

.sort-icon.desc {
  border-top: 10rpx solid currentColor;
}

/* 产品列表 */
.product-list {
  padding-bottom: 40rpx;
}

.product-item {
  display: flex;
  background: var(--card-bg);
  border-radius: var(--border-radius);
  margin-bottom: 24rpx;
  padding: 24rpx;
  position: relative;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s ease;
  overflow: hidden;
}

.product-item:active {
  transform: scale(0.995);
  box-shadow: var(--shadow-md);
}

.product-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-right: 24rpx;
  position: relative;
  background-color: #f2f3f5;
  flex-shrink: 0;
}

.product-thumb image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.product-item:active .product-thumb image {
  transform: scale(1.05);
}

.product-status {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
  border-radius: 8rpx;
  backdrop-filter: blur(4px);
  z-index: 1;
}

.status-on {
  background-color: var(--wechat-green);
}

.status-off {
  background-color: rgba(0, 0, 0, 0.5);
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0; /* 防止文本溢出 */
}

.product-header {
  margin-bottom: 12rpx;
}

.product-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.product-category {
  font-size: 22rpx;
  color: var(--primary-color);
  background: rgba(184, 134, 92, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.product-meta {
  display: flex;
  align-items: baseline;
  margin-top: auto;
  margin-bottom: 16rpx;
}

.product-price {
  font-size: 40rpx;
  color: var(--danger-color);
  font-weight: 800;
  margin-right: 12rpx;
  display: flex;
  align-items: baseline;
}

.currency {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.original-price {
  font-size: 24rpx;
  color: #bbb;
}

.product-stats {
  font-size: 24rpx;
  color: var(--text-sub);
  display: flex;
  gap: 20rpx;
}

.product-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  border-top: 1rpx solid rgba(0,0,0,0.05);
  padding-top: 20rpx;
  margin-top: 20rpx;
}

/* 骨架屏样式 */
.skeleton-list {
  padding-bottom: 30rpx;
}

.skeleton-item {
  background: var(--card-bg);
  border-radius: var(--border-radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
}

.skeleton-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: rgba(0,0,0,0.05);
  margin-right: 24rpx;
  animation: skeleton-blink 1.5s infinite ease-in-out;
}

.skeleton-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.skeleton-row {
  height: 32rpx;
  background: rgba(0,0,0,0.05);
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  animation: skeleton-blink 1.5s infinite ease-in-out;
}

.skeleton-row.short {
  width: 40%;
}

.skeleton-row.medium {
  width: 70%;
}

.skeleton-row.long {
  width: 90%;
}

@keyframes skeleton-blink {
  0% { opacity: 0.6; }
  50% { opacity: 1; }
  100% { opacity: 0.6; }
}

/* 加载更多 */
.load-more, .no-more {
  text-align: center;
  color: var(--text-sub);
  font-size: 24rpx;
  padding: 30rpx 0;
}

.loading-spinner {
  display: inline-block;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 12rpx;
  vertical-align: middle;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 筛选弹窗样式 - 与订单管理保持一致 */
.filter-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 999;
}

.filter-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  padding: 0 0 env(safe-area-inset-bottom);
}

.filter-panel {
  background: #fff;
  padding: 30rpx 30rpx 24rpx;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
  max-height: 72vh;
  overflow: auto;
}

.filter-header {
  padding: 0 0 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2rpx solid #e8e8e8;
}

.filter-header text {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.filter-content {
  padding: 32rpx 0;
  max-height: 60vh;
  overflow-y: auto;
}

.category-list {
  display: flex;
  flex-direction: column;
}

.category-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 20rpx;
  font-size: 28rpx;
  color: var(--text-main);
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  transition: all 0.3s ease;
}

.category-item:active {
  background-color: #f5f5f5;
}

.category-item.active {
  color: var(--primary-color);
  background: rgba(184, 134, 92, 0.08);
  font-weight: 600;
}
