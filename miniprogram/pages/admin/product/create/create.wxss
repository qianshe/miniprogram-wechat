.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.page-header {
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.form-content {
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  padding-bottom: 40rpx;
}

.upload-container {
  display: flex;
  justify-content: flex-end;
}

.submit-btn {
  margin: 40rpx 30rpx;
}
