.page-container {
  min-height: 100vh;
  background-color: var(--bg-color, #f5f5f5);
  padding-bottom: 200rpx;
  box-sizing: border-box;
}
.loading-state,
.error-state,
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 60vh;
  padding: 40rpx;
}
.header-section {
  padding: 40rpx 32rpx;
  background-color: var(--bg-color, #f5f5f5);
}
.header-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-main, #333);
  margin-bottom: 12rpx;
  letter-spacing: -1rpx;
}
.header-subtitle {
  font-size: 28rpx;
  color: var(--text-sub, #999);
}
.form-container {
  padding: 0 32rpx;
}
.form-card {
  background-color: #fff;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 10rpx rgba(0,0,0,0.05));
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}
.card-header.compact {
  align-items: flex-start;
  gap: 24rpx;
}
.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main, #333);
  margin-bottom: 32rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid var(--primary-color, #0052d9);
  line-height: 1;
}
.card-title.compact {
  margin-bottom: 12rpx;
}
.card-tip {
  font-size: 24rpx;
  color: var(--text-sub, #999);
}
.readonly-badge {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f6efe5;
  color: #b26a00;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
}
.input-group {
  margin-bottom: 32rpx;
}
.input-group:last-child {
  margin-bottom: 0;
}
.input-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main, #333);
  margin-bottom: 16rpx;
  margin-left: 8rpx;
}
.filled-input {
  background-color: #f7f8fa !important;
  border-radius: 16rpx !important;
  padding: 24rpx 32rpx !important;
  font-size: 28rpx;
  color: var(--text-main, #333);
  transition: all 0.3s;
}
.placeholder-style {
  color: #bbb;
}
.textarea-input {
  min-height: 160rpx;
  width: auto !important;
}
.picker-trigger {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 48rpx;
}
.text-value {
  color: var(--text-main, #333);
}
.text-placeholder {
  color: #bbb;
}

.picker-inline-mark {
  color: #ccc;
  font-size: 28rpx;
  line-height: 1;
  margin-left: 16rpx;
}
.readonly-block {
  padding: 24rpx;
  background: #f3f3f3;
  color: #999;
  border-radius: 12rpx;
}
.readonly-title {
  margin-bottom: 8rpx;
}
.readonly-meta {
  font-size: 24rpx;
}
.item-warning {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fff7e8;
  color: #b26a00;
  font-size: 24rpx;
}
.item-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.item-row {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f7f8fa;
}
.item-row--readonly {
  background: #faf6ef;
  border: 1rpx solid rgba(178, 106, 0, 0.08);
}
.item-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 20rpx;
}
.item-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}
.item-price,
.item-subtotal {
  font-size: 24rpx;
  color: #666;
}
.item-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.item-readonly-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}
.item-readonly-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #8b5a2b;
  font-size: 24rpx;
  line-height: 1.2;
  border: 1rpx solid rgba(178, 106, 0, 0.12);
}
.item-quantity {
  min-width: 48rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}
.item-empty {
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #999;
}
.draft-summary {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.draft-summary-label {
  font-size: 26rpx;
  color: #666;
}
.draft-summary-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--primary-color, #0052d9);
}
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.footer-actions {
  display: flex;
  gap: 20rpx;
  flex: 1;
  justify-content: flex-end;
}
.action-btn {
  min-width: 180rpx;
  font-weight: 600;
}
.action-btn.submit {
  box-shadow: 0 8rpx 20rpx rgba(var(--primary-color-rgb, 0, 82, 217), 0.3);
}
