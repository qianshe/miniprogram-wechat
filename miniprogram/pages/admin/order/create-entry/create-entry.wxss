.entry-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding: 32rpx;
  padding-bottom: 80rpx;
  box-sizing: border-box;
}

.entry-header {
  margin-bottom: 24rpx;
}

.entry-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 10rpx;
}

.entry-subtitle {
  font-size: 26rpx;
  color: #8c8c8c;
}

.entry-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333333;
}

.card-hint {
  font-size: 24rpx;
  color: #8c8c8c;
}

.card-loading,
.card-empty {
  padding: 20rpx 0;
  font-size: 24rpx;
  color: #8c8c8c;
  text-align: center;
}

.package-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.package-item {
  background-color: #f7f8fa;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 2rpx solid transparent;
  position: relative;
}

.package-item:active {
  background-color: #ffffff;
  border-color: var(--primary-color);
}

.package-main {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.package-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.package-price {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.package-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8c8c8c;
}

.package-tag {
  margin-top: 14rpx;
  display: inline-flex;
  align-self: flex-start;
  font-size: 22rpx;
  color: var(--primary-color);
  background: #ffffff;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--primary-color);
}

.free-item {
  border-style: dashed;
  border-color: #d9dde3;
}

.free-price {
  color: #8c8c8c;
}

.free-tag {
  color: #8c8c8c;
  border-color: #cfd4dc;
}
