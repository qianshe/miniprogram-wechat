<view class="admin-orders-container">
  <view class="page-header">
    <view class="page-title">服务记录管理</view>
    <view class="action-buttons">
      <t-button theme="primary" bindtap="navigateToCreate">新建服务记录</t-button>
    </view>
  </view>

  <!-- 搜索框 -->
  <view class="search-container">
    <view class="search-box">
      <input
        class="search-input"
        type="text"
        placeholder="搜索记录编号或联系人"
        value="{{searchKeyword}}"
        confirm-type="search"
        bindinput="onSearchChange"
        bindconfirm="onSearchConfirm"
      />
      <view class="search-icon" wx:if="{{searchKeyword}}" bindtap="onSearchClear">
        <text class="search-icon-text">×</text>
      </view>
    </view>
    <view class="filter-btn" bindtap="toggleFilterPanel">
      <text class="filter-btn-icon">筛</text>
      <text>筛选</text>
    </view>
  </view>

  <!-- 筛选面板 -->
  <view class="filter-mask" wx:if="{{showFilterPanel}}" catchtap="toggleFilterPanel"></view>
  <view class="filter-drawer" wx:if="{{showFilterPanel}}" catchtouchmove="true">
    <view class="filter-panel">
      <view class="filter-header">
        <text>筛选条件</text>
        <text class="filter-close-icon" bindtap="toggleFilterPanel">×</text>
      </view>
      <view class="filter-content">
        <view class="filter-item">
          <text class="filter-label">记录时间</text>
          <view class="date-range">
            <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
              <view class="date-picker">{{startDate || '开始日期'}}</view>
            </picker>
            <text class="date-separator">至</text>
            <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange">
              <view class="date-picker">{{endDate || '结束日期'}}</view>
            </picker>
          </view>
        </view>
        <view class="filter-item">
          <text class="filter-label">价格区间</text>
          <view class="price-range">
            <input
              class="filter-input"
              type="number"
              placeholder="最低价"
              value="{{minPrice}}"
              bindinput="onMinPriceChange"
            />
            <text class="price-separator">至</text>
            <input
              class="filter-input"
              type="number"
              placeholder="最高价"
              value="{{maxPrice}}"
              bindinput="onMaxPriceChange"
            />
          </view>
        </view>
      </view>
      <view class="filter-footer">
        <t-button theme="default" bindtap="resetFilter">重置</t-button>
        <t-button theme="primary" bindtap="applyFilter">确定</t-button>
      </view>
    </view>
  </view>

  <!-- 订单状态标签页（与统计页面保持一致） -->
  <view class="tabs">
    <view
      class="tab-item {{activeTab === '0' ? 'active' : ''}}"
      data-value="0"
      bindtap="onTabClick">全部</view>
    <view
      class="tab-item {{activeTab === '1' ? 'active' : ''}}"
      data-value="1"
      bindtap="onTabClick">待确认</view>
    <view
      class="tab-item {{activeTab === '2' ? 'active' : ''}}"
      data-value="2"
      bindtap="onTabClick">待服务</view>
    <view
      class="tab-item {{activeTab === '3' ? 'active' : ''}}"
      data-value="3"
      bindtap="onTabClick">服务中</view>
    <view
      class="tab-item {{activeTab === '4' ? 'active' : ''}}"
      data-value="4"
      bindtap="onTabClick">待尾款</view>
    <view
      class="tab-item {{activeTab === '5' ? 'active' : ''}}"
      data-value="5"
      bindtap="onTabClick">已完成</view>
    <view
      class="tab-item {{activeTab === '6' ? 'active' : ''}}"
      data-value="6"
      bindtap="onTabClick">已取消</view>
  </view>

  <view class="order-list">
    <view class="loading-wrapper" wx:if="{{loading}}">
      <view class="loading-text">加载中...</view>
    </view>
    <c-empty wx:elif="{{!orders.length}}" show="{{true}}" title="暂无服务记录"></c-empty>
    <view class="orders" wx:else>
      <view class="order-item" wx:for="{{orders}}" wx:key="orderNo">
        <view class="order-header">
          <text class="order-no">记录编号：{{item.orderNo}}</text>
          <!-- 双状态标签显示 -->
          <view class="order-status-tags">
            <view class="status-tag flow-status-{{item.orderStatus !== undefined ? item.orderStatus : item.status}}">{{item.orderStatusText}}</view>
          </view>
        </view>
        <view class="order-info" bindtap="onOrderClick" data-orderno="{{item.orderNo}}">
          <view class="info-row">
            <text class="label">联系人：</text>
            <text>{{item.contactName}}</text>
          </view>
          <view class="info-row">
            <text class="label">服务时间：</text>
            <view class="service-time-block">
              <text class="service-time-text">{{item.serviceTime}}</text>
              <text wx:if="{{item.showServiceUrgencyHint}}" class="service-urgency service-urgency--{{item.serviceUrgencyLevel || 'normal'}}">{{item.serviceUrgencyHint}}</text>
            </view>
          </view>
          <view class="info-row">
            <text class="label">服务金额：</text>
            <text class="amount">¥{{item.totalAmount}}</text>
          </view>
        </view>
        <view class="order-actions">
          <block wx:if="{{item.showActionStartService}}">
            <t-button
              size="small"
              theme="primary"
              class="btn-primary"
              data-orderno="{{item.orderNo}}"
              data-orderid="{{item._id}}"
              bindtap="startService">开始服务</t-button>
          </block>
          <block wx:elif="{{item.showActionProcessing}}">
            <t-button
              size="small"
              theme="primary"
              class="btn-primary"
              data-orderno="{{item.orderNo}}"
              data-orderid="{{item._id}}"
              data-orderflowstatus="{{item.actionOrderFlowStatus}}"
              bindtap="updateOrderFlow">服务完成</t-button>
          </block>
          <block wx:elif="{{item.showActionServiceDoneUnpaid}}">
            <t-button
              size="small"
              theme="success"
              class="btn-success"
              data-orderno="{{item.orderNo}}"
              bindtap="recordOfflinePayment">确认线下收款</t-button>
          </block>
          <block wx:elif="{{item.showActionServiceDonePaid}}">
            <t-button
              size="small"
              theme="primary"
              class="btn-primary"
              data-orderno="{{item.orderNo}}"
              data-orderid="{{item._id}}"
              data-orderflowstatus="{{item.actionOrderFlowStatus}}"
              bindtap="updateOrderFlow">完成服务记录</t-button>
          </block>
          <block wx:if="{{item.showCancelButton}}">
            <t-button
              size="small"
              theme="danger"
              class="btn-danger"
              data-orderno="{{item.orderNo}}"
              data-orderid="{{item._id}}"
              data-orderflowstatus="{{item.actionOrderFlowStatus}}"
              bindtap="updateOrderFlow">关闭服务记录</t-button>
          </block>
        </view>
      </view>
    </view>
  </view>
</view>
