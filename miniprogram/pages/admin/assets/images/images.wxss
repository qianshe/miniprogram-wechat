.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 32rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
}

/* 下拉选择器样式 */
.picker-section {
  margin-bottom: 24rpx;
}

.picker-cell {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff;
  padding: 24rpx 32rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.picker-label {
  font-size: 28rpx;
  color: #666;
}

.picker-value {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.picker-arrow {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #999;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

.card-body {
  margin-bottom: 24rpx;
}

.preview-area {
  min-height: 400rpx;
  background-color: #fafafa;
  border-radius: 12rpx;
  border: 2rpx dashed #e0e0e0;
  overflow: hidden;
  text-align: center;
  padding: 20rpx;
}

.preview-image {
  width: 100%;
  height: 360rpx;
}

.empty-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ccc;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 26rpx;
}

.info-area {
  margin-top: 16rpx;
  text-align: center;
}

.update-time {
  font-size: 24rpx;
  color: #999;
}

.card-footer {
  margin-top: 16rpx;
}
