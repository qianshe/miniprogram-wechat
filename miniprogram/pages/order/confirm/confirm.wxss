.container {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.address-section {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 24rpx;
  position: relative;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 白事系统地址样式 */
.white-theme .address-section {
  border-left: 8rpx solid var(--primary-color);
}

/* 红事系统地址样式 */
.red-theme .address-section {
  border-left: 8rpx solid var(--danger-color);
}

.address-info {
  flex: 1;
  padding-right: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.user-info text {
  margin-right: 24rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
}

.address-detail {
  color: var(--text-sub);
  font-size: 26rpx;
  line-height: 1.4;
}

.no-address {
  color: var(--text-sub);
  font-size: 28rpx;
}

.arrow {
  color: #ccc;
  font-size: 32rpx;
}

.goods-list {
  background: #fff;
  padding: 24rpx;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f1ede8;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.section-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.section-count {
  font-size: 24rpx;
  color: var(--text-sub);
}

.items-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.item-row {
  display: flex;
  align-items: center;
  padding: 16rpx;
  border-radius: var(--package-item-radius);
  background: var(--package-accent-light);
  transition: all 0.2s ease;
}

.item-image-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 16rpx;
  flex-shrink: 0;
  position: relative;
}

.item-image {
  width: 100%;
  height: 100%;
  background: #f3efe8;
}

.item-info {
  flex: 1;
  min-width: 0;
}

.item-name {
  display: block;
  font-size: 26rpx;
  color: var(--text-main);
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.item-category {
  display: block;
  font-size: 22rpx;
  color: var(--primary-color);
  margin-bottom: 4rpx;
}

.item-unit-price {
  display: block;
  font-size: 20rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}

.item-qty-price {
  text-align: right;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.item-qty {
  display: block;
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 4rpx;
}

.item-price {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}

.remarks-section {
  background: #fff;
  padding: 32rpx;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
}

.confirm-card {
  background: #fff;
  padding: 28rpx 32rpx;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
}

.compact-card {
  padding-bottom: 32rpx;
}

.remarks-card {
  padding-bottom: 32rpx;
}

.confirm-card-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 16rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #f1ede8;
}

.confirm-card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.confirm-card-hint {
  font-size: 22rpx;
  color: var(--text-sub);
}

.confirm-field {
  min-height: 72rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  color: var(--text-sub);
  font-size: 26rpx;
  box-sizing: border-box;
}

.confirm-field.has-value {
  color: var(--text-main);
}

.plain-field {
  padding: 0 8rpx;
  min-height: 72rpx;
  background: transparent;
  border-radius: 0;
  font-size: 28rpx;
}

.remarks-input {
  width: 100%;
  min-height: 72rpx;
  padding: 0 8rpx;
  font-size: 28rpx;
  color: var(--text-main);
  box-sizing: border-box;
}

.remarks-label {
  font-size: 28rpx;
  color: var(--text-main);
  margin-right: 20rpx;
  font-weight: 500;
}

.remarks-section input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  color: var(--text-main);
}

.price-section {
  background: #fff;
  padding: 24rpx;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
}

.price-breakdown {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.price-row:not(:last-child) {
  border-bottom: 1rpx solid #f1ede8;
}

.price-row.total {
  padding-top: 16rpx;
  margin-top: 8rpx;
}

.price-label {
  font-size: 26rpx;
  color: var(--text-sub);
}

.price-row.total .price-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.price-value {
  font-size: 26rpx;
  color: var(--text-main);
}

.price-value-wrap {
  display: flex;
  align-items: baseline;
}

.price-value-wrap .currency {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 600;
  margin-right: 4rpx;
}

.price-value.total-price {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.disclaimer-text {
  margin: 0 0 20rpx;
  padding: 0 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #999;
  text-align: center;
}

.bottom-placeholder {
  height: 180rpx;
}

.footer {
  position: fixed;
  /* 非tabbar页面：footer直接贴底部，只需考虑safe-area */
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.total-amount {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
}

.amount {
  font-weight: bold;
  font-size: 36rpx;
  color: var(--danger-color);
  margin-left: 10rpx;
}

.submit-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  color: #fff;
  border-radius: 40rpx;
  margin: 0;
  font-size: 30rpx;
  font-weight: 600;
  background: linear-gradient(135deg, var(--package-accent, #c9a86c) 0%, var(--primary-color, #b8865c) 100%);
  box-shadow: 0 8rpx 24rpx rgba(184, 134, 92, 0.3);
  transition: all 0.3s;
}

.submit-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
  background: linear-gradient(135deg, var(--package-accent, #c9a86c) 0%, var(--primary-color, #b8865c) 100%);
}

/* 白事系统提交按钮 */
.white-theme .submit-btn {
  background: linear-gradient(135deg, var(--package-accent, #c9a86c) 0%, var(--primary-color, #b8865c) 100%);
  box-shadow: 0 8rpx 24rpx rgba(184, 134, 92, 0.3);
}

/* 红事系统提交按钮 */
.red-theme .submit-btn {
  background: var(--wechat-green);
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
}

.submit-btn[disabled] {
  background: #ccc;
  box-shadow: none;
}

/* 按钮 loading 状态样式 */
.submit-btn[loading] {
  background: linear-gradient(135deg, var(--package-accent, #c9a86c) 0%, var(--primary-color, #b8865c) 100%);
  opacity: 0.8;
}

/* loading 且 disabled 同时存在时的样式 */
.submit-btn[loading][disabled] {
  background: var(--wechat-green);
  opacity: 0.8;
}

/* 覆盖微信按钮默认边框样式 */
.submit-btn::after {
  border: none;
}

/* 地址选择弹窗样式 */
.address-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
}

.address-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 10000;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  background: #ffffff;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.modal-close {
  font-size: 32rpx;
  color: #999999;
  padding: 10rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 0 32rpx;
  max-height: 50vh;
  min-height: 200rpx;
  background: #ffffff;
}

/* 已保存地址列表 */
.saved-address-list {
  padding: 16rpx 0;
}

.saved-address-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.saved-address-item.selected {
  background: #f0f9f0;
  border-color: #07c160;
}

.saved-address-item:active {
  opacity: 0.8;
}

.address-item-info {
  flex: 1;
}

.address-item-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.address-item-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-right: 16rpx;
}

.address-item-phone {
  font-size: 26rpx;
  color: #999999;
  margin-right: 16rpx;
}

.address-item-tag {
  font-size: 20rpx;
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.address-item-detail {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.4;
}

.address-item-check {
  font-size: 32rpx;
  color: #07c160;
  font-weight: bold;
  margin-left: 16rpx;
}

/* 无地址提示 */
.no-saved-address {
  text-align: center;
  padding: 60rpx 0;
  color: #999999;
  font-size: 28rpx;
}

/* 弹窗底部按钮 */
.modal-footer {
  display: flex;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f5f5f5;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  margin: 0 12rpx;
}

.wechat-btn {
  background: #07c160;
  color: #ffffff;
}

.manage-btn {
  background: #f5f5f5;
  color: #333333;
}

.modal-btn:active {
  opacity: 0.8;
}

/* 默认标签样式 */
.default-tag {
  font-size: 20rpx;
  color: #07c160;
  background: rgba(7, 193, 96, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  margin-left: 12rpx;
}
