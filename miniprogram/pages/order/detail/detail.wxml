<view class="order-detail {{systemType}}-theme">
  <view class="loading" wx:if="{{loading}}">加载中...</view>
  <block wx:elif="{{orderInfo}}">
    <!-- 状态栏 -->
    <view class="status-bar {{systemType}}-status-{{orderInfo.orderStatus}}">
      <text class="status">{{orderInfo.displayStatusText}}</text>
      <view class="status-desc">{{orderInfo.flowStatusDesc || orderInfo.statusDesc}}</view>
    </view>
    <view class="timeline">
      <view class="timeline-item {{orderInfo.isWorkflowUnclaimed || orderInfo.isWorkflowClaimedUnconfirmed ? 'current' : 'active'}}">
        <view class="timeline-dot"></view>
        <text class="timeline-text">记录创建</text>
        <text class="timeline-time">{{orderInfo.timelineCreatedTime || ''}}</text>
      </view>
      <view class="timeline-line {{orderInfo.isWorkflowConfirmedReady || orderInfo.isWorkflowProcessing || orderInfo.isWorkflowServiceDone || orderInfo.isWorkflowCompleted ? 'active' : ''}}"></view>
      <view class="timeline-item {{orderInfo.isWorkflowConfirmedReady ? 'current' : (orderInfo.isWorkflowProcessing || orderInfo.isWorkflowServiceDone || orderInfo.isWorkflowCompleted ? 'active' : '')}}">
        <view class="timeline-dot"></view>
        <text class="timeline-text">服务确认</text>
        <text class="timeline-time">{{orderInfo.timelineConfirmTime || ''}}</text>
      </view>
      <view class="timeline-line {{orderInfo.isWorkflowProcessing || orderInfo.isWorkflowServiceDone || orderInfo.isWorkflowCompleted ? 'active' : ''}}"></view>
      <view class="timeline-item {{orderInfo.isWorkflowProcessing ? 'current' : (orderInfo.isWorkflowServiceDone || orderInfo.isWorkflowCompleted ? 'active' : '')}}">
        <view class="timeline-dot"></view>
        <text class="timeline-text">{{orderInfo.isWorkflowServiceDone || orderInfo.isWorkflowCompleted ? '服务完成' : '服务中'}}</text>
        <text class="timeline-time">{{orderInfo.timelineProcessTime || ''}}</text>
      </view>
      <view class="timeline-line {{orderInfo.isWorkflowCompleted ? 'active' : ''}}"></view>
      <view class="timeline-item {{orderInfo.isWorkflowCompleted ? 'active' : ''}}">
        <view class="timeline-dot"></view>
        <text class="timeline-text">完成</text>
        <text class="timeline-time">{{orderInfo.isWorkflowCompleted ? (orderInfo.timelineCompleteTime || '-') : ''}}</text>
      </view>
    </view>
    <view class="section">
      <view class="section-title">基本信息</view>
      <view class="info-item info-item--center">
        <text class="label">记录编号</text>
        <view class="value-with-action value-with-action--center-btn">
          <text class="value">{{orderInfo.orderNo}}</text>
          <t-button size="small" theme="default" bindtap="copyOrderNo">复制</t-button>
        </view>
      </view>
      <view class="info-item">
        <text class="label">记录时间</text>
        <text class="value">{{orderInfo.createdTime}}</text>
      </view>
      <view class="info-item">
        <text class="label">服务时间</text>
        <text class="value">{{orderInfo.serviceTime}}</text>
      </view>
    </view>
    <view class="section">
      <view class="section-title">联系信息</view>
      <view class="info-item">
        <text class="label">联系人</text>
        <text class="value">{{orderInfo.contactName}}</text>
      </view>
      <view class="info-item info-item--center">
        <text class="label">联系电话</text>
        <view class="value-with-action value-with-action--center-btn">
          <text class="value">{{orderInfo.contactPhone}}</text>
          <t-button
            wx:if="{{isAdmin && orderInfo.contactPhone}}"
            size="small"
            theme="default"
            bindtap="handleCallContact"
          >拨打</t-button>
        </view>
      </view>
      <view class="info-item info-item--address">
        <text class="label">服务地址</text>
        <view class="value-with-action value-with-action--address">
          <text class="value address">{{orderInfo.addressText}}</text>
          <t-button
            wx:if="{{isAdmin && hasValidCoordinates}}"
            size="small"
            theme="primary"
            bindtap="handleAdminNavigate"
          >导航</t-button>
        </view>
      </view>
    </view>
    <view class="section">
      <view class="section-title">服务内容</view>
      <view class="goods-list" wx:if="{{orderInfo.originalItems.length > 0}}">
        <view class="goods-item" wx:for="{{orderInfo.originalItems}}" wx:key="productId">
          <block wx:if="{{item.productImage}}">
            <image class="goods-image" src="{{item.productImage}}" mode="aspectFill"></image>
          </block>
          <view wx:else class="goods-image placeholder">暂无图片</view>
          <view class="goods-info">
            <text class="goods-name">{{item.productName}}</text>
            <view class="goods-price-row">
              <text class="goods-price">¥{{item.productPrice}}</text>
              <text class="goods-quantity">×{{item.quantity}}</text>
            </view>
          </view>
          <text class="subtotal">¥{{item.subtotal}}</text>
        </view>
      </view>
      <view class="goods-section-subtotal" wx:if="{{orderInfo.appendedItems.length > 0 && orderInfo.originalItems.length > 0}}">
        <text class="subtotal-label">原始内容小计</text>
        <text class="subtotal-value">¥{{orderInfo.originalSubtotal}}</text>
      </view>
      <view class="appended-section" wx:if="{{orderInfo.appendedItems.length > 0}}">
        <view class="appended-header">
          <text class="appended-title">追加内容</text>
          <text class="appended-badge">+{{orderInfo.appendedItems.length}}项</text>
        </view>
        <view class="goods-list appended-goods-list">
          <view class="goods-item appended-item" wx:for="{{orderInfo.appendedItems}}" wx:key="productId">
            <block wx:if="{{item.productImage}}">
              <image class="goods-image" src="{{item.productImage}}" mode="aspectFill"></image>
            </block>
            <view wx:else class="goods-image placeholder">暂无图片</view>
            <view class="goods-info">
              <view class="goods-name-row">
                <text class="goods-name">{{item.productName}}</text>
              </view>
              <view class="goods-price-row">
                <text class="goods-price">¥{{item.productPrice}}</text>
                <text class="goods-quantity">×{{item.quantity}}</text>
              </view>
              <text class="appended-time">追加于 {{item.appendedTime}}</text>
            </view>
            <text class="subtotal">¥{{item.subtotal}}</text>
          </view>
        </view>
        <view class="goods-section-subtotal">
          <text class="subtotal-label">追加内容小计</text>
          <text class="subtotal-value">¥{{orderInfo.appendedSubtotal}}</text>
        </view>
      </view>
      <view class="amount-summary" wx:if="{{orderInfo.totalAmount !== undefined && orderInfo.totalAmount !== null}}">
        <view class="amount-summary__label">线下应收总额</view>
        <view class="amount-summary__value">¥{{orderInfo.totalAmount}}</view>
      </view>
    </view>
    <view class="section" wx:if="{{orderInfo.remark}}">
      <view class="section-title">备注</view>
      <view class="remark">{{orderInfo.remark}}</view>
    </view>
    <view wx:if="{{!isAdmin && !orderInfo.isWorkflowCompleted && !orderInfo.isWorkflowCancelled}}" class="section section-compact status-tip-section">
      <view class="user-status-tip user-status-tip-inline">
        <text wx:if="{{orderInfo.isWorkflowClaimedUnconfirmed}}">服务记录已认领，请补充并确认服务信息。</text>
        <text wx:if="{{orderInfo.isWorkflowConfirmedReady}}">服务信息已确认，请等待工作人员安排服务。</text>
        <text wx:if="{{orderInfo.isWorkflowProcessing}}">服务进行中，请耐心等待工作人员与您沟通。</text>
        <text wx:if="{{orderInfo.isWorkflowServiceDone}}">服务已完成，待线下付款，到账后订单完成。</text>
      </view>
    </view>
    <view class="actions">
      <block wx:if="{{isAdmin}}">
        <t-button wx:if="{{showStartProcessingBtn}}" theme="primary" class="btn-primary" bindtap="handleStartProcessing">开始处理</t-button>
        <t-button wx:if="{{showMarkServiceDoneBtn}}" theme="primary" class="btn-primary" bindtap="handleMarkServiceDone">标记服务完成</t-button>
        <t-button wx:if="{{showConfirmPaymentBtn}}" theme="success" class="btn-success" bindtap="handleConfirmPaymentNew">确认收款</t-button>
        <t-button wx:if="{{showAdminQrEntry}}" theme="default" class="btn-secondary" bindtap="openAdminQrCode">查看认领二维码</t-button>
        <t-button wx:if="{{showEditOrderBtn}}" theme="default" class="btn-secondary" bindtap="handleEditOrder">编辑服务记录</t-button>
        <t-button wx:if="{{showCancelBtn}}" theme="danger" class="btn-danger" bindtap="handleCancelOrderNew">关闭服务记录</t-button>
        <view wx:if="{{showNoActionTip}}" class="no-action-tip">服务已结束，无可用操作</view>
      </block>
      <block wx:else>
        <t-button wx:if="{{showUserConfirmBtn}}" theme="primary" class="btn-primary" bindtap="handleUserConfirmInfo">确认服务</t-button>
      </block>
    </view>
  </block>
  <c-empty wx:else show="{{true}}" title="服务记录不存在" showButton="{{true}}" buttonText="返回列表" bind:action="goBack" />
</view>
