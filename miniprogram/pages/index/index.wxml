<view class="container">
  <view class="hero">
    <image class="bg-image" src="{{homeImage}}" mode="aspectFill" />
    <view class="hero-text">
      <view class="title">专业服务，肃穆送别</view>
      <view class="subtitle">我们在此，为您分担离别的繁杂，让爱与尊重延续。</view>
    </view>
  </view>

  <view class="main-panel">
    <view class="menu-grid">
      <view class="menu-item main-item" bindtap="onTapPackage">
        <view class="item-content">
          <image class="item-icon" src="" mode="aspectFit" wx:if="{{false}}"/> 
          <view class="icon-placeholder main-icon">🕯️</view>
          <view class="text-group">
            <view class="menu-title">服务方案参考</view>
            <view class="menu-desc">了解服务内容</view>
          </view>
        </view>
      </view>
      
      <view class="right-column">
        <view class="menu-item sub-item" bindtap="onTapGuide">
          <view class="item-content horizontal">
            <view class="icon-placeholder sub-icon">📜</view>
            <view class="menu-title">治丧指南</view>
          </view>
        </view>
        <view class="menu-item sub-item" bindtap="onTapService">
          <view class="item-content horizontal">
            <view class="icon-placeholder sub-icon">🎧</view>
            <view class="menu-title">服务咨询项</view>
          </view>
        </view>
      </view>
    </view>

    <view class="service-tags">
      <view class="tag-item">
        <text class="iconfont">✔</text> 服务信息公开
      </view>
      <view class="tag-item">
        <text class="iconfont">🕓</text> 24小时专业响应
      </view>
      <view class="tag-item">
        <text class="iconfont">👥</text> 全程专业顾问
      </view>
    </view>
  </view>
</view>