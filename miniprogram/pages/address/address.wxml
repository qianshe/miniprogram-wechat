<view class="address-container">
  <view class="address-list" wx:if="{{addressList.length > 0}}">
    <view class="address-item" wx:for="{{addressList}}" wx:key="id">
      <view class="address-content" bindtap="editAddress" data-index="{{index}}">
        <view class="address-header">
          <text class="address-name">{{item.name}}</text>
          <text class="address-phone">{{item.phone}}</text>
          <text class="default-tag" wx:if="{{item.isDefault}}">默认</text>
        </view>
        <view class="address-detail">
          <text class="address-primary">{{item.locationName || item.locationAddress || '未命名位置'}}</text>
          <text class="address-secondary" wx:if="{{item.detail}}">地点特征：{{item.detail}}</text>
          <text class="address-secondary" wx:if="{{item.locationAddress && item.locationAddress !== item.locationName}}">{{item.locationAddress}}</text>
        </view>
      </view>
      <view class="address-actions">
        <view class="action-btn" bindtap="setDefault" data-index="{{index}}" wx:if="{{!item.isDefault}}">
          <text class="action-text">设为默认</text>
        </view>
        <view class="action-btn delete-btn" bindtap="deleteAddress" data-index="{{index}}">
          <text class="action-text">删除</text>
        </view>
      </view>
    </view>
  </view>
  <view class="empty-state" wx:if="{{addressList.length === 0}}">
    <view class="empty-icon">
      <text class="empty-icon-text">址</text>
    </view>
    <text class="empty-text">暂无收货地址</text>
    <text class="empty-tip">点击下方按钮添加新地址</text>
  </view>
  <view class="add-btn-wrapper">
    <button class="add-btn" bindtap="showAddModal">新增收货地址</button>
  </view>
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="hideModal"></view>
  <view class="modal-content" wx:if="{{showModal}}">
    <view class="modal-header">
      <text class="modal-title">{{editIndex >= 0 ? '编辑地址' : '新增地址'}}</text>
      <view class="modal-close" bindtap="hideModal">X</view>
    </view>
    <view class="modal-body">
      <view class="form-item">
        <text class="form-label">收货人</text>
        <input class="form-input" placeholder="请输入收货人姓名" value="{{formData.name}}" bindinput="onInputName" />
      </view>
      <view class="form-item">
        <text class="form-label">手机号</text>
        <input class="form-input" type="number" maxlength="11" placeholder="请输入手机号码" value="{{formData.phone}}" bindinput="onInputPhone" />
      </view>
      <view class="form-item">
        <view class="form-label-row">
          <text class="form-label">地图选点</text>
          <text class="required-badge">必选</text>
        </view>
        <view class="map-picker-block">
          <button class="map-picker-btn" bindtap="chooseLocation">{{formData.latitude && formData.longitude ? '重新地图选点' : '去地图选点'}}</button>
          <view class="map-picker-status {{formData.latitude && formData.longitude ? '' : 'placeholder'}}">
            <text class="map-picker-title">{{formData.locationName || '尚未选择地图位置'}}</text>
            <text class="map-picker-meta" wx:if="{{formData.locationAddress}}">{{formData.locationAddress}}</text>
            <text class="map-picker-meta" wx:if="{{!formData.latitude || !formData.longitude}}">请先在地图上选择位置，保存后地址才可用于导航</text>
          </view>
        </view>
      </view>
      <view class="form-item">
        <text class="form-label">地点特征</text>
        <textarea class="form-textarea" placeholder="请输入门牌号、楼栋、地标等地点特征" value="{{formData.detail}}" bindinput="onInputDetail" />
      </view>
      <view class="form-item switch-item">
        <text class="form-label">设为默认地址</text>
        <switch checked="{{formData.isDefault}}" bindchange="onSwitchDefault" color="#d9b78c" />
      </view>
    </view>
    <view class="modal-footer">
      <button class="cancel-btn" bindtap="hideModal">取消</button>
      <button class="confirm-btn" bindtap="saveAddress">保存</button>
    </view>
  </view>
</view>