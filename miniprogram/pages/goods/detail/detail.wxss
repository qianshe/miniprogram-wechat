.goods-detail {
  background: var(--bg-color);
  min-height: 100vh;
  padding-bottom: 200rpx;
  box-sizing: border-box;
}

.goods-swiper {
  width: 100%;
  height: 680rpx;
  background: #fff;
}

.goods-swiper image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.goods-info {
  background: var(--card-bg);
  padding: 32rpx;
  margin: 16rpx 16rpx 20rpx;
  border-radius: 24rpx;
  box-shadow: var(--shadow-sm);
  position: relative;
  z-index: 2;
}

.goods-price {
  color: var(--primary-color);
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.goods-stock {
  color: var(--text-sub);
  font-size: 24rpx;
}

.goods-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.section {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 20rpx;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
}

.goods-description,
.goods-detail-info {
  margin: 0 16rpx 16rpx;
  background: var(--card-bg);
  border-radius: 24rpx;
  box-shadow: var(--shadow-sm);
  padding: 28rpx 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 20rpx;
  padding-left: 14rpx;
  border-left: 6rpx solid var(--primary-color);
  line-height: 1;
}

.info-item {
  display: flex;
  padding: 16rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid #f1ece4;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item .label {
  color: var(--text-sub);
  width: 160rpx;
}

.info-item .value {
  color: var(--text-main);
  flex: 1;
}

.description-content {
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.8;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: var(--card-bg);
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 -6rpx 18rpx rgba(0,0,0,0.08);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
  border-top: 1rpx solid #efe7dc;
}

.add-cart-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(184, 134, 92, 0.3);
  transition: all 0.25s;
  background: linear-gradient(135deg, var(--package-accent, #c9a86c) 0%, var(--primary-color, #b8865c) 100%);
}

.add-cart-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(184, 134, 92, 0.22);
}

.sku-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 999;
}

.sku-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  padding: 0 0 env(safe-area-inset-bottom);
}

.sku-popup {
  background: #fff;
  padding: 30rpx 30rpx 24rpx;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
  max-height: 72vh;
  overflow: auto;
}

.sku-header {
  display: flex;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f1ece4;
  gap: 20rpx;
}

.sku-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  background: #f3efe8;
}

.sku-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 12rpx;
}

.sku-price {
  color: var(--primary-color);
  font-size: 40rpx;
  font-weight: bold;
}

.sku-stock {
  font-size: 24rpx;
  color: var(--text-sub);
}

.sku-content {
  padding: 26rpx 0;
  max-height: 600rpx;
  overflow-y: auto;
}

.quantity-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f1ece4;
}

.quantity-label {
  font-size: 28rpx;
  color: var(--text-main);
}

.quantity-stepper {
  display: flex;
  align-items: center;
  background: #f7f3ed;
  border-radius: 44rpx;
  padding: 6rpx;
  gap: 12rpx;
  border: 1rpx solid #e6d8c7;
}

.step-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #fff;
  color: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(184, 134, 92, 0.2);
}

.step-value {
  min-width: 60rpx;
  text-align: center;
  font-size: 30rpx;
  color: var(--text-main);
  font-weight: 600;
}

.sku-footer {
  margin-top: 12rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, var(--package-accent, #c9a86c) 0%, var(--primary-color, #b8865c) 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(184, 134, 92, 0.3);
}

.red-theme .confirm-btn,
.red-theme .add-cart-btn {
  background: var(--danger-color);
  box-shadow: 0 10rpx 22rpx rgba(210, 75, 65, 0.28);
}

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: var(--text-sub);
}
