<!--
  Package Confirm Page
  Order confirmation before submission
-->
<view class="package-confirm-page">
  <!-- Loading State -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- Main Content -->
  <block wx:else>
    <c-confirm-address-sheet
      address="{{address}}"
      address-list="{{addressList}}"
      visible="{{showAddressModal}}"
      selected-address-id="{{selectedAddressId}}"
      bindopen="selectAddress"
      bindclose="hideAddressModal"
      bindselect="onConfirmAddressSelect"
      bindwechat="useWechatAddress"
      bindmanage="goToAddressManage"
    ></c-confirm-address-sheet>

    <!-- Package Info Card -->
    <view class="section package-section">
      <view class="section-header">
        <text class="section-title">套餐信息</text>
      </view>
      <view class="package-card">
        <view class="package-image-wrap">
          <image 
            class="package-image" 
            src="{{packageInfo.imageUrl || '/images/package-default.png'}}"
            mode="aspectFill"
          />
        </view>
        <view class="package-info">
          <text class="package-name">{{packageInfo.name}}</text>
          <text class="package-desc">{{packageInfo.description}}</text>
          <view class="package-type-badge {{packageInfo.type}}">
            <text class="badge-text">{{packageInfo.type === 'white' ? '白事套餐' : '服务套餐'}}</text>
          </view>
        </view>
      </view>
    </view>

    <c-confirm-item-list
      custom-class="package-item-list"
      count-text="共{{items.length}}项"
      items="{{confirmItemRows}}"
    ></c-confirm-item-list>

    <c-confirm-form-card title="服务时间" compact="{{true}}">
      <picker mode="date" value="{{serviceTime}}" bindchange="onServiceTimeChange">
        <view class="confirm-field plain-field {{serviceTime ? 'has-value' : ''}}">
          <text>{{serviceTime || '请选择服务时间'}}</text>
        </view>
      </picker>
    </c-confirm-form-card>

    <c-confirm-price-summary rows="{{priceSummaryRows}}"></c-confirm-price-summary>

    <c-confirm-form-card title="服务备注" custom-class="remarks-card">
      <input 
        class="remarks-input" 
        type="text"
        placeholder="请输入服务备注"
        value="{{remarks}}"
        bindinput="onRemarksInput"
        maxlength="200"
      />
    </c-confirm-form-card>

    <view class="disclaimer-text">本小程序仅用于展示与需求登记，最终以电话/微信沟通及线下结算为准。</view>

    <view class="bottom-placeholder"></view>

    <view class="bottom-bar">
      <view class="bottom-left">
        <text class="total-label">服务咨询:</text>
        <view class="total-amount">
          <text class="total-value">请联系服务人员确认</text>
        </view>
      </view>
      <view class="bottom-right">
        <view class="back-btn" bindtap="onGoBack">
          <text class="back-text">返回查看</text>
        </view>
        <view class="submit-btn" bindtap="onSubmitOrder">
          <text class="submit-text">联系服务人员</text>
        </view>
      </view>
    </view>
  </block>
</view>