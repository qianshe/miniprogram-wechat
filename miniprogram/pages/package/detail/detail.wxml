<!--pages/package/detail/detail.wxml-->
<view class="package-detail-page">
  <!-- Loading State -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- Content -->
  <block wx:else>
    <!-- Package Header -->
    <view class="package-header">
      <image 
        class="header-image" 
        src="{{packageInfo.imageUrl}}" 
        mode="aspectFill"
      />
      <view class="header-overlay"></view>
      <view class="header-content">
        <text class="package-name">{{packageInfo.name}}</text>
        <text class="package-desc">{{packageInfo.description}}</text>
      </view>
    </view>

    <!-- Items Section -->
    <view class="items-section">
      <view class="section-header">
        <text class="section-title">套餐内容</text>
      </view>

      <view class="items-list">
        <view
          class="item-card {{category.isCustomized ? 'customized' : ''}}"
          wx:for="{{items}}"
          wx:for-index="categoryIndex"
          wx:for-item="category"
          wx:key="categoryId"
        >
          <view class="item-header">
            <text class="category-name">{{category.categoryName}}</text>
            <view class="category-subtotal">
              <text class="subtotal-text">小计: </text>
              <text class="subtotal-value">{{category.displayCategorySubtotal}}</text>
            </view>
          </view>

          <view class="products-container">
            <view
              class="product-swipe-wrapper"
              wx:for="{{category.products}}"
              wx:for-index="productIndex"
              wx:for-item="product"
              wx:key="productId"
            >
              <view class="product-item">
                <view class="product-info">
                  <image
                    class="product-image"
                    src="{{product.imageUrl}}"
                    mode="aspectFill"
                  />
                  <view class="product-details compact">
                    <view class="product-name-row">
                      <text class="product-name">{{product.productName}}</text>
                    </view>
                    <view class="product-meta-row">
                      <view class="product-price-stack inline">
                        <text class="product-price">{{product.displayPrice}}/件</text>
                        <text class="product-subtotal">小计 ¥{{product.displaySubtotal}}</text>
                      </view>
                      <view class="product-meta-actions">
                        <text class="qty-value">数量 {{product.quantity}}</text>
                      </view>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Price Summary -->
    <view class="price-summary">
      <view class="summary-row">
        <text class="summary-label">套餐原价</text>
        <text class="summary-value original">{{displayOriginalPrice}}</text>
      </view>
      <view class="summary-row total">
        <text class="summary-label">参考合计</text>
        <text class="summary-value total-price">{{displayTotalPrice}}</text>
      </view>
    </view>

    <!-- Contact Button -->
    <view class="contact-btn-section">
      <text class="contact-hint-text">当前页面仅供查看套餐信息，具体服务内容请联系服务人员确认</text>
      <view class="contact-btn" bindtap="onConfirm">
        <text class="contact-btn-text">联系服务人员</text>
      </view>
    </view>

    <!-- Bottom Safe Area Placeholder -->
    <view class="bottom-placeholder"></view>
  </block>

<!-- Product Replacer Popup removed from ordinary user flow -->
</view>