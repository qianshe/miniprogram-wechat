.address-trigger {
  position: relative;
  margin: 24rpx;
  padding: 24rpx;
  background: var(--card-bg, #fcfbf8);
  border-radius: var(--package-card-radius, 24rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid var(--package-border, #efe7dc);
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--package-border, #efe7dc);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main, #2c3e50);
}

.address-info {
  flex: 1;
  padding-right: 48rpx;
}

.address-user {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  gap: 12rpx;
  flex-wrap: wrap;
}

.address-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main, #2c3e50);
}

.address-phone {
  font-size: 28rpx;
  color: var(--text-sub, #6b6b6b);
}

.address-tag,
.address-item-tag {
  font-size: 20rpx;
  color: #fff;
  background: var(--primary-color, #b8865c);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.address-detail,
.address-item-detail {
  font-size: 24rpx;
  color: var(--text-sub, #6b6b6b);
  line-height: 1.4;
}

.no-address {
  padding: 20rpx 0;
  color: var(--text-sub, #6b6b6b);
  font-size: 26rpx;
}

.address-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 28rpx;
  color: var(--text-sub, #6b6b6b);
}

.address-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
}

.address-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card-bg, #fcfbf8);
  border-radius: 32rpx 32rpx 0 0;
  z-index: 1001;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--package-border, #efe7dc);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main, #2c3e50);
}

.modal-close {
  font-size: 40rpx;
  color: var(--text-sub, #6b6b6b);
  padding: 8rpx;
}

.modal-body {
  flex: 1;
  overflow-y: auto;
  padding: 24rpx;
}

.saved-address-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.saved-address-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: var(--package-accent-light, #f5efe3);
  border-radius: var(--package-item-radius, 16rpx);
  border: 2rpx solid transparent;
}

.saved-address-item.selected {
  border-color: var(--primary-color, #b8865c);
  background: rgba(184, 134, 92, 0.1);
}

.address-item-info {
  flex: 1;
}

.address-item-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.address-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main, #2c3e50);
}

.address-item-phone {
  font-size: 26rpx;
  color: var(--text-sub, #6b6b6b);
}

.address-item-check {
  font-size: 32rpx;
  color: var(--primary-color, #b8865c);
  font-weight: 600;
  margin-left: 16rpx;
}

.no-saved-address {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-sub, #6b6b6b);
  font-size: 26rpx;
}

.modal-footer {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--package-border, #efe7dc);
}

.modal-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 40rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
}

.wechat-btn {
  background: #07c160;
  color: #fff;
}

.manage-btn {
  background: var(--package-accent-light, #f5efe3);
  color: var(--primary-color, #b8865c);
}
