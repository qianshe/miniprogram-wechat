.product-selector-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.product-selector-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.product-selector-panel {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 90vw;
  height: 70vh;
  transform: translate(-50%, -50%);
  border-radius: 16rpx;
  overflow: hidden;
}

.popup-content {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--card-bg, #fff);
  border-radius: 16rpx;
  overflow: hidden;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main, #333);
}

.category-product-wrapper {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.category-sidebar {
  width: 180rpx;
  flex-shrink: 0;
  background: var(--bg-color, #f5f5f5);
  height: 100%;
}

.category-item {
  padding: 28rpx 20rpx;
  font-size: 26rpx;
  color: var(--text-sub, #666);
  text-align: center;
  border-left: 4rpx solid transparent;
  background: var(--bg-color, #f5f5f5);
}

.category-item.active {
  background: var(--card-bg, #fff);
  color: var(--primary-color, #07c160);
  font-weight: 500;
  border-left-color: var(--primary-color, #07c160);
}

.product-scroll {
  flex: 1;
  overflow-y: auto;
  background: var(--card-bg, #fff);
}

.product-scroll.no-sidebar {
  width: 100%;
}

.product-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  background: var(--card-bg, #fff);
  transition: background-color 0.2s;
}

.product-option:active {
  background: #f9f9f9;
}

.product-option.selected {
  background: linear-gradient(135deg, #e8f5e9 0%, #f1f8e9 100%);
  border-left: 4rpx solid var(--primary-color, #07c160);
}

.product-option-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  gap: 16rpx;
}

.check-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  flex-shrink: 0;
  transition: all 0.2s;
}

.check-icon.checked {
  background: var(--primary-color, #07c160);
  border-color: var(--primary-color, #07c160);
}

.product-option-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.product-name {
  font-size: 28rpx;
  color: var(--text-main, #333);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  font-size: 28rpx;
  color: var(--danger-color, #e53935);
  font-weight: 500;
}

.selected-badge {
  background: var(--primary-color, #07c160);
  color: #fff;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 48rpx;
}

.selected-quantity {
  font-size: 22rpx;
  line-height: 1;
}

.loading-tips,
.no-more-tips,
.empty-tips {
  text-align: center;
  padding: 40rpx;
  color: var(--text-sub, #999);
  font-size: 26rpx;
}
