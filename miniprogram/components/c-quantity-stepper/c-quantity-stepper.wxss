/* 数量选择器组件样式 */
.c-stepper {
  display: inline-flex;
  align-items: center;
  background: var(--bg-color, #f6f0e7);
  border-radius: 8rpx;
  overflow: hidden;
}

.c-stepper.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.c-stepper-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-main, #2c3e50);
  background: var(--card-bg, #fcfbf8);
  transition: background 0.2s, opacity 0.2s;
}

.c-stepper-btn:active {
  background: var(--bg-color, #f6f0e7);
}

.c-stepper-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.c-stepper-minus {
  border-radius: 8rpx 0 0 8rpx;
  border-right: 1rpx solid var(--package-border, #efe7dc);
}

.c-stepper-plus {
  border-radius: 0 8rpx 8rpx 0;
  border-left: 1rpx solid var(--package-border, #efe7dc);
}

.c-stepper-value {
  min-width: 64rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main, #2c3e50);
  background: var(--card-bg, #fcfbf8);
  font-family: DIN, 'Helvetica Neue', Helvetica, Arial, sans-serif;
}
