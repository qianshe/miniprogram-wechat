/* 空状态组件样式 */
.c-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
}

.c-empty-image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.c-empty-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-main, #2c3e50);
  margin-bottom: 12rpx;
}

.c-empty-desc {
  font-size: 26rpx;
  color: var(--text-sub, #6b6b6b);
  text-align: center;
  line-height: 1.5;
}

.c-empty-button {
  margin-top: 40rpx;
  padding: 20rpx 48rpx;
  background: var(--primary-color, #b8865c);
  color: #fff;
  font-size: 28rpx;
  border-radius: 44rpx;
  font-weight: 500;
}

.c-empty-button:active {
  opacity: 0.85;
}
