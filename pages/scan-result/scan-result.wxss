.scan-result-container {
  padding: 40rpx 30rpx 100rpx;
  min-height: 100vh;
  background-color: #F6F1E8;
  font-family: "Times New Roman", Georgia, serif;
  box-sizing: border-box;
}

.editorial-header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 60rpx;
  position: relative;
  padding-top: 20rpx;
}

.decorative-line {
  width: 60rpx;
  height: 6rpx;
  background-color: #2F3A32;
  margin-bottom: 16rpx;
}

.header-main-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #2F3A32;
  letter-spacing: 2rpx;
}

.header-sub-title {
  font-size: 20rpx;
  color: #6E5B4B;
  letter-spacing: 4rpx;
  margin-top: 8rpx;
}

.paper-card {
  background-color: #ffffff;
  border: 1rpx solid #E7D8C7;
  box-shadow: 10rpx 10rpx 0 #E7D8C7;
  padding: 50rpx 40rpx;
  position: relative;
  margin-bottom: 60rpx;
}

.paper-clip {
  position: absolute;
  top: -20rpx;
  right: 40rpx;
  width: 30rpx;
  height: 60rpx;
  border: 4rpx solid #B38A5A;
  border-radius: 15rpx;
  z-index: 10;
  background-color: transparent;
}

.card-section {
  margin-bottom: 50rpx;
}

.card-section:last-child {
  margin-bottom: 0;
}

.section-heading {
  font-size: 22rpx;
  color: #B38A5A;
  font-weight: bold;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
  text-transform: uppercase;
  border-bottom: 1rpx solid #E7D8C7;
  padding-bottom: 8rpx;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.info-cell {
  width: 48%;
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
}

.info-cell.full-width {
  width: 100%;
}

.info-lbl {
  font-size: 20rpx;
  color: #6E5B4B;
  margin-bottom: 8rpx;
}

.info-val {
  font-size: 28rpx;
  color: #2F3A32;
  font-weight: 500;
}

.goods-list {
  display: flex;
  flex-direction: column;
}

.goods-item {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx dashed #E7D8C7;
}

.goods-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.goods-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 4rpx;
  background-color: #F6F1E8;
  margin-right: 20rpx;
  flex-shrink: 0;
  border: 1rpx solid #E7D8C7;
}

.placeholder-thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6E5B4B;
  font-size: 18rpx;
  letter-spacing: 1rpx;
  text-align: center;
  line-height: 1.4;
  padding: 8rpx;
}

.goods-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.goods-name {
  font-size: 28rpx;
  color: #2F3A32;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.goods-qty {
  font-size: 22rpx;
  color: #B38A5A;
}

.action-dock {
  margin-top: 60rpx;
}

.dock-msg {
  font-size: 24rpx;
  color: #6E5B4B;
  text-align: center;
  margin-bottom: 24rpx;
}

.dock-msg.highlight {
  color: #B38A5A;
  font-weight: bold;
}

.editorial-btn {
  width: 100%;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  border-radius: 0;
  transition: all 0.2s ease;
}

.editorial-btn::after {
  display: none;
}

.editorial-btn.primary {
  background-color: #2F3A32;
  color: #F6F1E8;
  border: 2rpx solid #2F3A32;
}

.editorial-btn.primary:active {
  background-color: #F6F1E8;
  color: #2F3A32;
}

.editorial-btn.outline {
  background-color: transparent;
  color: #2F3A32;
  border: 2rpx solid #2F3A32;
}

.editorial-btn.outline:active {
  background-color: #2F3A32;
  color: #F6F1E8;
}

.editorial-btn.small {
  width: 280rpx;
  height: 70rpx;
  font-size: 24rpx;
  margin: 0 auto;
}

.loading-container,
.error-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}

.loading-icon {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #E7D8C7;
  border-top: 4rpx solid #2F3A32;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

.error-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #E7D8C7;
  margin-bottom: 30rpx;
}

.error-text {
  font-size: 26rpx;
  color: #2F3A32;
  margin-bottom: 40rpx;
  text-align: center;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}