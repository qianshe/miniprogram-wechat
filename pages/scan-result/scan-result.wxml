<view class="scan-result-container">
  <view class="editorial-header">
    <view class="decorative-line"></view>
    <view class="header-main-title">服务记录</view>
    <view class="header-sub-title">SERVICE RECORD</view>
  </view>

  <!-- 加载中 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-icon"></view>
    <view class="loading-text">正在获取信息...</view>
  </view>

  <!-- 服务记录信息 -->
  <block wx:elif="{{orderInfo}}">
    <view class="paper-card">
      <view class="paper-clip"></view>
      
      <view class="card-section info-section">
        <view class="section-heading">基本信息 / BASIC INFO</view>
        <view class="info-grid">
          <view class="info-cell">
            <text class="info-lbl">记录编号</text>
            <text class="info-val">{{orderInfo.orderNo}}</text>
          </view>
          <view class="info-cell">
            <text class="info-lbl">联系人</text>
            <text class="info-val">{{orderInfo.contactName || '—'}}</text>
          </view>
          <view class="info-cell full-width">
            <text class="info-lbl">服务时间</text>
            <text class="info-val">{{orderInfo.serviceTime || '—'}}</text>
          </view>
        </view>
      </view>
      
      <view class="card-section goods-section">
        <view class="section-heading">服务内容 / ITEMS</view>
        <view class="goods-list">
          <view class="goods-item" wx:for="{{orderInfo.items}}" wx:key="index">
            <image wx:if="{{item.thumbUrl}}" class="goods-thumb" src="{{item.thumbUrl}}" mode="aspectFill"></image>
            <view wx:else class="goods-thumb placeholder-thumb">待补充图片</view>
            <view class="goods-content">
              <view class="goods-name">{{item.productName}}</view>
              <view class="goods-qty">QTY: {{item.quantity}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <view class="action-dock">
      <view wx:if="{{!isLoggedIn}}">
        <block wx:if="{{orderInfo.canBind !== false}}">
          <view class="dock-msg">请先登录后认领此服务记录</view>
          <button class="editorial-btn primary" bindtap="login">立即登录 / LOGIN</button>
        </block>
        <block wx:else>
          <view class="dock-msg">{{orderInfo.bindBlockedReason || '当前二维码不可用'}}</view>
        </block>
      </view>
      <view wx:else>
        <block wx:if="{{orderInfo.canBind !== false}}">
          <view class="dock-msg highlight">您已登录，可以认领此服务记录并确认后续信息</view>
          <button class="editorial-btn primary" bindtap="bindOrder">认领服务 / CLAIM</button>
        </block>
        <block wx:else>
          <view class="dock-msg">{{orderInfo.bindBlockedReason || '当前二维码不可用'}}</view>
        </block>
      </view>
    </view>
  </block>

  <!-- 错误信息 -->
  <view class="error-container" wx:elif="{{errorMessage}}">
    <view class="error-circle"></view>
    <view class="error-text">{{errorMessage}}</view>
    <button class="editorial-btn outline small" bindtap="retry">返回重试 / RETRY</button>
  </view>
</view>