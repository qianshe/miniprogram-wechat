/** pages/index/index.wxss */
.container {
  min-height: 100vh;
  background-color: var(--bg-color);
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.hero {
  position: relative;
  height: 520rpx;
  overflow: hidden;
}

.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.hero::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.25) 0%, rgba(0, 0, 0, 0.14) 100%);
  z-index: 0;
}

.hero-text {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  text-align: center;
  color: #f6f8fb;
  text-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.35);
  box-sizing: border-box;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #e3e7ed;
  opacity: 0.95;
  line-height: 1.5;
}

.main-panel {
  position: relative;
  z-index: 1;
  margin-top: 0;
  padding: 32rpx;
  padding-bottom: calc(70rpx + env(safe-area-inset-bottom));
  background: var(--bg-color);
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  flex: 1;
  box-sizing: border-box;
}

.menu-grid {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  align-items: stretch;
}

.menu-item {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.menu-item:active {
  transform: scale(0.98);
}

.main-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 44rpx 24rpx;
  min-height: 420rpx;
  box-sizing: border-box;
}

.right-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.sub-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  min-height: 190rpx;
  box-sizing: border-box;
}

.item-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.icon-placeholder {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.sub-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.menu-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.menu-desc {
  font-size: 20rpx;
  color: #888;
}

.service-tags {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 12rpx 0 4rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  color: #555;
  font-size: 22rpx;
  flex-wrap: wrap;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.iconfont {
  font-size: 24rpx;
}
