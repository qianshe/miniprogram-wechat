.cart-container {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: 120rpx;
  display: flex;
  flex-direction: column;
}

.cart-list {
  padding: 20rpx;
  flex: 1;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: var(--border-radius);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  background: #f8f8f8;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 160rpx;
  padding: 4rpx 0;
}

.item-name {
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 12rpx;
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-price {
  color: var(--danger-color);
  font-size: 32rpx;
  font-weight: bold;
}

.item-price::before {
  content: '¥';
  font-size: 24rpx;
  margin-right: 2rpx;
}

.delete-btn {
  padding: 20rpx;
  color: var(--text-sub);
  font-size: 32rpx;
}

/* 底部结算栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.select-all {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  margin-right: 30rpx;
}

.select-all text {
  font-size: 28rpx;
  color: var(--text-main);
  margin-left: 12rpx;
}

.total-info {
  flex: 1;
  text-align: right;
  padding-right: 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-end;
}

.total-label {
  font-size: 24rpx;
  color: var(--text-main);
}

.total-price {
  color: var(--danger-color);
  font-size: 36rpx;
  font-weight: bold;
}

.total-price::before {
  content: '¥';
  font-size: 26rpx;
  margin-right: 2rpx;
}

.checkout-btn {
  width: 220rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #ddd;
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.3s;
}

.checkout-btn.active {
  background: var(--primary-color);
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
}

.red-theme .checkout-btn.active {
  background: var(--danger-color);
  box-shadow: 0 8rpx 20rpx rgba(244, 67, 54, 0.3);
}

.checkout-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 空状态 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-cart image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 30rpx;
  opacity: 0.8;
}

.empty-cart text {
  color: var(--text-sub);
  font-size: 28rpx;
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: var(--bg-color);
}
