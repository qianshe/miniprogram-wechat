<view class="cart-container {{systemType}}-theme">
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading || syncLoading}}">
    <view class="loading-text">{{syncLoading ? '同步清单数据中...' : '加载中...'}}</view>
  </view>

  <!-- 空清单显示 -->
  <view class="empty-cart" wx:if="{{!cartItems.length && !loading}}">
    <image 
      class="empty-cart-image"
      src="https://tdesign.gtimg.com/mobile/demos/example3.png" 
      mode="aspectFit">
    </image>
    <text class="empty-cart-text">清单为空</text>
  </view>

  <!-- 清单列表 -->
  <view class="cart-list" wx:elif="{{cartItems.length}}">
    <view class="cart-item-wrapper" wx:for="{{cartItems}}" wx:key="id">
      <view 
        class="cart-item {{item.isTouchMove ? 'touch-move' : ''}}" 
        style="transform: translateX({{item.translateX || 0}}rpx)"
        data-index="{{index}}"
        bindtouchstart="touchStart"
        bindtouchmove="touchMove"
        bindtouchend="touchEnd"
      >
        <label class="checkbox-label" data-index="{{index}}" bindtap="toggleSelect">
          <checkbox checked="{{item.selected}}" color="#07C160"/>
        </label>
        <image 
          class="item-image" 
          src="{{item.image}}" 
          mode="aspectFill">
        </image>
        <view class="item-info">
          <view class="item-name">{{item.name}}</view>
          <view class="item-row">
            <view class="price-block">
              <text class="item-price {{systemType}}-price">¥{{item.displayPrice}}</text>
            </view>
            <view class="quantity-stepper">
              <view class="step-btn" data-index="{{index}}" bindtap="decreaseQuantity">-</view>
              <view class="step-value">{{item.quantity}}</view>
              <view class="step-btn" data-index="{{index}}" bindtap="increaseQuantity">+</view>
            </view>
          </view>
        </view>
      </view>
      <view class="item-delete" bindtap="deleteItem" data-index="{{index}}">
        删除
      </view>
    </view>
  </view>

  <!-- 底部结算栏 -->
  <view class="footer {{systemType}}-footer {{cartItems.length ? '' : 'empty'}}">
    <label class="select-all" bindtap="toggleSelectAll">
      <checkbox checked="{{allSelected}}" color="#07C160"/>
      <text class="select-all-text">全选</text>
    </label>
    <view class="total-info">
      <text>小计：</text>
      <text class="total-price {{systemType}}-price">¥{{totalAmount}}</text>
    </view>
    <view 
      class="checkout-btn {{!selectedCount ? 'disabled' : ''}}"
      bindtap="checkout"
      role="button"
      aria-disabled="{{!selectedCount}}"
      aria-label="确认下单，已选{{selectedCount}}件商品"
    >
      <text class="btn-text">确认下单({{selectedCount}})</text>
    </view>
  </view>
</view>
