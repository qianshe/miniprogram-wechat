/** index.wxss */
page {
  background: #f6f0e7;
}

.scrollarea {
  flex: 1;
  display: block;
  overflow-y: hidden;
  background: #f6f0e7;
}

.page-body {
  min-height: 100vh;
  padding: 32rpx 24rpx calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero-card {
  background: linear-gradient(180deg, #faf7f2 0%, #ffffff 60%, #faf7f2 100%);
  border-radius: 28rpx;
  padding: 32rpx 24rpx 40rpx;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
}

.hero-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.35), transparent 45%),
              radial-gradient(circle at 80% 0%, rgba(255, 255, 255, 0.25), transparent 40%);
  pointer-events: none;
}

.hero-text {
  text-align: center;
  color: #2c3e50;
  margin-bottom: 24rpx;
  text-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.12);
}

.hero-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: #4f5b62;
  opacity: 0.9;
  line-height: 1.5;
}

.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  gap: 14rpx;
  position: relative;
  z-index: 1;
}

.userinfo-avatar {
  overflow: hidden;
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.12);
  border: 6rpx solid #fff;
  background: #f0f0f0;
}

.userinfo-nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: #2c3e50;
}

.white-avatar {
  border-color: #fff;
}

.white-text {
  color: #2c3e50;
}

.red-avatar {
  border-color: #fff6f0;
}

.red-text {
  color: #c0392b;
}

.login-tip {
  font-size: 28rpx;
  color: #5f6368;
  margin: 8rpx 0;
}

.login-btn {
  width: 340rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  color: #fff;
  border-radius: 46rpx;
  margin: 20rpx 0 8rpx;
  font-size: 30rpx;
  padding: 0;
  font-weight: 600;
  border: none;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.12);
  transition: all 0.25s ease;
}

.login-btn:active {
  transform: scale(0.98);
  opacity: 0.92;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.1);
}

.white-btn {
  background: #d9b78c;
}

.red-btn {
  background: #d24b41;
}

.login-btn::after {
  border: none;
}

.card-list {
  width: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.05);
  background: #fff;
  border: 1rpx solid #efe7dc;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 24rpx;
  color: #2c3e50;
}

.list-item + .list-item {
  border-top: 1rpx solid #f2ede5;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #f5ede2;
  color: #b8865c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.icon-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #b8865c;
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
}

.item-arrow {
  font-size: 32rpx;
  color: #c0b6a8;
  padding-left: 12rpx;
}
