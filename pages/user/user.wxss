/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-color);
}

.scrollarea {
  flex: 1;
  overflow-y: hidden;
  display: block; 
  box-sizing: border-box;
}

.container {
  padding: 0;
}

/* 用户信息区域优化 */
.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding: 60rpx 0 80rpx;
  background: #fff;
  position: relative;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

/* 添加背景装饰 */
.userinfo::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 24rpx;
  background: linear-gradient(to bottom, rgba(255,255,255,0), var(--bg-color));
}

.userinfo-avatar {
  overflow: hidden;
  width: 160rpx;
  height: 160rpx;
  margin: 20rpx;
  border-radius: 50%;
  box-shadow: var(--shadow-md);
  border: 6rpx solid #fff;
}

.userinfo-nickname {
  font-size: 36rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

/* 白事系统主题 */
.white-theme .userinfo {
  background: linear-gradient(180deg, #f0f0f0 0%, #ffffff 100%);
}

.white-avatar {
  border-color: #fff;
}

.white-text {
  color: #333333;
}

/* 红事系统主题 */
.red-theme .userinfo {
  background: linear-gradient(180deg, #fff3e0 0%, #ffffff 100%);
}

.red-avatar {
  border-color: #fff;
}

.red-text {
  color: #d32f2f;
}

/* 登录按钮优化 */
.login-tip {
  font-size: 28rpx;
  color: var(--text-sub);
  margin: 20rpx 0;
}

.login-btn {
  width: 320rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  color: #fff;
  border-radius: 44rpx;
  margin: 32rpx 0;
  font-size: 30rpx;
  padding: 0;
  font-weight: 600;
  border: none;
  box-shadow: var(--shadow-md);
  transition: all 0.3s ease;
}

.login-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
  box-shadow: var(--shadow-sm);
}

.white-btn {
  background: var(--primary-color);
}

.red-btn {
  background: var(--danger-color);
}

.login-btn::after {
  border: none;
}

/* 功能列表区域优化 */
.function-area {
  width: 92%;
  margin: 0 auto;
  border-radius: var(--border-radius);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  background: #fff;
}

.function-area t-cell-group {
  background: transparent;
}

.function-area .t-cell {
  padding: 32rpx;
  font-size: 30rpx;
  color: var(--text-main);
}

.function-area .t-cell::after {
  left: 32rpx;
  right: 32rpx;
  border-bottom-color: #f5f5f5;
}

/* 绑定手机号按钮 */
.userinfo-phone {
  font-size: 26rpx;
  color: var(--text-sub);
  margin: 10rpx 0;
}

.bind-phone-btn {
  width: 200rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  margin-top: 16rpx;
  background: rgba(255,255,255,0.8);
  backdrop-filter: blur(4px);
  color: var(--primary-color);
  border: 1rpx solid var(--primary-color);
  border-radius: 30rpx;
}

.red-theme .bind-phone-btn {
  color: var(--danger-color);
  border-color: var(--danger-color);
}
