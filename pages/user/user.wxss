/** index.wxss */
page {
  background: var(--bg-color);
}

.scrollarea {
  flex: 1;
  display: block;
  overflow-y: hidden;
  background: var(--bg-color);
}

.page-body {
  min-height: 100vh;
  padding: 32rpx 24rpx calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero-card {
  background: linear-gradient(180deg, var(--card-bg) 0%, #ffffff 60%, var(--card-bg) 100%);
  border-radius: 28rpx;
  padding: 32rpx 24rpx 40rpx;
  box-shadow: var(--shadow-md);
  position: relative;
  overflow: hidden;
}

.hero-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.35), transparent 45%),
              radial-gradient(circle at 80% 0%, rgba(255, 255, 255, 0.25), transparent 40%);
  pointer-events: none;
}

.hero-text {
  text-align: center;
  color: var(--text-main);
  margin-bottom: 24rpx;
  text-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.12);
}

.hero-title {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: var(--text-sub);
  opacity: 0.9;
  line-height: 1.5;
}

.userinfo {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  gap: 14rpx;
  position: relative;
  z-index: 1;
}

.userinfo-avatar {
  overflow: hidden;
  width: 168rpx;
  height: 168rpx;
  border-radius: 50%;
  box-shadow: var(--shadow-md);
  border: 6rpx solid #fff;
  background: #f0f0f0;
}

.userinfo-nickname {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-main);
}

.white-avatar {
  border-color: #fff;
}

.white-text {
  color: var(--text-main);
}

.red-avatar {
  border-color: #fff6f0;
}

.red-text {
  color: var(--danger-color);
}

.avatar-btn {
  width: 168rpx;
  height: 168rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  overflow: hidden;
  background: transparent;
  border: none;
}

.avatar-btn::after {
  border: none;
}

.nickname-input {
  width: 340rpx;
  height: 80rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--text-main);
  background: rgba(255, 255, 255, 0.8);
  border-radius: 40rpx;
  margin: 16rpx 0;
  padding: 0 24rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--package-border);
}

.nickname-input::placeholder {
  color: var(--text-sub);
}

.login-btn {
  width: 340rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  color: #fff;
  border-radius: 46rpx;
  margin: 20rpx 0 8rpx;
  font-size: 30rpx;
  padding: 0;
  font-weight: 600;
  border: none;
  box-shadow: var(--shadow-md);
  transition: all 0.25s ease;
}

.login-btn:active {
  transform: scale(0.98);
  opacity: 0.92;
  box-shadow: var(--shadow-sm);
}

.white-btn {
  background: var(--package-accent);
}

.red-btn {
  background: var(--danger-color);
}

.login-btn::after {
  border: none;
}

.btn-disabled {
  opacity: 0.5;
  background: #ccc !important;
}

/* 登录步骤引导样式 */
.login-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  gap: 0;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  opacity: 0.4;
  transition: all 0.3s ease;
}

.step-active {
  opacity: 1;
}

.step-done .step-num {
  background: var(--success-color, #07C160);
  color: #fff;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--package-border);
  color: var(--text-sub);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.step-active .step-num {
  background: var(--primary-color);
  color: #fff;
}

.step-text {
  font-size: 22rpx;
  color: var(--text-sub);
}

.step-active .step-text {
  color: var(--text-main);
  font-weight: 500;
}

.step-line {
  width: 60rpx;
  height: 4rpx;
  background: var(--package-border);
  margin: 0 16rpx;
  margin-bottom: 30rpx;
  border-radius: 2rpx;
  transition: all 0.3s ease;
}

.line-active {
  background: var(--success-color, #07C160);
}

/* 头像选择优化 */
.avatar-btn {
  position: relative;
}

.avatar-selected .userinfo-avatar {
  border-color: var(--success-color, #07C160);
}

.avatar-tip {
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  background: var(--primary-color);
  color: #fff;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.avatar-check {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: var(--success-color, #07C160);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  border: 4rpx solid #fff;
}

/* 昵称输入优化 */
.nickname-wrapper {
  opacity: 0.4;
  transform: scale(0.95);
  transition: all 0.3s ease;
  pointer-events: none;
}

.nickname-show {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
}

.card-list {
  width: 100%;
  border-radius: var(--package-card-radius);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  background: #fff;
  border: 1rpx solid var(--package-border);
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 24rpx;
  color: var(--text-main);
}

.list-item + .list-item {
  border-top: 1rpx solid var(--package-border);
}

.item-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--package-item-radius);
  background: var(--package-accent-light);
  color: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.icon-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-color);
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.item-arrow {
  font-size: 32rpx;
  color: var(--package-accent);
  padding-left: 12rpx;
}
