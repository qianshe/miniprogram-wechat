/**
 * Package List Page Styles
 * Design: Luxury/refined aesthetic
 */

.package-list-page {
  min-height: 100vh;
  background-color: var(--bg-color);
  display: flex;
  flex-direction: column;
}

/* Page Header */
.page-header {
  background: rgba(252, 251, 248, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(239, 231, 220, 0.6);
  position: sticky;
  top: 0;
  z-index: 100;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* Package Scroll */
.package-scroll {
  flex: 1;
  height: calc(100vh - 120rpx);
}

/* Package Cards Container */
.package-cards {
  padding: 24rpx;
  padding-bottom: 0;
}

/* Package Card */
.package-card {
  background: var(--card-bg);
  border-radius: var(--package-card-radius, 24rpx);
  box-shadow: 0 10rpx 30rpx rgba(184, 134, 92, 0.08);
  border: 1rpx solid var(--package-border, #efe7dc);
  margin-bottom: 24rpx;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.package-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(184, 134, 92, 0.05);
}

/* Card Header */
.card-header {
  position: relative;
  width: 100%;
  height: 280rpx;
  overflow: hidden;
}

.package-image {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #f5efe3 0%, #efe7dc 100%);
}

.package-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: linear-gradient(135deg, var(--package-accent, #c9a86c) 0%, var(--primary-color) 100%);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(184, 134, 92, 0.3);
}

.badge-text {
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 600;
}

/* Card Body */
.card-body {
  padding: 24rpx;
}

.package-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.package-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.4;
  flex: 1;
}

.item-count-badge {
  background: var(--package-accent-light, #f5efe3);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  margin-left: 16rpx;
}

.item-count {
  font-size: 22rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.package-desc {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* Price Section */
.price-section {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}

.price-main {
  display: flex;
  align-items: baseline;
}

.currency {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 700;
  margin-right: 2rpx;
}

.price-value {
  font-size: 34rpx;
  color: var(--primary-color);
  font-weight: 700;
  line-height: 1.2;
}

.price-original {
  font-size: 24rpx;
  color: var(--text-sub);
  text-decoration: line-through;
  margin-left: 16rpx;
}

/* Action Hint */
.action-hint {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--package-border, #efe7dc);
}

.hint-text {
  font-size: 24rpx;
  color: var(--text-sub);
}

.arrow-icon {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
}

.arrow {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* Loading Section */
.loading-section {
  padding: 40rpx 24rpx;
}

.loading-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid var(--package-border, #efe7dc);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-right: 12rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* No More */
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
}

.divider-line {
  width: 60rpx;
  height: 1rpx;
  background: var(--package-border, #efe7dc);
}

.no-more-text {
  font-size: 24rpx;
  color: var(--text-sub);
  margin: 0 20rpx;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  background: var(--package-accent-light, #f5efe3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon-text {
  font-size: 48rpx;
  color: var(--primary-color);
  font-weight: 700;
}

.empty-title {
  font-size: 32rpx;
  color: var(--text-main);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-sub);
}

/* Safe Area */
.safe-area-bottom {
  height: calc(env(safe-area-inset-bottom) + 40rpx);
}