<!--
  Package Confirm Page
  Order confirmation before submission
-->
<view class="package-confirm-page">
  <!-- Loading State -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- Main Content -->
  <block wx:else>
    <!-- Address Section -->
    <view class="section address-section" bindtap="selectAddress">
      <view class="section-header">
        <text class="section-title">收货地址</text>
      </view>
      <view wx:if="{{address}}" class="address-info">
        <view class="address-user">
          <text class="address-name">{{address.userName}}</text>
          <text class="address-phone">{{address.telNumber}}</text>
          <text class="address-tag" wx:if="{{address.isDefault}}">默认</text>
        </view>
        <view class="address-detail">{{address.fullAddress}}</view>
      </view>
      <view wx:else class="no-address">
        <text>点击选择收货地址</text>
      </view>
      <view class="address-arrow">></view>
    </view>

    <!-- Package Info Card -->
    <view class="section package-section">
      <view class="section-header">
        <text class="section-title">套餐信息</text>
      </view>
      <view class="package-card">
        <view class="package-image-wrap">
          <image 
            class="package-image" 
            src="{{packageInfo.imageUrl || '/images/package-default.png'}}"
            mode="aspectFill"
          />
        </view>
        <view class="package-info">
          <text class="package-name">{{packageInfo.name}}</text>
          <text class="package-desc">{{packageInfo.description}}</text>
          <view class="package-type-badge {{packageInfo.type}}">
            <text class="badge-text">{{packageInfo.type === 'white' ? '白事套餐' : '红事套餐'}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Items List -->
    <view class="section items-section">
      <view class="section-header">
        <text class="section-title">商品清单</text>
        <view class="section-meta">
          <text class="section-count">共{{items.length}}项</text>
          <text class="customized-hint" wx:if="{{hasCustomizedItems}}">已定制{{customizedCount}}项</text>
        </view>
      </view>
      <view class="items-list">
        <view class="item-row {{item.isCustomized ? 'customized' : ''}}" wx:for="{{items}}" wx:key="productId">
          <view class="item-image-wrap">
            <image 
              class="item-image" 
              src="{{item.productImage || '/images/product-default.png'}}"
              mode="aspectFill"
            />
            <view class="customized-badge" wx:if="{{item.isCustomized}}">
              <text class="customized-badge-text">已定制</text>
            </view>
          </view>
          <view class="item-info">
            <text class="item-category">{{item.categoryName}}</text>
            <text class="item-name">{{item.productName}}</text>
            <text class="item-unit-price">单价: {{item.displayUnitPrice}}</text>
          </view>
          <view class="item-qty-price">
            <text class="item-qty">x{{item.quantity}}</text>
            <text class="item-price">{{item.displaySubtotal}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Remarks -->
    <view class="section remarks-section">
      <view class="section-header">
        <text class="section-title">订单备注</text>
        <text class="section-hint">(选填)</text>
      </view>
      <textarea 
        class="remarks-textarea" 
        placeholder="如有特殊要求，请在此说明..."
        value="{{remarks}}"
        bindinput="onRemarksInput"
        maxlength="200"
      />
    </view>

    <!-- Price Summary -->
    <view class="section price-section">
      <view class="section-header">
        <text class="section-title">价格明细</text>
      </view>
      <view class="price-breakdown">
        <view class="price-row">
          <text class="price-label">套餐原价</text>
          <text class="price-value original">{{displayOriginalPrice}}</text>
        </view>
        <view class="price-row" wx:if="{{hasSaved}}">
          <text class="price-label">套餐优惠</text>
          <text class="price-value saved">-{{displaySavedAmount}}</text>
        </view>
        <view class="price-row total">
          <text class="price-label">应付金额</text>
          <view class="price-value-wrap">
            <text class="currency">¥</text>
            <text class="price-value total-price">{{displayTotalPrice}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Bottom Placeholder -->
    <view class="bottom-placeholder"></view>

    <!-- Bottom Bar -->
    <view class="bottom-bar">
      <view class="bottom-left">
        <text class="total-label">合计:</text>
        <view class="total-amount">
          <text class="total-currency">¥</text>
          <text class="total-value">{{displayTotalPrice}}</text>
        </view>
      </view>
      <view class="bottom-right">
        <view class="back-btn" bindtap="onGoBack">
          <text class="back-text">返回修改</text>
        </view>
        <view class="submit-btn {{submitting ? 'disabled' : ''}}" bindtap="onSubmitOrder">
          <text class="submit-text">{{submitting ? '提交中...' : '提交订单'}}</text>
        </view>
      </view>
    </view>
  </block>
</view>

<!-- Address Selection Modal -->
<view class="address-modal-mask" wx:if="{{showAddressModal}}" bindtap="hideAddressModal"></view>
<view class="address-modal" wx:if="{{showAddressModal}}" catchtap="preventBubble">
  <view class="modal-header">
    <text class="modal-title">选择收货地址</text>
    <view class="modal-close" bindtap="hideAddressModal">×</view>
  </view>
  
  <view class="modal-body">
    <!-- Saved address list -->
    <view wx:if="{{addressList.length > 0}}" class="saved-address-list">
      <view 
        class="saved-address-item {{address.id === item.id ? 'selected' : ''}}" 
        wx:for="{{addressList}}" 
        wx:key="id"
        bindtap="onSelectAddress"
        data-index="{{index}}"
      >
        <view class="address-item-info">
          <view class="address-item-header">
            <text class="address-item-name">{{item.userName}}</text>
            <text class="address-item-phone">{{item.telNumber}}</text>
            <text class="address-item-tag" wx:if="{{item.isDefault}}">默认</text>
          </view>
          <view class="address-item-detail">{{item.fullAddress}}</view>
        </view>
        <view class="address-item-check" wx:if="{{address.id === item.id}}">✓</view>
      </view>
    </view>
    
    <!-- No address hint -->
    <view wx:else class="no-saved-address">
      <text>暂无保存的收货地址</text>
    </view>
  </view>
  
  <view class="modal-footer">
    <view class="modal-btn wechat-btn" bindtap="useWechatAddress">使用微信地址</view>
    <view class="modal-btn manage-btn" bindtap="goToAddressManage">管理地址</view>
  </view>
</view>