/**
 * Package Detail Page Styles
 * Design: Luxury/refined aesthetic
 */

.package-detail-page {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: env(safe-area-inset-bottom);
}

/* Loading Container */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--package-border, #efe7dc);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-sub);
}

/* Package Header */
.package-header {
  position: relative;
  width: 100%;
  height: 400rpx;
  overflow: hidden;
}

.header-image {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #f5efe3 0%, #efe7dc 100%);
}

.header-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.6) 0%, transparent 100%);
}

.header-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
}

.package-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.package-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* Items Section */
.items-section {
  padding: 24rpx;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.section-subtitle {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* Item Card */
.items-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.item-card {
  background: var(--card-bg);
  border-radius: var(--package-card-radius, 24rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid var(--package-border, #efe7dc);
  overflow: hidden;
}

.item-header {
  padding: 20rpx 24rpx;
  background: var(--package-accent-light, #f5efe3);
  border-bottom: 1rpx solid var(--package-border, #efe7dc);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.category-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-color);
}

/* Category Subtotal in Header */
.category-subtotal {
  display: flex;
  align-items: center;
}

.category-subtotal .subtotal-text {
  font-size: 24rpx;
  color: var(--text-sub);
}

.category-subtotal .subtotal-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--primary-color);
}

/* Products Container - 多商品容器 */
.products-container {
  padding: 16rpx 24rpx;
}

/* Product Item - 单个商品卡片 */
.product-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--package-border, #efe7dc);
}

.product-item:last-child {
  border-bottom: none;
}

.product-item.customized {
  background: linear-gradient(135deg, rgba(184, 134, 92, 0.05) 0%, rgba(201, 168, 108, 0.03) 100%);
  border-radius: 12rpx;
  padding: 16rpx;
  margin: 8rpx 0;
}

/* Product Info */
.product-info {
  display: flex;
  align-items: center;
  padding-bottom: 16rpx;
  margin-bottom: 12rpx;
}

.product-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--package-item-radius, 16rpx);
  background: #f3efe8;
  margin-right: 16rpx;
}

.product-details {
  flex: 1;
}

/* Product Name Row - 商品名称行 */
.product-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.product-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-main);
  line-height: 1.4;
  flex: 1;
}

.product-price {
  font-size: 22rpx;
  color: var(--text-sub);
}

/* Customized Badge - 已定制标签 */
.customized-badge {
  display: inline-flex;
  padding: 4rpx 12rpx;
  background: var(--primary-color, #b8865c);
  border-radius: 8rpx;
  margin-left: 12rpx;
}

.customized-badge-text {
  font-size: 18rpx;
  color: #ffffff;
  font-weight: 500;
}

.change-btn {
  padding: 12rpx 24rpx;
  background: var(--package-accent-light, #f5efe3);
  border-radius: 24rpx;
}

.change-text {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
}

/* Quantity Row */
.quantity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 12rpx;
  margin-bottom: 12rpx;
}

.quantity-label {
  font-size: 24rpx;
  color: var(--text-sub);
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--package-accent-light, #f5efe3);
  border-radius: 50%;
  transition: all 0.2s ease;
}

.qty-btn.disabled {
  opacity: 0.4;
}

.qty-btn:active:not(.disabled) {
  background: var(--package-accent, #c9a86c);
}

.qty-btn:active:not(.disabled) .qty-icon {
  color: #ffffff;
}

.qty-icon {
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: 600;
}

.qty-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  min-width: 40rpx;
  text-align: center;
}

/* Product Subtotal Row - 商品小计行 */
.product-subtotal-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-subtotal-row .subtotal-label {
  font-size: 22rpx;
  color: var(--text-sub);
}

.product-subtotal-row .subtotal-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-color);
}

/* Legacy Subtotal Row - 保留兼容 */
.subtotal-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.subtotal-label {
  font-size: 26rpx;
  color: var(--text-sub);
}

.subtotal-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--primary-color);
}

/* Price Summary */
.price-summary {
  margin: 24rpx;
  padding: 24rpx;
  background: var(--card-bg);
  border-radius: var(--package-card-radius, 24rpx);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid var(--package-border, #efe7dc);
}

.summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
}

.summary-row:not(:last-child) {
  border-bottom: 1rpx solid var(--package-border, #efe7dc);
}

.summary-row.total {
  padding-top: 16rpx;
}

.summary-label {
  font-size: 26rpx;
  color: var(--text-sub);
}

.summary-row.total .summary-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.summary-value {
  font-size: 26rpx;
  color: var(--text-main);
}

.summary-value.original {
  text-decoration: line-through;
  color: var(--text-sub);
}

.summary-value.saved {
  color: var(--package-success, #5a8f7b);
}

.summary-value.total-price {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--primary-color);
}

/* Bottom Placeholder */
.bottom-placeholder {
  height: 160rpx;
}

/* Bottom Bar */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(252, 251, 248, 0.9);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-top: 1rpx solid rgba(239, 231, 220, 0.6);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.price-display {
  display: flex;
  align-items: baseline;
}

.price-label {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-right: 12rpx;
}

.price-amount {
  display: flex;
  align-items: baseline;
}

.price-amount .currency {
  font-size: 26rpx;
  color: var(--primary-color);
  font-weight: 700;
}

.price-amount .amount {
  font-size: 40rpx;
  color: var(--primary-color);
  font-weight: 700;
  line-height: 1;
}

.confirm-btn {
  padding: 24rpx 64rpx;
  background: linear-gradient(135deg, var(--package-accent, #c9a86c) 0%, var(--primary-color) 100%);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(184, 134, 92, 0.3);
}

.confirm-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

/* ========================================
   Product Replacer Popup Styles
   ======================================== */

/* Popup Overlay */
.popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 1000;
  pointer-events: none;
  transition: background 0.3s ease;
}

.popup-overlay.visible {
  background: rgba(0, 0, 0, 0.5);
  pointer-events: auto;
}

/* Popup Container */
.popup-container {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--card-bg, #fcfbf8);
  border-radius: 28rpx 28rpx 0 0;
  max-height: 80vh;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
  z-index: 1001;
}

.popup-container.visible {
  transform: translateY(0);
}

/* Popup Header */
.popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--package-border, #efe7dc);
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main, #2c3e50);
}

.popup-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--package-accent-light, #f5efe3);
  border-radius: 50%;
}

.popup-close:active {
  background: var(--package-border, #efe7dc);
}

.close-icon {
  font-size: 28rpx;
  color: var(--text-sub, #6b6b6b);
  font-weight: 600;
}

/* Current Product Section */
.current-product {
  padding: 24rpx 32rpx;
  background: var(--package-accent-light, #f5efe3);
  border-bottom: 1rpx solid var(--package-border, #efe7dc);
}

.current-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-sub, #6b6b6b);
  margin-bottom: 16rpx;
}

.current-info {
  display: flex;
  align-items: center;
}

.current-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  background: #f3efe8;
  margin-right: 16rpx;
}

.current-details {
  flex: 1;
}

.current-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main, #2c3e50);
  margin-bottom: 4rpx;
}

.current-price {
  font-size: 24rpx;
  color: var(--primary-color, #b8865c);
  font-weight: 500;
}

/* Replacer Loading */
.replacer-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
}

.loading-spinner.small {
  width: 40rpx;
  height: 40rpx;
  border-width: 3rpx;
}

/* Available Products Section */
.available-products {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.available-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-sub, #6b6b6b);
  padding: 20rpx 32rpx 12rpx;
}

.products-scroll {
  flex: 1;
  height: 100%; /* 确保填满父容器 */
  overflow-y: scroll; /* 允许滚动 */
  -webkit-overflow-scrolling: touch;
}

.products-list {
  display: flex;
  flex-direction: column;
  padding: 0 32rpx 120rpx; /* 大幅增加底部内边距，确保最后一个商品完全可见且有呼吸感 */
  gap: 20rpx;
}

/* Product Option List Item */
.product-option {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: var(--card-bg, #fcfbf8);
  border-radius: 20rpx;
  border: 1rpx solid var(--package-border, #efe7dc);
  padding: 20rpx;
  position: relative;
  transition: all 0.2s ease;
}

.product-option:active {
  transform: scale(0.99);
}

.product-option.selected {
  border-color: var(--primary-color, #b8865c);
  background: rgba(184, 134, 92, 0.04);
}

.option-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f3efe8;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.option-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}

.option-main-info {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.option-name {
  font-size: 28rpx;
  color: var(--text-main, #2c3e50);
  font-weight: 500;
  line-height: 1.3;
  margin-right: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.option-price {
  font-size: 26rpx;
  color: var(--primary-color, #b8865c);
  font-weight: 600;
}

.option-check {
  width: 44rpx;
  height: 44rpx;
  background: var(--primary-color, #b8865c);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.check-icon {
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 700;
}

/* Price Difference Badge */
.price-diff {
  display: inline-flex;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  flex-shrink: 0;
}

.price-diff.positive {
  background: rgba(184, 134, 92, 0.15);
  color: var(--primary-color, #b8865c);
}

.price-diff.negative {
  background: rgba(90, 143, 123, 0.15);
  color: var(--package-success, #5a8f7b);
}

.price-diff.zero {
  background: var(--package-accent-light, #f5efe3);
  color: var(--text-sub, #6b6b6b);
}

.diff-text {
  font-weight: 500;
}

/* Empty Products State */
.empty-products {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-sub, #6b6b6b);
}

/* Popup Footer */
.popup-footer {
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--package-border, #efe7dc);
  background: var(--card-bg, #fcfbf8);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05); /* 增加顶部阴影提升层级感 */
  z-index: 10;
}

.replace-btn {
  width: 100%;
  padding: 24rpx;
  background: linear-gradient(135deg, var(--package-accent, #c9a86c) 0%, var(--primary-color, #b8865c) 100%);
  border-radius: 48rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(184, 134, 92, 0.3);
  transition: all 0.2s ease;
  box-sizing: border-box; /* 显式设置盒子模型，防止宽度溢出 */
}

.replace-btn:active:not(.disabled) {
  transform: scale(0.98);
  opacity: 0.9;
}

.replace-btn.disabled {
  background: var(--package-border, #efe7dc);
  box-shadow: none;
  opacity: 0.6;
}

.replace-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.replace-btn.disabled .replace-btn-text {
  color: var(--text-sub, #6b6b6b);
}

/* Customized Item Indicator - 已定制分类指示器 */
.item-card.customized .item-header {
  background: linear-gradient(135deg, rgba(184, 134, 92, 0.15) 0%, rgba(201, 168, 108, 0.1) 100%);
}