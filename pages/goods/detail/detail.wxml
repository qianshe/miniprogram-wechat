<view class="goods-detail" wx:if="{{!loading && goods}}">
  <swiper class="goods-swiper" indicator-dots autoplay interval="3000" duration="500">
    <swiper-item wx:for="{{goods.images}}" wx:key="*this">
      <image 
        src="{{item}}" 
        mode="aspectFill" 
        bindtap="previewImage"
        data-current="{{item}}"
      />
    </swiper-item>
  </swiper>

  <view class="goods-info">
    <view class="goods-name">{{goods.name}}</view>
    <view class="goods-price">{{goods.displayPrice}}</view>
    <view class="goods-stock">库存：{{goods.stock}}</view>
  </view>

  <view class="goods-description">
    <view class="section-title">商品描述</view>
    <view class="description-content">{{goods.description || '暂无描述'}}</view>
  </view>

  <view class="goods-detail-info">
    <view class="section-title">商品信息</view>
    <view class="info-item">
      <text class="label">商品编号</text>
      <text class="value">{{goods._id}}</text>
    </view>
    <view class="info-item">
      <text class="label">上架时间</text>
      <text class="value">{{goods.displayTime}}</text>
    </view>
    <view class="info-item">
      <text class="label">分类</text>
      <text class="value">{{goods.category === 0 ? '自营用品' : '自营用品'}}</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar {{systemType}}-theme">
    <button class="add-cart-btn" bindtap="showSkuPopup">加入清单</button>
  </view>

  <!-- 自定义弹窗 -->
  <view class="sku-mask" wx:if="{{showSkuPopup}}" catchtap="closeSkuPopup"></view>
  <view class="sku-drawer" wx:if="{{showSkuPopup}}" catchtouchmove="true">
    <view class="sku-popup">
      <view class="sku-header">
        <image src="{{goods.image}}" mode="aspectFill" class="sku-image" />
        <view class="sku-info">
          <view class="sku-price">{{goods.displayPrice}}</view>
          <view class="sku-stock">库存：{{goods.stock}}</view>
        </view>
      </view>

      <view class="sku-content">
        <view class="quantity-section">
          <text class="quantity-label">购买数量</text>
          <view class="quantity-stepper">
            <view class="step-btn" bindtap="decreaseQuantity">-</view>
            <view class="step-value">{{quantity}}</view>
            <view class="step-btn" bindtap="increaseQuantity">+</view>
          </view>
        </view>
      </view>

      <view class="sku-footer">
        <button class="confirm-btn" bindtap="addToCart">加入清单</button>
      </view>
    </view>
  </view>
</view>

<view class="loading" wx:if="{{loading}}">加载中...</view>
