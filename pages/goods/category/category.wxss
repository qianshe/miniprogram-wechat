page {
  background-color: #f5f5f5;
}

page .round-image {
  border-radius: 12rpx;
}

/* 自定义侧边栏样式 */
.side-bar {
  width: 200rpx;
  background: #f5f5f5;
  height: 100%;
}

.side-bar-item {
  padding: 30rpx 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  border-bottom: 1rpx solid #eee;
  background: white;
  margin-bottom: 2rpx;
}

.side-bar-item.active {
  background: #07c160;
  color: white;
}

/* 商品列表样式 */
.product-list {
  padding: 20rpx;
}

.product-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: white;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.product-price {
  font-size: 28rpx;
  color: #ff4757;
  font-weight: bold;
}

/* 加载状态样式 */
.loading-text {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  padding: 20rpx;
}

.side-bar-wrapper {
  display: flex;
  height: calc(100vh - 100rpx); /* 减去 TabBar 的高度 */
  overflow: hidden;
  background: #fff;
  /* 固定位置 */
  position: fixed;
  left: 0;
  right: 0;

  padding-bottom: env(safe-area-inset-bottom); /* 适配底部安全区域 */
}

.side-bar-wrapper .content {
  flex: 1;
  transition: transform 0.3s ease;
  position: relative;
  margin: 0;  /* 移除所有外边距 */
  padding: 0;  /* 移除所有内边距 */
  width: 100%;  /* 确保宽度填充 */
}

.side-bar-wrapper .section {
  padding: 32rpx 0 120rpx; /* 增加底部padding */
  box-sizing: border-box;
  height: 100%;
  overflow-y: auto;
  margin: 0;  /* 移除所有外边距 */
  width: 100%;  /* 确保宽度填充 */
}

.side-bar-wrapper .title {
  padding-left: 40rpx;
  margin-bottom: 8rpx;
  font-size: 28rpx;
  line-height: 44rpx;
  color: #333;
}

.side-bar-wrapper .image {
  width: 96rpx;
  height: 96rpx;

  position: relative;
}

.side-bar-wrapper .cell {
  margin-right: 0 !important;
  padding-right: 32rpx !important;
}

.side-bar-wrapper .image::before {
  content: ' ';
  position: absolute;
  top: 0;
  left: 0;
  width: 200%;
  height: 200%;
  border-radius: 24rpx;
  border: 2rpx solid #ddd;
  transform-origin: 0 0;
  transform: scale(0.5);
}

.price {
  color: #e34d59;
  font-size: 24rpx;
  margin-top: 4rpx;
}

/* 底部加载状态样式 */
.loading-more,
.no-more {
  text-align: center;
  padding: 24rpx;
  color: #999;
  font-size: 24rpx;
  margin-bottom: 100rpx; /* 底部留出足够空间 */
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

/* 调整加载状态容器样式 */
.loading-status {
  position: relative;
  width: 100%;
  padding: 24rpx 0;
  text-align: center;
  background: #fff;
}

/* 确保滚动区域紧贴右边 */
.t-cell-group {
  margin-right: 0;
  padding-right: 0;
}

/* 确保单元格没有多余的边距 */
.t-cell {
  margin: 0 !important;
  padding-right: 0 !important;
}

.t-cell__title {
  padding-right: 0 !important;
}