page {
  background-color: var(--bg-color);
  --sidebar-width: 180rpx;
}

page .round-image {
  border-radius: 12rpx;
}

/* 自定义侧边栏样式 */
.side-bar-wrapper {
  display: flex;
  height: calc(100vh - 100rpx); /* 减去 TabBar 的高度 */
  overflow: hidden;
  background: #fff;
  position: fixed;
  left: 0;
  right: 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.side-bar {
  width: var(--sidebar-width);
  background: #f7f8fa;
  height: 100%;
  overflow-y: auto;
}

.side-bar-item {
  padding: 32rpx 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-main);
  position: relative;
  transition: all 0.3s;
}

.side-bar-item.active {
  background: #fff;
  color: var(--primary-color);
  font-weight: bold;
  font-size: 28rpx;
}

.side-bar-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background-color: var(--primary-color);
  border-radius: 0 4rpx 4rpx 0;
}

/* 内容区域 */
.content {
  flex: 1;
  height: 100%;
  overflow-y: auto;
  background: #fff;
  position: relative;
}

.section {
  padding: 20rpx 20rpx 120rpx;
}

.title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

/* 商品列表样式 */
.product-list {
  padding: 0;
}

.product-item {
  display: flex;
  padding: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  /* box-shadow: var(--shadow-sm); */ /* 列表模式下通常不需要阴影，保持简洁 */
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #f8f8f8;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.product-name {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-desc {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-bottom: 10rpx;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.product-price {
  font-size: 32rpx;
  color: var(--danger-color);
  font-weight: bold;
}

.product-price::before {
  content: '¥';
  font-size: 24rpx;
  margin-right: 2rpx;
}

.add-btn {
  width: 48rpx;
  height: 48rpx;
  background: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  box-shadow: 0 4rpx 10rpx rgba(7, 193, 96, 0.3);
}

/* 加载状态样式 */
.loading-status {
  padding: 30rpx 0;
  text-align: center;
}

.loading-text, .no-more {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 覆盖 TDesign 样式 */
.t-cell-group {
  margin: 0 !important;
}

.t-cell {
  padding: 20rpx !important;
}

.t-cell::after {
  left: 20rpx !important;
  right: 20rpx !important;
}

/* 侧边栏图片 */
.side-bar-wrapper .image {
  width: 100%;
  height: 100%;
  border-radius: 8rpx;
}