page {
  background-color: var(--bg-color);
  --sidebar-width: 180rpx;
}

page .round-image {
  border-radius: 12rpx;
}

.side-bar-wrapper {
  display: flex;
  height: calc(100vh - 100rpx);
  overflow: hidden;
  background: var(--bg-color);
  position: fixed;
  left: 0;
  right: 0;
  padding: 16rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 16rpx);
  box-sizing: border-box;
  gap: 16rpx;
}

.side-bar {
  width: var(--sidebar-width);
  background: var(--card-bg);
  height: 100%;
  overflow-y: auto;
  border-radius: 20rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.side-bar-item {
  padding: 30rpx 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-main);
  position: relative;
  transition: all 0.3s;
}

.side-bar-item.active {
  background: #efe4d5;
  color: var(--primary-color);
  font-weight: bold;
  font-size: 28rpx;
}

.side-bar-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background-color: var(--primary-color);
  border-radius: 0 4rpx 4rpx 0;
}

.content {
  flex: 1;
  height: 100%;
  overflow-y: auto;
  background: var(--card-bg);
  position: relative;
  border-radius: 20rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.section {
  padding: 24rpx 24rpx 120rpx;
}

.title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.product-list {
  padding: 0;
}

.product-item {
  display: flex;
  padding: 22rpx;
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #efe7dc;
}

.product-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #f3efe8;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.product-name {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 600;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-desc {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-bottom: 10rpx;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.product-price {
  font-size: 32rpx;
  color: var(--primary-color);
  font-weight: bold;
}

.product-price::before {
  content: '¥';
  font-size: 24rpx;
  margin-right: 2rpx;
}

.add-btn {
  width: 48rpx;
  height: 48rpx;
  background: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  box-shadow: 0 4rpx 10rpx rgba(184, 134, 92, 0.28);
}

.loading-status {
  padding: 30rpx 0;
  text-align: center;
}

.loading-text, .no-more {
  font-size: 24rpx;
  color: var(--text-sub);
}
