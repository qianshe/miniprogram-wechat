<view class="custom-navbar">
  <!-- 自定义导航栏 -->
</view>

<view class="side-bar-wrapper" style="height: calc(100vh - {{navbarHeight}}px)">
  <view class="side-bar">
    <view
      class="side-bar-item {{sideBarIndex === (item.value || index) ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="label"
      bindtap="onSideBarChange"
      data-value="{{item.value || index}}"
    >
      {{item.label}}
    </view>
  </view>
  <view class="content" style="transform: translateY(-{{sideBarIndex * 100}}%)">
    <scroll-view
      wx:for="{{categories}}"
      wx:key="label"
      class="section"
      scroll-y
      scroll-top="{{scrollTop}}"
      scroll-with-animation
      show-scrollbar="{{true}}"
      bindscrolltolower="onScrollToLower"
      enable-flex
      enhanced
    >
      <view class="title">{{item.title || item.label}}</view>
      <view class="product-list">
        <view class="product-item" wx:for="{{item.items}}" wx:key="index" wx:for-item="cargo" bindtap="onGoodsClick" data-id="{{cargo.id}}">
          <image class="product-image" src="{{cargo.image}}" mode="aspectFill" binderror="onImageError" data-index="{{index}}" />
          <view class="product-info">
            <text class="product-name">{{cargo.label}}</text>
            <text class="product-price">¥{{cargo.price}}</text>
          </view>
        </view>
      </view>
      
      <!-- 将加载状态移到商品列表后面 -->
      <view class="loading-status">
        <view class="loading-more" wx:if="{{loading}}">
          <text class="loading-text">加载中...</text>
        </view>
        <view class="no-more" wx:elif="{{!item.hasMore}}">
          <text>没有更多商品了</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

<custom-tab-bar></custom-tab-bar>