/* pages/index_home/index_home.wxss */

.container {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background-color: #F1ECD9; /* Beige paper color to match logo background */
}

.door {
  position: absolute;
  top: 0;
  width: 50%;
  height: 100%;
  background-color: #F1ECD9; /* Match background */
  overflow: hidden;
  z-index: 100;
  transition: transform 1.2s cubic-bezier(0.4, 0.0, 0.2, 1);
  box-sizing: border-box;
  /* Removed borders to eliminate the split line */
}

.door-left {
  left: 0;
}

.door-right {
  right: 0;
}

/* Open state classes */
.door-left.open {
  transform: translateX(-100%);
}

.door-right.open {
  transform: translateX(100%);
}

.logo-img {
  position: absolute;
  top: 50%;
  width: 200%; /* 200% of 50% parent = 100vw */
  transform: translateY(-50%);
  display: block;
}

.door-left .logo-img {
  left: 0;
}

.door-right .logo-img {
  left: -100%; /* Shift left by 50vw */
}

.click-hint {
  position: absolute;
  bottom: 12%;
  left: 50%;
  transform: translateX(-50%);
  color: #4A3B32; /* Dark brown for visibility on beige */
  font-size: 26rpx;
  letter-spacing: 4rpx;
  z-index: 101;
  opacity: 1;
  transition: opacity 0.5s;
  text-transform: uppercase;
  font-weight: 500;
}

.click-hint.fade-out {
  opacity: 0;
}