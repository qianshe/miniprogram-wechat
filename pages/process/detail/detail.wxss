.page {
  padding: 30rpx;
  min-height: 100vh;
  background: var(--bg-color);
}

/* 主题样式 */
.white-theme {
  background-color: #f8f8f8;
}

.red-theme {
  background-color: #fff3e0;
}

/* 步骤标题样式 */
.step-header {
  margin-bottom: 40rpx;
  padding: 0 10rpx;
}

.step-title {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  color: var(--text-main);
}

.white-theme .step-title {
  color: var(--text-main);
}

.red-theme .step-title {
  color: var(--danger-color);
}

.step-desc {
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.5;
}

/* 步骤图片样式 */
.step-image-container {
  margin-bottom: 40rpx;
  border-radius: var(--border-radius);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  background: #fff;
}

.step-image {
  width: 100%;
  height: 400rpx;
  object-fit: cover;
}

/* 内容区块样式 */
.section {
  background-color: #ffffff;
  border-radius: var(--border-radius);
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: var(--shadow-sm);
  border-left: 8rpx solid transparent;
}

.white-theme .section {
  border-left-color: var(--primary-color);
}

.red-theme .section {
  border-left-color: var(--danger-color);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  color: var(--text-main);
}

.white-theme .section-title {
  color: var(--primary-color);
}

.red-theme .section-title {
  color: var(--danger-color);
}

/* 步骤内容样式 */
.step-content {
  font-size: 30rpx;
  color: var(--text-main);
  line-height: 1.8;
  text-align: justify;
}

/* 提示列表样式 */
.tips-list {
  margin-top: 24rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  background: #f9f9f9;
  padding: 20rpx;
  border-radius: 12rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-icon {
  margin-right: 16rpx;
  font-size: 36rpx;
  line-height: 1.4;
}

.white-theme .tip-icon {
  color: var(--primary-color);
}

.red-theme .tip-icon {
  color: var(--danger-color);
}

.tip-text {
  font-size: 28rpx;
  line-height: 1.5;
  flex: 1;
  color: var(--text-main);
}

/* 相关商品样式 */
.no-products {
  text-align: center;
  color: var(--text-sub);
  padding: 40rpx 0;
  font-size: 28rpx;
}

.products-list {
  margin-top: 20rpx;
}

.product-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.product-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.product-image-container {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 24rpx;
  background: #f8f8f8;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 140rpx;
  padding: 4rpx 0;
}

.product-name {
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 8rpx;
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product-price {
  font-size: 32rpx;
  font-weight: bold;
}

.white-theme .product-price {
  color: var(--primary-color);
}

.red-theme .product-price {
  color: var(--danger-color);
}

.add-to-cart-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1);
}

.white-theme .add-to-cart-btn {
  background-color: var(--primary-color);
  color: #ffffff;
}

.red-theme .add-to-cart-btn {
  background-color: var(--danger-color);
  color: #ffffff;
}

.add-icon {
  font-size: 36rpx;
  font-weight: bold;
  line-height: 1;
}