/* pages/admin/login/login.wxss */
.login-container {
  min-height: 100vh;
  background: var(--admin-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.login-form {
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  width: 100%;
  max-width: 600rpx;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.1);
}

.login-header {
  text-align: center;
  margin-bottom: 60rpx;
}

.login-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 20rpx;
}

.login-subtitle {
  display: block;
  font-size: 28rpx;
  color: var(--text-sub);
}

.form-item {
  margin-bottom: 40rpx;
  position: relative;
}

.form-input {
  width: 100%;
  height: 100rpx;
  padding: 0 30rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  font-size: 30rpx;
  color: var(--text-main);
  background: var(--admin-card-bg);
  transition: all 0.3s ease;
}

.form-input:focus {
  border-color: var(--admin-primary);
  background: #fff;
  box-shadow: 0 0 0 6rpx var(--admin-primary-light);
}

.error-message {
  background: rgba(192, 85, 70, 0.1);
  border: 2rpx solid var(--admin-danger);
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  color: var(--admin-danger);
  font-size: 24rpx;
  text-align: center;
}

.remember-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.remember-text {
  font-size: 26rpx;
  color: var(--text-sub);
}

.login-btn-wrapper {
  margin-top: 40rpx;
  --td-button-primary-bg-color: var(--admin-primary);
  --td-button-primary-border-color: var(--admin-primary);
  --td-button-primary-active-bg-color: #8a6243;
  --td-button-primary-active-border-color: #8a6243;
}
