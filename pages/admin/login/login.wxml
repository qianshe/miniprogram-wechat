<view class="login-container">
  <view class="login-form">
    <view class="login-header">
      <text class="login-title">管理员登录</text>
      <text class="login-subtitle">请输入您的管理员账号和密码</text>
    </view>

    <view class="form-item">
      <t-input
        placeholder="请输入管理员账号"
        value="{{adminAccount}}"
        bind:change="onAccountInput"
        clearable
      />
    </view>

    <view class="form-item">
      <t-input
        placeholder="请输入密码"
        value="{{password}}"
        type="password"
        bind:change="onPasswordInput"
        clearable
      />
    </view>

    <view class="error-message" wx:if="{{errorMessage}}">
      <text>{{errorMessage}}</text>
    </view>

    <view class="remember-row">
      <text class="remember-text">记住账号</text>
      <switch checked="{{rememberAccount}}" bindchange="onRememberChange" color="#a0724e" />
    </view>

    <t-button
      theme="primary"
      block
      size="large"
      loading="{{loading}}"
      bindtap="onLogin"
      class="login-btn-wrapper"
    >{{loading ? '登录中...' : '登录'}}</t-button>
  </view>
</view>
