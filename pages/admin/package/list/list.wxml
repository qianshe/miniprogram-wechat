<view class="admin-packages-container">
  <!-- 页面头部 -->
  <view class="page-header">
    <view class="page-title">套餐管理</view>
    <view class="action-buttons">
      <t-button theme="primary" size="small" icon="add" bindtap="createPackage">新增</t-button>
    </view>
  </view>
  
  <!-- 搜索框 -->
  <view class="search-container">
    <view class="search-input-box full-width">
      <t-search
        placeholder="搜索套餐名称"
        bind:change="onSearchInput"
        bind:submit="onSearchConfirm"
        bind:clear="onSearchClear"
        value="{{keyword}}"
        shape="round"
      />
    </view>
  </view>
  
  <!-- 骨架屏加载状态 -->
  <view class="skeleton-list" wx:if="{{isLoading && page === 1}}">
    <view class="skeleton-item" wx:for="{{[1,2,3,4]}}" wx:key="*this">
      <view class="skeleton-thumb"></view>
      <view class="skeleton-content">
        <view>
          <view class="skeleton-row long"></view>
          <view class="skeleton-row medium"></view>
        </view>
        <view>
          <view class="skeleton-row short"></view>
          <view class="skeleton-row short"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 套餐列表 -->
  <view class="package-list" wx:else>
    <c-empty wx:if="{{packages.length === 0 && !isLoading}}" title="暂无套餐" description="点击右上角添加新套餐"></c-empty>
    
    <block wx:else>
      <view class="package-item" wx:for="{{packages}}" wx:key="id" bindtap="editPackage" data-id="{{item.id}}">
        <view class="package-thumb">
          <image src="{{item.imageUrl}}" mode="aspectFill" lazy-load></image>
          <view class="package-status {{item.status === 1 ? 'status-on' : 'status-off'}}">
            {{item.status === 1 ? '已上线' : '已下线'}}
          </view>
        </view>
        
        <view class="package-info">
          <view class="package-header">
            <view class="package-name">{{item.name}}</view>
          </view>
          
          <view class="package-desc" wx:if="{{item.description}}">
            {{item.description}}
          </view>
          
          <view class="package-meta">
            <view class="package-price">
              <text class="currency">¥</text>{{item.priceDisplay}}
            </view>
          </view>
          
          <view class="package-template-info" wx:if="{{item.template && item.template.length > 0}}">
            <text>包含 {{item.template.length}} 个分类</text>
          </view>
          
          <view class="package-actions" catchtap="return">
            <t-button size="small" theme="default" variant="outline" shape="round" catchtap="editPackage" data-id="{{item.id}}">编辑</t-button>
            <t-button size="small" theme="{{item.status === 1 ? 'danger' : 'primary'}}" variant="outline" shape="round" catchtap="togglePackageStatus" data-id="{{item.id}}" data-status="{{item.status}}">
              {{item.status === 1 ? '下线' : '上线'}}
            </t-button>
            <t-button size="small" theme="danger" variant="text" catchtap="deletePackage" data-id="{{item.id}}">删除</t-button>
          </view>
        </view>
      </view>
      
      <!-- 加载更多 -->
      <view class="load-more" wx:if="{{isLoading && page > 1}}">
        <view class="loading-spinner"></view>
        <text>正在加载更多...</text>
      </view>
      <view class="no-more" wx:if="{{!hasMore && packages.length > 0}}">
        - 到底了 -
      </view>
    </block>
  </view>
</view>
