<view class="container">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">{{isEdit ? '编辑套餐' : '新建套餐'}}</text>
  </view>

  <!-- 基本信息表单 -->
  <view class="form-section">
    <view class="section-title">基本信息</view>
    
    <!-- 套餐名称 -->
    <view class="form-item">
      <view class="form-label">套餐名称 <text class="required">*</text></view>
      <t-input
        value="{{formData.name}}"
        placeholder="请输入套餐名称"
        bind:change="onInputChange"
        data-field="name"
        t-class="input-override"
        t-class-input="input-control"
      />
    </view>

    <!-- 套餐描述 -->
    <view class="form-item">
      <view class="form-label">套餐描述</view>
      <t-textarea
        value="{{formData.description}}"
        placeholder="请输入套餐描述"
        bind:change="onInputChange"
        data-field="description"
        maxlength="500"
        autosize
        t-class="textarea-override"
        t-class-textarea="textarea-control"
      />
    </view>

    <!-- 原价（只读，自动计算） -->
    <view class="form-item form-item-inline">
      <view class="form-label">原价(元)</view>
      <view class="price-display">{{calculatedTotalPrice / 100}}</view>
    </view>

    <!-- 优惠价 -->
    <view class="form-item">
      <view class="form-label">优惠价(元)</view>
      <t-input
        value="{{discountPriceDisplay}}"
        placeholder="请输入优惠价(可选)"
        type="digit"
        bind:change="onPriceChange"
        data-field="discountPrice"
        t-class="input-override"
        t-class-input="input-control"
      />
    </view>

    <!-- 封面图片 -->
    <view class="form-item">
      <view class="form-label">封面图片</view>
      <view class="image-upload-area">
        <view class="image-preview" wx:if="{{formData.imageUrl}}">
          <image src="{{formData.imageUrl}}" mode="aspectFill" class="preview-image" />
          <view class="image-delete" bindtap="deleteImage">
            <t-icon name="close" size="32rpx" color="#fff" />
          </view>
        </view>
        <view class="upload-btn" wx:else bindtap="chooseImage">
          <t-icon name="add" size="48rpx" color="#999" />
          <text class="upload-text">上传图片</text>
        </view>
      </view>
    </view>

    <!-- 排序 -->
    <view class="form-item">
      <view class="form-label">排序</view>
      <t-input
        value="{{formData.sort}}"
        placeholder="数字越小越靠前"
        type="number"
        bind:change="onInputChange"
        data-field="sort"
        t-class="input-override"
        t-class-input="input-control"
      />
    </view>

    <!-- 状态 -->
    <view class="form-item form-item-inline">
      <view class="form-label">上架状态</view>
      <t-switch
        value="{{formData.status === 1}}"
        bind:change="onStatusChange"
      />
    </view>
  </view>

  <!-- 套餐模板配置 -->
  <view class="form-section">
    <view class="section-header">
      <text class="section-title">套餐模板配置</text>
      <view class="add-slot-btn {{!canAddSlot ? 'disabled' : ''}}" bindtap="addTemplateSlot">
        <t-icon name="add" size="32rpx" color="#b8865c" />
        <text class="add-slot-text">添加分类</text>
      </view>
    </view>
    
    <view class="template-list" wx:if="{{formData.template.length > 0}}">
      <view 
        class="template-item" 
        wx:for="{{formData.template}}" 
        wx:key="index"
        wx:for-item="slot"
        wx:for-index="slotIndex"
      >
        <view class="template-header">
          <text class="template-index">分类 {{slotIndex + 1}}</text>
          <view class="template-delete" bindtap="removeTemplateSlot" data-index="{{slotIndex}}">
            <text class="delete-icon">×</text>
          </view>
        </view>
        
        <!-- 选择分类 -->
        <view class="template-field">
          <view class="field-label">选择分类</view>
          <view class="category-picker" bindtap="showCategoryPicker" data-index="{{slotIndex}}">
            <text class="picker-text {{slot.categoryId ? '' : 'placeholder'}}">{{slot.categoryName || '请选择分类'}}</text>
            <t-icon name="chevron-right" size="32rpx" color="#999" />
          </view>
        </view>

        <!-- 商品列表 -->
        <view class="products-section" wx:if="{{slot.categoryId}}">
          <view class="products-header">
            <view class="field-label">已选商品 ({{(slot.products && slot.products.length) || 0}})</view>
            <view class="add-product-btn" bindtap="addProductToSlot" data-slot-index="{{slotIndex}}">
              <t-icon name="add" size="28rpx" color="#b8865c" />
              <text class="add-product-text">添加商品</text>
            </view>
          </view>
          
          <!-- 商品卡片列表 -->
          <view class="product-cards" wx:if="{{slot.products && slot.products.length > 0}}">
            <view 
              class="product-card" 
              wx:for="{{slot.products}}" 
              wx:key="productId"
              wx:for-item="product"
              wx:for-index="productIndex"
            >
              <image 
                class="product-card-image" 
                src="{{product.imageUrl || '/assets/images/placeholder.png'}}" 
                mode="aspectFill" 
              />
              <view class="product-card-info">
                <text class="product-card-name">{{product.productName}}</text>
                <text class="product-card-price">{{product.price / 100}}元/件</text>
              </view>
              <view class="product-card-actions">
                <!-- 数量调整 - 购物车风格 -->
                <view class="quantity-stepper">
                  <view 
                    class="step-btn {{product.quantity <= 1 ? 'disabled' : ''}}" 
                    bindtap="updateProductQuantity" 
                    data-slot-index="{{slotIndex}}" 
                    data-product-index="{{productIndex}}" 
                    data-delta="{{-1}}"
                  ><text>-</text></view>
                  <text class="step-value">{{product.quantity}}</text>
                  <view 
                    class="step-btn" 
                    bindtap="updateProductQuantity" 
                    data-slot-index="{{slotIndex}}" 
                    data-product-index="{{productIndex}}" 
                    data-delta="{{1}}"
                  ><text>+</text></view>
                </view>
                <!-- 删除按钮 - 购物车风格 -->
                <view 
                  class="delete-btn" 
                  bindtap="removeProductFromSlot" 
                  data-slot-index="{{slotIndex}}" 
                  data-product-index="{{productIndex}}"
                ><text>删除</text></view>
              </view>
            </view>
          </view>
          
          <!-- 空商品提示 -->
          <view class="empty-products" wx:else>
            <text class="empty-products-text">暂未添加商品，请点击上方按钮添加</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-template" wx:else>
      <text class="empty-text">暂未配置套餐模板，请点击上方按钮添加分类</text>
    </view>

    <!-- 套餐总价显示 -->
    <view class="total-price-section" wx:if="{{formData.template.length > 0}}">
      <view class="total-price-label">商品总价（参考）</view>
      <view class="total-price-value">{{calculatedTotalPrice / 100}}元</view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <t-button 
      theme="light" 
      size="large" 
      class="cancel-btn"
      t-class="cancel-btn"
      bindtap="onCancel"
      style="--td-button-border-width: 0;"
    >取消</t-button>
    <t-button 
      theme="primary" 
      size="large" 
      class="save-btn"
      t-class="save-btn"
      loading="{{saving}}"
      bindtap="onSave"
      style="--td-button-border-width: 0; --td-button-primary-border-color: transparent;"
    >保存</t-button>
  </view>

  <!-- 分类选择弹窗 -->
  <view class="picker-modal {{showCategoryModal ? 'show' : ''}}" bindtap="hideCategoryPicker">
    <view class="picker-content" catchtap="stopPropagation">
      <view class="picker-header">
        <text class="picker-title">选择分类</text>
        <view class="picker-close" bindtap="hideCategoryPicker">
          <t-icon name="close" size="40rpx" color="#666" />
        </view>
      </view>
      <scroll-view class="picker-list" scroll-y>
        <view 
          class="picker-item {{item.disabled ? 'disabled' : ''}} {{item._id === selectedCategoryId ? 'selected' : ''}}"
          wx:for="{{pickerCategories}}"
          wx:key="_id"
          bindtap="selectCategory"
          data-item="{{item}}"
        >
          <text class="picker-item-text">{{item.name}}</text>
          <t-icon wx:if="{{item._id === selectedCategoryId}}" name="check" size="36rpx" color="#b8865c" />
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 商品选择弹窗 -->
  <view class="picker-modal {{showProductModal ? 'show' : ''}}" bindtap="hideProductPicker">
    <view class="picker-content" catchtap="stopPropagation">
      <view class="picker-header">
        <text class="picker-title">选择商品</text>
        <view class="picker-close" bindtap="hideProductPicker">
          <t-icon name="close" size="40rpx" color="#666" />
        </view>
      </view>
      <scroll-view class="picker-list" scroll-y>
        <view class="picker-empty" wx:if="{{categoryProducts.length === 0}}">
          <text class="picker-empty-text">该分类下暂无商品</text>
        </view>
        <block wx:else>
          <view
            class="picker-item product-picker-item {{item._id === selectedProductId ? 'selected' : ''}}"
            wx:for="{{categoryProducts}}"
            wx:key="_id"
            bindtap="selectProduct"
            data-item="{{item}}"
          >
            <image class="product-thumb" src="{{item.thumb}}" mode="aspectFill" />
            <view class="product-info">
              <text class="product-name">{{item.name}}</text>
              <text class="product-price">{{item.price / 100}}元</text>
            </view>
            <t-icon wx:if="{{item._id === selectedProductId}}" name="check" size="36rpx" color="#b8865c" />
          </view>
        </block>
      </scroll-view>
    </view>
  </view>
</view>
