/* 套餐编辑页面样式 */
.container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 180rpx;
}

/* 页面标题 */
.page-header {
  padding: 40rpx 32rpx 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* 表单区块 */
.form-section {
  background-color: #ffffff;
  margin: 0 24rpx 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

/* 表单项 */
.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-item-inline {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 16rpx;
  font-weight: 600;
  margin-left: 8rpx;
}

.form-item-inline .form-label {
  margin-bottom: 0;
}

/* 原价只读显示 */
.price-display {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--admin-primary);
}

.required {
  color: var(--admin-danger);
  margin-left: 4rpx;
}

/* 类型选择器 */
.type-selector {
  display: flex;
  gap: 24rpx;
}

.type-option {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f6f0e7;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.type-option.active {
  background-color: var(--package-accent-light, #f5efe3);
  border-color: var(--primary-color);
}

.type-text {
  font-size: 28rpx;
  color: #666666;
}

.type-option.active .type-text {
  color: var(--admin-primary);
  font-weight: 500;
}

/* 图片上传 */
.image-upload-area {
  width: 200rpx;
  height: 200rpx;
}

.image-preview {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-btn {
  width: 100%;
  height: 100%;
  background-color: #f6f0e7;
  border-radius: 16rpx;
  border: 2rpx dashed #ccc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.upload-text {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 添加分类按钮 */
.add-slot-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background-color: var(--package-accent-light, #f5efe3);
  border-radius: 30rpx;
}

.add-slot-text {
  font-size: 26rpx;
  color: var(--admin-primary);
  font-weight: 500;
}

/* 模板列表 */
.template-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.template-item {
  background-color: #f6f0e7;
  border-radius: 16rpx;
  padding: 24rpx;
}

.template-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.template-index {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.template-delete {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--package-accent-light, #f5efe3);
  border-radius: 50%;
}

.template-delete:active {
  background: var(--package-border, #efe7dc);
}

.delete-icon {
  font-size: 28rpx;
  color: var(--text-sub, #6b6b6b);
  font-weight: 600;
}

/* 添加分类按钮禁用状态 */
.add-slot-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* 分类选择项禁用状态 */
.picker-item.disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* 模板字段 */
.template-field {
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 16rpx;
  font-weight: 600;
  margin-left: 8rpx;
}

/* 选择器 */
.category-picker,
.product-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #f7f8fa;
  border: 2rpx solid #e5e7eb;
  padding: 0 32rpx; /* Remove vertical padding, rely on height + flex */
  border-radius: 16rpx;
  height: 96rpx;     /* Fixed height */
  width: 100%;
  box-sizing: border-box;
}

.picker-text {
  font-size: 28rpx;
  color: var(--text-main);
  flex: 1;
  margin-right: 16rpx;
  /* 确保文字过长能截断，防止撑破布局 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-text.placeholder {
  color: var(--text-sub);
}

/* 商品区域 */
.products-section {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.products-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.add-product-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  background-color: rgba(184, 134, 92, 0.15);
  border-radius: 6rpx;
}

.add-product-text {
  font-size: 24rpx;
  color: var(--admin-primary);
  font-weight: 500;
}

/* 商品卡片列表 */
.product-cards {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.product-card {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 16rpx;
  gap: 16rpx;
}

.product-card-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  background-color: #f0f0f0;
}

.product-card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.product-card-name {
  font-size: 26rpx;
  color: var(--text-main);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-card-price {
  font-size: 24rpx;
  color: var(--admin-primary);
}

.product-card-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

/* 商品数量控制器 - detail页面风格 */
.quantity-stepper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.step-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--package-accent-light, #f5efe3);
  border-radius: 50%;
  transition: all 0.2s ease;
}

.step-btn.disabled {
  opacity: 0.4;
}

.step-btn:active:not(.disabled) {
  background: var(--package-accent, #c9a86c);
}

.step-btn:active:not(.disabled) text {
  color: #ffffff;
}

.step-btn text {
  font-size: 28rpx;
  color: var(--primary-color, var(--admin-primary));
  font-weight: 600;
}

.step-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  min-width: 40rpx;
  text-align: center;
}

/* 商品删除按钮 - detail页面风格 */
.delete-btn {
  padding: 12rpx 24rpx;
  background: var(--package-accent-light, #f5efe3);
  border-radius: 24rpx;
}

.delete-btn:active {
  background: var(--package-border, #efe7dc);
}

.delete-btn text {
  font-size: 24rpx;
  color: var(--primary-color, var(--admin-primary));
  font-weight: 500;
}

/* 空商品提示 */
.empty-products {
  padding: 32rpx 16rpx;
  text-align: center;
}

.empty-products-text {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 套餐总价区域 */
.total-price-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background-color: rgba(184, 134, 92, 0.08);
  border-radius: 12rpx;
}

.total-price-label {
  font-size: 28rpx;
  color: #666666;
}

.total-price-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--admin-primary);
}

/* 空模板提示 */
.empty-template {
  padding: 48rpx 24rpx;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-sub);
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 900;
}

.cancel-btn {
  flex: 1;
  height: 88rpx !important;
  border-radius: 44rpx !important;
  font-size: 30rpx !important;
}

.save-btn {
  flex: 2;
  height: 88rpx !important;
  border-radius: 44rpx !important;
  background: linear-gradient(135deg, var(--package-accent, #c9a86c) 0%, var(--primary-color) 100%) !important;
  font-size: 30rpx !important;
  box-shadow: 0 8rpx 24rpx rgba(184, 134, 92, 0.3) !important;
  border: none !important;
}

.save-btn::after {
  border: none !important;
}

/* 选择弹窗 */
.picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.picker-modal.show {
  opacity: 1;
  visibility: visible;
}

.picker-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.picker-modal.show .picker-content {
  transform: translateY(0);
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.picker-close {
  padding: 8rpx;
}

.picker-list {
  flex: 1;
  padding: 16rpx 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.picker-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
}

.picker-item.selected {
  background-color: rgba(184, 134, 92, 0.08);
}

.picker-item-text {
  font-size: 30rpx;
  color: var(--text-main);
}

.picker-item.selected .picker-item-text {
  color: var(--admin-primary);
  font-weight: 500;
}

/* 商品选择项 */
.product-picker-item {
  padding: 20rpx 32rpx;
}

.product-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background-color: #f0f0f0;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.product-name {
  font-size: 28rpx;
  color: var(--text-main);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  font-size: 24rpx;
  color: var(--admin-primary);
}

/* 空状态 */
.picker-empty {
  padding: 80rpx 32rpx;
  text-align: center;
}

.picker-empty-text {
  font-size: 28rpx;
  color: var(--text-sub);
}

/* TDesign组件样式覆盖 */
.input-override {
  background-color: #f7f8fa !important;
  border: 2rpx solid #e5e7eb !important;
  border-radius: 16rpx !important;
  padding: 24rpx 32rpx !important;
  color: var(--text-main) !important;
  overflow: hidden !important;
}

.textarea-override {
  background-color: #f7f8fa !important;
  border: 2rpx solid #e5e7eb !important;
  border-radius: 16rpx !important;
  padding: 24rpx 32rpx !important;
  color: var(--text-main) !important;
  overflow: hidden !important;
}

.input-control {
  color: var(--text-main) !important;
}

.textarea-control {
  background-color: transparent !important;
}
