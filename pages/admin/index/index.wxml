<view class="admin-container">
  <!-- 顶部个人信息 -->
  <view class="admin-header">
    <view class="admin-info">
      <image class="admin-avatar" src="{{adminInfo.avatar}}" mode="aspectFill"></image>
      <view class="admin-detail">
        <view class="admin-name">{{adminInfo.name}}</view>
        <view class="admin-role">{{adminInfo.role}}</view>
      </view>
    </view>
    <t-button size="small" theme="default" bindtap="logout">退出登录</t-button>
  </view>
  
  <!-- 功能模块导航 -->
  <t-cell-group title="功能模块">
    <t-cell
      wx:for="{{modules}}"
      wx:key="id"
      title="{{item.name}}"
      description="{{item.desc}}"
      arrow
      bindtap="onModuleTap"
      data-path="{{item.path}}"
    >
      <view slot="left-icon" class="module-icon">{{item.icon}}</view>
    </t-cell>
  </t-cell-group>
  
  <!-- 今日数据统计 -->
  <t-cell-group title="今日数据概览">
    <t-cell title="订单数" bindtap="onStatsTap" data-type="orders" arrow>
      <view slot="note" class="stat-value">{{todayStats.orders}}</view>
    </t-cell>
    <t-cell title="商品数" bindtap="onStatsTap" data-type="products" arrow>
      <view slot="note" class="stat-value">{{todayStats.products}}</view>
    </t-cell>
    <t-cell title="销售额">
      <view slot="note" class="stat-value">¥{{todayStats.sales}}</view>
    </t-cell>
    <t-cell title="总收入">
      <view slot="note" class="stat-value">¥{{todayStats.revenue}}</view>
    </t-cell>
  </t-cell-group>
  
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>
</view> 