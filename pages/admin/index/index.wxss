.admin-container {
  padding: 30rpx;
  background-color: var(--bg-color);
  min-height: 100vh;
}

/* 通用的区块标题 */
.section-header {
  margin: 30rpx 0 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
  padding-left: 20rpx;
  border-left: 8rpx solid var(--primary-color);
  line-height: 1;
}

/* 功能模块卡片网格 */
.module-card-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 单个功能模块卡片 */
.module-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.module-card-hover {
  background: #f8f9fa;
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.module-card-icon {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #e4e8eb 100%);
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.module-card-content {
  flex: 1;
  min-width: 0;
}

.module-card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.module-card-desc {
  font-size: 24rpx;
  color: var(--text-sub);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.module-card-arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 数据统计卡片网格 */
.stat-card-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

/* 单个数据统计卡片 */
.stat-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.stat-card-hover {
  background: #f8f9fa;
  transform: scale(0.98);
}

.stat-card-value {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 12rpx;
  line-height: 1.2;
}

.stat-card-value-highlight {
  color: var(--primary-color);
}

.stat-card-value-highlight::before {
  content: '\A5';
  font-size: 32rpx;
  margin-right: 4rpx;
}

.stat-card-label {
  font-size: 26rpx;
  color: var(--text-sub);
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-sub);
}