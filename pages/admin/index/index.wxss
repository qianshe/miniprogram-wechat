.admin-container {
  padding: 30rpx;
  background-color: var(--bg-color);
  min-height: 100vh;
}

/* 顶部管理员信息 */
.admin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  margin-bottom: 30rpx;
  background: #fff;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
}

.admin-info {
  display: flex;
  align-items: center;
}

.admin-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 4rpx solid #f0f0f0;
}

.admin-name {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.admin-role {
  font-size: 24rpx;
  color: var(--text-sub);
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.logout-btn {
  font-size: 26rpx;
  color: var(--text-sub);
  padding: 12rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 30rpx;
  transition: all 0.3s;
}

.logout-btn:active {
  background-color: #e0e0e0;
}

/* 功能模块导航 */
.module-grid {
  display: flex;
  flex-wrap: wrap;
  background-color: #fff;
  border-radius: var(--border-radius);
  margin-bottom: 30rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  padding: 10rpx 0;
}

.module-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  box-sizing: border-box;
  position: relative;
  transition: all 0.3s;
}

.module-item:active {
  background-color: #f9f9f9;
}

.module-item::after {
  content: '';
  position: absolute;
  bottom: 0;
  right: 0;
  width: 100%;
  height: 1rpx;
  background-color: #f5f5f5;
}

.module-item::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 1rpx;
  height: 100%;
  background-color: #f5f5f5;
}

.module-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
  color: var(--primary-color);
}

.module-info {
  text-align: center;
}

.module-name {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
  margin-bottom: 6rpx;
}

.module-desc {
  font-size: 22rpx;
  color: var(--text-sub);
}

/* 通用的区块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
  margin: 40rpx 0 24rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid var(--primary-color);
  line-height: 1;
}

/* 数据统计格子 */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  background-color: #fff;
  border-radius: var(--border-radius);
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.stat-item {
  width: 50%;
  padding: 40rpx 0;
  text-align: center;
  position: relative;
}

.stat-item::after {
  content: '';
  position: absolute;
  bottom: 0;
  right: 0;
  width: 100%;
  height: 1rpx;
  background-color: #f5f5f5;
}

.stat-item::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 1rpx;
  height: 100%;
  background-color: #f5f5f5;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 待处理事项列表 */
.todo-list {
  background-color: #fff;
  border-radius: var(--border-radius);
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.todo-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: all 0.3s;
}

.todo-item:active {
  background-color: #f9f9f9;
}

.todo-item:last-child {
  border-bottom: none;
}

.todo-info {
  display: flex;
  align-items: center;
}

.todo-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 24rpx;
  opacity: 0.8;
}

.todo-name {
  font-size: 28rpx;
  color: var(--text-main);
}

.todo-count {
  background-color: var(--danger-color);
  color: #fff;
  font-size: 24rpx;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 18rpx;
  text-align: center;
  padding: 0 12rpx;
  font-weight: bold;
}

/* 热销产品排行榜 */
.product-rank-list {
  background-color: #fff;
  border-radius: var(--border-radius);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.product-rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.product-rank-item:last-child {
  border-bottom: none;
}

.rank-number {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background-color: #f5f5f5;
  color: #999;
  font-size: 24rpx;
  border-radius: 8rpx;
  margin-right: 24rpx;
  font-weight: bold;
}

.product-rank-item:nth-child(1) .rank-number {
  background-color: #ffebee;
  color: #d32f2f;
}

.product-rank-item:nth-child(2) .rank-number {
  background-color: #fff3e0;
  color: #f57c00;
}

.product-rank-item:nth-child(3) .rank-number {
  background-color: #fff8e1;
  color: #fbc02d;
}

.product-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  background-color: #f8f8f8;
}

.product-info {
  flex: 1;
  overflow: hidden;
}

.product-name {
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.product-sales {
  font-size: 24rpx;
  color: var(--text-sub);
}

.product-amount {
  font-size: 30rpx;
  color: var(--danger-color);
  font-weight: bold;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx;
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-sub);
}