<view class="page-container">
  <view class="page-header">
    <view class="page-title">创建订单</view>
  </view>
  
  <!-- 订单表单 -->
  <t-cell-group title="客户信息">
    <t-cell title="联系人姓名" required>
      <t-input
        slot="note"
        placeholder="请输入联系人姓名"
        value="{{formData.contactName}}"
        bind:change="onInputChange"
        data-field="contactName"
        status="{{errors.contactName ? 'error' : ''}}"
        tips="{{errors.contactName}}"
      />
    </t-cell>

    <t-cell title="联系电话" required>
      <t-input
        slot="note"
        type="number"
        placeholder="请输入联系电话"
        value="{{formData.contactPhone}}"
        bind:change="onInputChange"
        data-field="contactPhone"
        status="{{errors.contactPhone ? 'error' : ''}}"
        tips="{{errors.contactPhone}}"
      />
    </t-cell>

    <t-cell title="服务时间" required>
      <picker
        slot="note"
        mode="date"
        value="{{formData.serviceTime}}"
        bindchange="onServiceTimeChange"
        start="{{formData.serviceTime}}"
      >
        <view class="form-picker">
          {{formData.serviceTime || '请选择服务时间'}}
          <t-icon name="chevron-right" size="16" />
        </view>
      </picker>
      <view class="error-tips" wx:if="{{errors.serviceTime}}">{{errors.serviceTime}}</view>
    </t-cell>

    <t-cell title="服务地址" required>
      <t-input
        slot="note"
        type="textarea"
        placeholder="请输入详细地址"
        value="{{formData.address}}"
        bind:change="onInputChange"
        data-field="address"
        status="{{errors.address ? 'error' : ''}}"
        tips="{{errors.address}}"
      />
    </t-cell>

    <t-cell title="备注">
      <t-input
        slot="note"
        type="textarea"
        placeholder="可选填"
        value="{{formData.remark}}"
        bind:change="onInputChange"
        data-field="remark"
      />
    </t-cell>
  </t-cell-group>
  
  <!-- 产品列表 -->
  <t-cell-group title="产品信息">
    <t-cell title="选择产品" arrow bindtap="openProductSelector">
      <t-button slot="note" size="small" theme="primary">添加产品</t-button>
    </t-cell>
  </t-cell-group>

  <view class="form-section" wx:if="{{selectedProducts.length > 0 || errors.products}}">
    
    <view class="error-message" wx:if="{{errors.products}}">{{errors.products}}</view>
    
    <block wx:if="{{selectedProducts.length > 0}}">
      <view class="product-list">
        <view class="product-item" wx:for="{{selectedProducts}}" wx:key="id">
          <view class="product-info">
            <image class="product-thumb" src="{{item.thumb}}" mode="aspectFill"></image>
            <view class="product-details">
              <view class="product-name">{{item.name}}</view>
              <view class="product-price">¥{{item.price / 100}}</view>
            </view>
          </view>
          <view class="product-quantity">
            <view class="quantity-adjust decrease" bindtap="decreaseQuantity" data-index="{{index}}">-</view>
            <view class="quantity-value">{{item.quantity}}</view>
            <view class="quantity-adjust increase" bindtap="increaseQuantity" data-index="{{index}}">+</view>
          </view>
          <view class="remove-btn" bindtap="removeProduct" data-index="{{index}}">×</view>
        </view>
      </view>
      
      <view class="total-amount">
        <text class="total-label">总计：</text>
        <text class="total-value">¥{{totalAmount / 100}}</text>
      </view>
    </block>
    
    <view class="empty-product" wx:else>
      <view class="empty-icon">+</view>
      <view class="empty-text">请添加产品</view>
    </view>
  </view>
  
  <!-- 操作按钮 -->
  <view class="action-buttons">
    <t-button theme="default" bindtap="goBack">取消</t-button>
    <t-button
      theme="primary"
      loading="{{isSubmitting}}"
      bindtap="submitOrder"
      disabled="{{isSubmitting}}"
    >
      {{isSubmitting ? '提交中...' : '提交订单'}}
    </t-button>
  </view>
  
  <!-- 产品选择弹窗 -->
  <t-popup
    visible="{{showProductSelector}}"
    placement="bottom"
    bind:visible-change="onProductSelectorChange"
  >
    <view class="selector-content">
      <view class="selector-header">
        <view class="selector-title">选择产品</view>
        <t-icon name="close" size="20" bindtap="closeProductSelector" />
      </view>

      <view class="selector-search">
        <t-input
          placeholder="搜索产品名称"
          bind:change="onSearchInput"
          value="{{searchKeyword}}"
          prefix-icon="search"
        />
      </view>
      
      <view class="selector-list">
        <block wx:if="{{getFilteredProducts().length > 0}}">
          <view 
            class="selector-item" 
            wx:for="{{getFilteredProducts()}}" 
            wx:key="id" 
            bindtap="selectProduct" 
            data-id="{{item.id}}"
          >
            <image class="selector-thumb" src="{{item.thumb}}" mode="aspectFill"></image>
            <view class="selector-details">
              <view class="selector-name">{{item.name}}</view>
              <view class="selector-price">¥{{item.price / 100}}</view>
            </view>
          </view>
        </block>
        <view class="empty-results" wx:else>无匹配产品</view>
      </view>
    </view>
  </t-popup>
</view>