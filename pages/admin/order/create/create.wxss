.page-container {
  padding: 30rpx;
  background-color: var(--bg-color);
  min-height: 100vh;
}

.page-header {
  margin-bottom: 30rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-main);
}

/* 表单部分 */
.form-section {
  background-color: #fff;
  border-radius: var(--border-radius);
  padding: 32rpx;
  margin-bottom: 30rpx;
  box-shadow: var(--shadow-sm);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 30rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--primary-color);
  line-height: 1;
}

.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: var(--danger-color);
  margin-left: 8rpx;
}

.form-input, .form-picker, .form-textarea {
  width: 100%;
  height: 88rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.form-input:focus, .form-textarea:focus {
  background-color: #fff;
  border-color: var(--primary-color);
}

.form-textarea {
  height: 200rpx;
  padding: 24rpx;
  line-height: 1.5;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 40rpx;
  position: relative;
  line-height: 88rpx;
}

.picker-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 10rpx solid #999;
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
}

.input-error {
  border-color: var(--danger-color);
  background-color: #fff5f5;
}

.error-message {
  font-size: 24rpx;
  color: var(--danger-color);
  margin-top: 12rpx;
  margin-left: 8rpx;
}

/* 产品部分 */
.add-product-btn {
  font-size: 26rpx;
  color: var(--primary-color);
  padding: 12rpx 24rpx;
  border: 1rpx solid var(--primary-color);
  border-radius: 30rpx;
  background: rgba(7, 193, 96, 0.05);
}

.empty-product {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  border: 2rpx dashed #e0e0e0;
}

.empty-icon {
  font-size: 64rpx;
  color: #ccc;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-sub);
}

.product-list {
  margin-bottom: 30rpx;
}

.product-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  position: relative;
  background: #fff;
  transition: all 0.3s;
}

.product-item:last-child {
  border-bottom: none;
}

.product-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.product-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  background: #f8f8f8;
}

.product-details {
  flex: 1;
}

.product-name {
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 8rpx;
  font-weight: 500;
}

.product-price {
  font-size: 30rpx;
  color: var(--danger-color);
  font-weight: bold;
}

.product-quantity {
  display: flex;
  align-items: center;
  margin-right: 32rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  padding: 4rpx;
}

.quantity-adjust {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
  background: #fff;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
}

.quantity-value {
  margin: 0 24rpx;
  min-width: 40rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
}

.remove-btn {
  font-size: 40rpx;
  color: #ccc;
  padding: 10rpx;
  transition: color 0.3s;
}

.remove-btn:active {
  color: var(--danger-color);
}

.total-amount {
  text-align: right;
  padding: 24rpx 0;
  font-size: 28rpx;
  border-top: 1rpx solid #f0f0f0;
}

.total-label {
  color: var(--text-sub);
  margin-right: 12rpx;
}

.total-value {
  font-size: 36rpx;
  color: var(--danger-color);
  font-weight: bold;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 60rpx;
  margin-bottom: 60rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.cancel-btn, .submit-btn {
  width: 46%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.3s;
}

.cancel-btn {
  background-color: #fff;
  color: var(--text-sub);
  box-shadow: var(--shadow-sm);
}

.submit-btn {
  background-color: var(--primary-color);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(7, 193, 96, 0.2);
}

.submit-btn.disabled {
  background-color: #a0eac4;
  box-shadow: none;
}

/* 产品选择器弹窗 */
.product-selector {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: opacity 0.3s;
}

.product-selector.show {
  visibility: visible;
  opacity: 1;
}

.selector-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(4px);
}

.selector-content {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 75%;
  background-color: #fff;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.product-selector.show .selector-content {
  transform: translateY(0);
}

.selector-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.selector-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
}

.close-btn {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.selector-search {
  padding: 24rpx 32rpx;
  position: relative;
  background: #fff;
}

.search-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 80rpx 0 32rpx;
  font-size: 28rpx;
}

.search-icon {
  position: absolute;
  right: 60rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: #999;
}

.selector-list {
  flex: 1;
  overflow-y: auto;
  padding: 0 32rpx;
}

.selector-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.selector-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  background: #f8f8f8;
}

.selector-details {
  flex: 1;
}

.selector-name {
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.selector-price {
  font-size: 30rpx;
  color: var(--danger-color);
  font-weight: bold;
}

.empty-results {
  text-align: center;
  padding: 80rpx 0;
  color: var(--text-sub);
  font-size: 28rpx;
}