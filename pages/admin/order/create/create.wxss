.page-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 200rpx;
  box-sizing: border-box;
}

/* 顶部区域 */
.header-section {
  padding: 40rpx 32rpx;
  background-color: var(--bg-color);
}

.header-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 12rpx;
  letter-spacing: -1rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: var(--text-sub);
}

/* 表单容器 */
.form-container {
  padding: 0 32rpx;
}

.form-card {
  background-color: #fff;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-sm);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 32rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid var(--primary-color);
  line-height: 1;
}

.package-card {
  position: relative;
}

.package-subtitle {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-bottom: 24rpx;
}

.package-source {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 20rpx;
  background-color: #f7f8fa;
  border-radius: 16rpx;
  border: 2rpx solid #f7f8fa;
  margin-bottom: 16rpx;
}

.package-status {
  font-size: 24rpx;
  color: #8c8c8c;
  padding: 8rpx 16rpx;
  background-color: #f7f8fa;
  border-radius: 20rpx;
}

.package-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.package-item {
  background-color: #f7f8fa;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 2rpx solid transparent;
  position: relative;
}

.package-item.active {
  background-color: #fff;
  border-color: var(--primary-color);
}

.package-main {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.package-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
}

.package-price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.package-desc {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-top: 8rpx;
}

.package-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 22rpx;
  color: var(--primary-color);
  background-color: rgba(var(--primary-color-rgb), 0.12);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.package-selected {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #8c8c8c;
}

.package-loading,
.package-empty {
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #8c8c8c;
  text-align: center;
}

.label-optional {
  font-size: 24rpx;
  color: #8c8c8c;
}

.label-required {
  font-size: 24rpx;
  color: #e53935;
}

/* 输入框组 */
.input-group {
  margin-bottom: 32rpx;
}

.input-group:last-child {
  margin-bottom: 0;
}

.input-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
  margin-left: 8rpx;
}

/* 自定义填充式输入框 */
.filled-input {
  background-color: #f7f8fa !important;
  border-radius: 16rpx !important;
  padding: 24rpx 32rpx !important;
  font-size: 28rpx;
  color: var(--text-main);
  transition: all 0.3s;
}

.filled-input:active {
  background-color: #f0f1f3 !important;
}

.placeholder-style {
  color: #bbb;
}

/* 选择器触发器 */
.picker-trigger {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 48rpx;
}

.text-value {
  color: var(--text-main);
}

.text-placeholder {
  color: #bbb;
}

.picker-inline-mark {
  color: #ccc;
  font-size: 28rpx;
  line-height: 1;
  margin-left: 16rpx;
}

/* 添加产品按钮 */
.add-product-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background-color: rgba(var(--primary-color-rgb), 0.1);
  color: var(--primary-color);
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.inline-plus {
  font-size: 32rpx;
  line-height: 1;
  font-weight: 500;
}

/* 产品列表 */
.product-list {
  margin-bottom: 32rpx;
}

.product-item {
  display: flex;
  padding: 24rpx;
  background-color: #f9f9f9;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.product-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  background-color: #fff;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  flex: 1;
  margin-right: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.product-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  margin-top: 16rpx;
}

/* 数量控制器 */
.quantity-control {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
}

.qty-btn:active {
  opacity: 0.6;
}

.qty-num {
  min-width: 40rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
}

.empty-state-symbol {
  font-size: 48rpx;
  line-height: 1;
  color: var(--primary-color);
}

.delete-btn {
  padding: 12rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(229, 57, 53, 0.08);
  border-radius: 24rpx;
}

.delete-text {
  font-size: 24rpx;
  color: #e53935;
  font-weight: 500;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  background-color: #f9f9f9;
  border-radius: 20rpx;
  border: 2rpx dashed #e0e0e0;
}

.empty-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  background-color: rgba(var(--primary-color-rgb), 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.empty-state text {
  font-size: 26rpx;
  color: var(--text-sub);
}

/* 底部栏 */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.footer-total {
  display: flex;
  align-items: baseline;
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 600;
}

.footer-price {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--primary-color);
  margin-left: 12rpx;
}

.footer-actions {
  display: flex;
  gap: 20rpx;
  flex: 1;
  justify-content: flex-end;
}

.action-btn {
  min-width: 180rpx;
  font-weight: 600;
}

.action-btn.submit {
  box-shadow: 0 8rpx 20rpx rgba(var(--primary-color-rgb), 0.3);
}
