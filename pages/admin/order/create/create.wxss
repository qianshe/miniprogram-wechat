.page-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 200rpx;
  box-sizing: border-box;
}

/* 顶部区域 */
.header-section {
  padding: 40rpx 32rpx;
  background-color: var(--bg-color);
}

.header-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 12rpx;
  letter-spacing: -1rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: var(--text-sub);
}

/* 表单容器 */
.form-container {
  padding: 0 32rpx;
}

.form-card {
  background-color: #fff;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-sm);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 32rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid var(--primary-color);
  line-height: 1;
}

/* 输入框组 */
.input-group {
  margin-bottom: 32rpx;
}

.input-group:last-child {
  margin-bottom: 0;
}

.input-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
  margin-left: 8rpx;
}

/* 自定义填充式输入框 */
.filled-input {
  background-color: #f7f8fa !important;
  border-radius: 16rpx !important;
  padding: 24rpx 32rpx !important;
  font-size: 28rpx;
  color: var(--text-main);
  transition: all 0.3s;
}

.filled-input:active {
  background-color: #f0f1f3 !important;
}

.placeholder-style {
  color: #bbb;
}

.textarea-input {
  min-height: 160rpx;
  width: auto !important;
}

/* 选择器触发器 */
.picker-trigger {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 48rpx;
}

.text-value {
  color: var(--text-main);
}

.text-placeholder {
  color: #bbb;
}

/* 添加产品按钮 */
.add-product-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background-color: rgba(var(--primary-color-rgb), 0.1);
  color: var(--primary-color);
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
}

/* 产品列表 */
.product-list {
  margin-bottom: 32rpx;
}

.product-item {
  display: flex;
  padding: 24rpx;
  background-color: #f9f9f9;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.product-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  background-color: #fff;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  flex: 1;
  margin-right: 16rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.product-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.product-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 数量控制器 */
.quantity-control {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
}

.qty-btn:active {
  opacity: 0.6;
}

.qty-num {
  min-width: 40rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
}

.delete-btn {
  padding: 10rpx;
}

/* 总计区域 */
.total-section {
  display: flex;
  justify-content: flex-end;
  align-items: baseline;
  padding-top: 24rpx;
  border-top: 2rpx dashed #eee;
}

.total-label {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-right: 12rpx;
}

.total-price {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-main);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  background-color: #f9f9f9;
  border-radius: 20rpx;
  border: 2rpx dashed #e0e0e0;
}

.empty-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  background-color: rgba(var(--primary-color-rgb), 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.empty-state text {
  font-size: 26rpx;
  color: var(--text-sub);
}

/* 底部栏 */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.footer-total {
  display: flex;
  align-items: baseline;
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 600;
}

.footer-price {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--primary-color);
  margin-left: 12rpx;
}

.footer-actions {
  display: flex;
  gap: 20rpx;
  flex: 1;
  justify-content: flex-end;
}

.action-btn {
  min-width: 180rpx;
  font-weight: 600;
}

.action-btn.submit {
  box-shadow: 0 8rpx 20rpx rgba(var(--primary-color-rgb), 0.3);
}

/* 弹窗样式 */
.selector-content {
  background-color: #fff;
  border-radius: 32rpx 32rpx 0 0;
  height: 80vh;
  display: flex;
  flex-direction: column;
}

.selector-header {
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.selector-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-main);
}

.selector-search {
  padding: 0 32rpx 20rpx;
}

.selector-list {
  flex: 1;
  overflow-y: auto;
  padding: 0 32rpx 32rpx;
}

.selector-item {
  display: flex;
  padding: 24rpx;
  margin-bottom: 24rpx;
  background-color: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
  border: 1rpx solid rgba(0,0,0,0.03);
}

.selector-thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  background-color: #f7f8fa;
}

.selector-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.selector-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.4;
}

.selector-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.selector-price {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--text-main);
}

.add-icon {
  width: 56rpx;
  height: 56rpx;
  background-color: var(--primary-color);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(var(--primary-color-rgb), 0.3);
}

.empty-results {
  padding-top: 100rpx;
}