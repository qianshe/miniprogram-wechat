.admin-orders-container {
  padding: 20rpx 24rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-main);
}

.action-buttons {
  display: flex;
}

.create-btn {
  background-color: var(--primary-color);
  color: #fff;
  font-size: 28rpx;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  line-height: 1.5;
  box-shadow: 0 6rpx 16rpx rgba(7, 193, 96, 0.35);
}

.search-container {
  display: flex;
  margin-bottom: 24rpx;
  background: #fff;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  align-items: center;
  gap: 20rpx;
}

.search-wrapper {
  flex: 1;
  min-width: 0;
}

.search-wrapper .t-search {
  padding: 0;
}

.search-wrapper .t-search__input-container {
  background-color: #f5f5f5;
  border-radius: 40rpx;
}

.search-box {
  flex: 1;
  position: relative;
  margin-right: 20rpx;
}

.search-input {
  width: 100%;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: #fff;
  padding: 0 80rpx 0 30rpx;
  font-size: 28rpx;
  box-shadow: var(--shadow-sm);
}

.search-icon {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
}

.search-icon .iconfont {
  font-size: 0;
  color: #666;
}

.search-icon .iconfont::before {
  content: "🔍";
  font-size: 32rpx;
}

.filter-btn {
  flex-shrink: 0;
  min-width: 120rpx;
  height: 72rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  background-color: #f8f8f8;
  padding: 0 24rpx;
  gap: 8rpx;
  color: var(--text-main);
  font-size: 28rpx;
  border: 1rpx solid #e8e8e8;
  transition: all 0.3s;
}

.filter-btn:active {
  background-color: #f0f0f0;
}

.filter-btn .iconfont {
  font-size: 0;
  color: #666;
}

.filter-btn .iconfont::before {
  content: "";
  font-size: 32rpx;
}

.close-icon .iconfont {
  font-size: 0;
  color: #666;
}

.close-icon .iconfont::before {
  content: "";
  font-size: 32rpx;
}

/* 筛选弹窗样式 - 与用户端保持一致 */
.filter-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 999;
}

.filter-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  padding: 0 0 env(safe-area-inset-bottom);
}

.filter-panel {
  background: #fff;
  padding: 30rpx 30rpx 24rpx;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
  max-height: 72vh;
  overflow: auto;
}

.filter-header {
  padding: 0 0 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2rpx solid #e8e8e8;
}

.filter-header text {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.filter-content {
  padding: 32rpx 0;
  max-height: 60vh;
  overflow-y: auto;
}

.filter-item {
  margin-bottom: 48rpx;
}

.filter-item:last-child {
  margin-bottom: 0;
}

.filter-label {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 24rpx;
  display: block;
}

.date-range, .price-range {
  display: flex;
  align-items: center;
}

.date-picker {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  text-align: center;
  border: 2rpx solid #e0e0e0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  padding: 0 16rpx;
}

.date-separator, .price-separator {
  margin: 0 24rpx;
  color: #666;
  font-size: 28rpx;
  font-weight: 500;
}

.filter-footer {
  margin-top: 32rpx;
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.filter-footer .t-button {
  flex: 1;
}

/* 标签页样式优化 */
.tabs {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  background-color: #fff;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  padding: 8rpx 16rpx;
}

.tabs::-webkit-scrollbar {
  display: none;
}

.tab-item {
  flex: 0 0 auto;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-sub);
  position: relative;
  white-space: nowrap;
  transition: all 0.3s ease;
  border-radius: 24rpx;
  margin: 4rpx;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: 600;
  background: rgba(7, 193, 96, 0.08);
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 36rpx;
  height: 6rpx;
  background-color: var(--primary-color);
  border-radius: 3rpx;
}

/* 订单列表样式优化 */
.order-list {
  padding-bottom: 40rpx;
}

/* 加载状态 */
.loading-wrapper {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

.loading-text {
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.loading, .empty, .load-more, .no-more {
  text-align: center;
  padding: 48rpx 0;
  color: var(--text-sub);
  font-size: 26rpx;
}

.order-item {
  background-color: #fff;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
  position: relative;
}

/* 订单卡片左侧状态条装饰 */
.order-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: var(--primary-color);
  border-radius: 8rpx 0 0 8rpx;
}

.order-item:active {
  transform: scale(0.985);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx 24rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: linear-gradient(135deg, #fafafa 0%, #ffffff 100%);
}

.order-no {
  font-size: 26rpx;
  color: var(--text-sub);
  font-family: 'SF Mono', 'Monaco', 'Menlo', monospace;
  letter-spacing: 0.5rpx;
}

.order-status {
  font-size: 24rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  letter-spacing: 1rpx;
}

/* 状态样式优化 */
.status-0 { 
  color: #ff9800; 
  background: linear-gradient(135deg, #fff8e1 0%, #fff3e0 100%);
  border: 1rpx solid rgba(255, 152, 0, 0.2);
}

.status-1 { 
  color: #07c160; 
  background: linear-gradient(135deg, #e8f5e9 0%, #e0f2e0 100%);
  border: 1rpx solid rgba(7, 193, 96, 0.2);
}

.status-2 { 
  color: #2196f3; 
  background: linear-gradient(135deg, #e3f2fd 0%, #e1f5fe 100%);
  border: 1rpx solid rgba(33, 150, 243, 0.2);
}

.status-3 { 
  color: #673ab7; 
  background: linear-gradient(135deg, #ede7f6 0%, #e8eaf6 100%);
  border: 1rpx solid rgba(103, 58, 183, 0.2);
}

.status-4 { 
  color: #999; 
  background: linear-gradient(135deg, #f5f5f5 0%, #eeeeee 100%);
  border: 1rpx solid rgba(153, 153, 153, 0.2);
}

.order-info {
  padding: 24rpx 32rpx 24rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.6;
  align-items: flex-start;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  color: var(--text-sub);
  margin-right: 12rpx;
  min-width: 140rpx;
  flex-shrink: 0;
}

.amount {
  color: var(--danger-color);
  font-weight: bold;
  font-size: 34rpx;
}

.order-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  padding: 20rpx 32rpx 20rpx 40rpx;
  background-color: #fafafa;
  gap: 16rpx;
}

.action-btn {
  margin-left: 0;
  font-size: 26rpx;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  background-color: #fff;
  margin-bottom: 0;
  transition: all 0.3s ease;
  font-weight: 500;
}

.confirm-btn {
  color: #fff;
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.confirm-btn:active {
  box-shadow: 0 2rpx 6rpx rgba(7, 193, 96, 0.2);
}

.process-btn {
  color: #fff;
  background: linear-gradient(135deg, #2196f3 0%, #1e88e5 100%);
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(33, 150, 243, 0.3);
}

.process-btn:active {
  box-shadow: 0 2rpx 6rpx rgba(33, 150, 243, 0.2);
}

.complete-btn {
  color: #fff;
  background: linear-gradient(135deg, #673ab7 0%, #5e35b1 100%);
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(103, 58, 183, 0.3);
}

.complete-btn:active {
  box-shadow: 0 2rpx 6rpx rgba(103, 58, 183, 0.2);
}

.cancel-btn {
  color: var(--danger-color);
  background-color: #fff;
  border: 1px solid var(--danger-color);
}

.cancel-btn:active {
  background-color: rgba(244, 67, 54, 0.05);
}

.detail-btn {
  color: var(--text-main);
  background-color: #fff;
  border: 1px solid #d0d0d0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.detail-btn:active {
  background-color: #f5f5f5;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  transform: scale(0.98);
}