.admin-orders-container {
  padding: 0 30rpx;
  background-color: var(--bg-color);
  min-height: 100vh;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-main);
}

.action-buttons {
  display: flex;
}

.create-btn {
  background-color: var(--primary-color);
  color: #fff;
  font-size: 28rpx;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  line-height: 1.5;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.search-container {
  display: flex;
  margin-bottom: 24rpx;
}

.search-box {
  flex: 1;
  position: relative;
  margin-right: 20rpx;
}

.search-input {
  width: 100%;
  height: 80rpx;
  border-radius: 40rpx;
  background-color: #fff;
  padding: 0 80rpx 0 30rpx;
  font-size: 28rpx;
  box-shadow: var(--shadow-sm);
}

.search-icon {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
}

.search-icon .iconfont {
  font-size: 0;
  color: #666;
}

.search-icon .iconfont::before {
  content: "🔍";
  font-size: 32rpx;
}

.filter-btn {
  min-width: 100rpx;
  height: 80rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  background-color: #fff;
  padding: 0 24rpx;
  gap: 8rpx;
  box-shadow: var(--shadow-sm);
  color: var(--text-main);
  font-size: 28rpx;
}

.filter-btn .iconfont {
  font-size: 0;
  color: #666;
}

.filter-btn .iconfont::before {
  content: "📊";
  font-size: 32rpx;
}

.close-icon .iconfont {
  font-size: 0;
  color: #666;
}

.close-icon .iconfont::before {
  content: "✕";
  font-size: 32rpx;
}

/* 筛选面板样式优化 */
.filter-panel {
  position: fixed;
  top: 0;
  right: -80%;
  width: 80%;
  height: 100%;
  background-color: #fff;
  z-index: 1000;
  transition: right 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: -4rpx 0 20rpx rgba(0, 0, 0, 0.1);
}

.filter-panel.show {
  right: 0;
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-header text {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
}

.close-icon {
  padding: 10rpx;
}

.close-icon image {
  width: 40rpx;
  height: 40rpx;
}

.filter-content {
  padding: 32rpx;
}

.filter-item {
  margin-bottom: 48rpx;
}

.filter-label {
  display: block;
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
  margin-bottom: 24rpx;
}

.date-range, .price-range {
  display: flex;
  align-items: center;
}

.date-picker, .price-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-main);
  background: #f9f9f9;
}

.date-separator, .price-separator {
  margin: 0 20rpx;
  color: var(--text-sub);
}

.filter-footer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  background-color: #fff;
  border-top: 1rpx solid #f0f0f0;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.reset-btn, .apply-btn {
  width: 46%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.reset-btn {
  background-color: #f5f5f5;
  color: var(--text-main);
}

.apply-btn {
  background-color: var(--primary-color);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

/* 标签页样式优化 */
.tabs {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  background-color: #fff;
  margin-bottom: 24rpx;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
  padding: 0 10rpx;
}

.tab-item {
  flex: 0 0 auto;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: var(--text-sub);
  position: relative;
  white-space: nowrap;
  transition: all 0.3s;
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 6rpx;
  background-color: var(--primary-color);
  border-radius: 3rpx;
}

/* 订单列表样式优化 */
.order-list {
  padding-bottom: 30rpx;
}

.loading, .empty {
  text-align: center;
  padding: 100rpx 0;
  color: var(--text-sub);
  font-size: 28rpx;
}

.order-item {
  background-color: #fff;
  border-radius: var(--border-radius);
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s;
}

.order-item:active {
  transform: scale(0.99);
}

.order-header {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  background: #fafafa;
}

.order-no {
  font-size: 26rpx;
  color: var(--text-sub);
  font-family: monospace;
}

.order-status {
  font-size: 26rpx;
  font-weight: bold;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: #f0f0f0;
}

.status-0 { color: #ff9800; background: #fff3e0; } /* 待支付 */
.status-1 { color: #07c160; background: #e8f5e9; } /* 已支付 */
.status-2 { color: #999; background: #f5f5f5; } /* 已取消 */
.status-3 { color: #f44336; background: #ffebee; } /* 已退款 */
.status-4 { color: #2196f3; background: #e3f2fd; } /* 处理中 */
.status-5 { color: #673ab7; background: #ede7f6; } /* 已完成 */

.order-info {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: var(--text-main);
  line-height: 1.4;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  color: var(--text-sub);
  margin-right: 16rpx;
  min-width: 140rpx;
}

.amount {
  color: var(--danger-color);
  font-weight: bold;
  font-size: 32rpx;
}

.order-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  padding: 20rpx 32rpx;
  background-color: #fff;
}

.action-btn {
  margin-left: 20rpx;
  font-size: 26rpx;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  background-color: #fff;
  margin-bottom: 0;
  transition: all 0.3s;
}

.confirm-btn {
  color: #fff;
  background-color: var(--primary-color);
  border: 1rpx solid var(--primary-color);
}

.process-btn {
  color: #fff;
  background-color: #2196f3;
  border: 1rpx solid #2196f3;
}

.complete-btn {
  color: #fff;
  background-color: #673ab7;
  border: 1rpx solid #673ab7;
}

.cancel-btn {
  color: var(--danger-color);
  background-color: #fff;
  border: 1rpx solid var(--danger-color);
}

.detail-btn {
  color: var(--text-main);
  background-color: #f5f5f5;
  border: 1rpx solid #e0e0e0;
}