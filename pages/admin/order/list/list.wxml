<view class="admin-orders-container">
  <view class="page-header">
    <view class="page-title">订单管理</view>
    <view class="action-buttons">
      <t-button theme="primary" bindtap="navigateToCreate">新建订单</t-button>
    </view>
  </view>

  <!-- 搜索框 -->
  <view class="search-container">
    <view class="search-wrapper">
      <t-search
        placeholder="搜索订单号或联系人"
        value="{{searchKeyword}}"
        bind:change="onSearchChange"
        bind:submit="onSearchConfirm"
        bind:clear="onSearchClear"
      ></t-search>
    </view>
    <view class="filter-btn" bindtap="toggleFilterPanel">
      <t-icon name="filter" size="20"></t-icon>
      <text>筛选</text>
    </view>
  </view>

  <!-- 筛选面板 -->
  <view class="filter-mask" wx:if="{{showFilterPanel}}" catchtap="toggleFilterPanel"></view>
  <view class="filter-drawer" wx:if="{{showFilterPanel}}" catchtouchmove="true">
    <view class="filter-panel">
      <view class="filter-header">
        <text>筛选条件</text>
        <t-icon name="close" size="20" bindtap="toggleFilterPanel"></t-icon>
      </view>
      <view class="filter-content">
        <view class="filter-item">
          <text class="filter-label">订单时间</text>
          <view class="date-range">
            <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
              <view class="date-picker">{{startDate || '开始日期'}}</view>
            </picker>
            <text class="date-separator">至</text>
            <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange">
              <view class="date-picker">{{endDate || '结束日期'}}</view>
            </picker>
          </view>
        </view>
        <view class="filter-item">
          <text class="filter-label">价格区间</text>
          <view class="price-range">
            <t-input
              type="number"
              placeholder="最低价"
              value="{{minPrice}}"
              bind:change="onMinPriceChange"
            ></t-input>
            <text class="price-separator">至</text>
            <t-input
              type="number"
              placeholder="最高价"
              value="{{maxPrice}}"
              bind:change="onMaxPriceChange"
            ></t-input>
          </view>
        </view>
      </view>
      <view class="filter-footer">
        <t-button theme="default" bindtap="resetFilter">重置</t-button>
        <t-button theme="primary" bindtap="applyFilter">确定</t-button>
      </view>
    </view>
  </view>

  <!-- 订单状态标签页（与统计页面保持一致） -->
  <view class="tabs">
    <view
      class="tab-item {{activeTab === '0' ? 'active' : ''}}"
      data-value="0"
      bindtap="onTabClick">全部</view>
    <view
      class="tab-item {{activeTab === '1' ? 'active' : ''}}"
      data-value="1"
      bindtap="onTabClick">待支付</view>
    <view
      class="tab-item {{activeTab === '2' ? 'active' : ''}}"
      data-value="2"
      bindtap="onTabClick">待服务</view>
    <view
      class="tab-item {{activeTab === '3' ? 'active' : ''}}"
      data-value="3"
      bindtap="onTabClick">服务中</view>
    <view
      class="tab-item {{activeTab === '4' ? 'active' : ''}}"
      data-value="4"
      bindtap="onTabClick">待收款</view>
    <view
      class="tab-item {{activeTab === '5' ? 'active' : ''}}"
      data-value="5"
      bindtap="onTabClick">已完成</view>
    <view
      class="tab-item {{activeTab === '6' ? 'active' : ''}}"
      data-value="6"
      bindtap="onTabClick">已取消</view>
  </view>

  <view class="order-list">
    <view class="loading-wrapper" wx:if="{{loading}}">
      <view class="loading-text">加载中...</view>
    </view>
    <t-empty wx:elif="{{!orders.length}}" description="暂无订单"></t-empty>
    <view class="orders" wx:else>
      <view class="order-item" wx:for="{{orders}}" wx:key="orderNo">
        <view class="order-header">
          <text class="order-no">订单号：{{item.orderNo}}</text>
          <!-- 双状态标签显示 -->
          <view class="order-status-tags">
            <view class="status-tag flow-status-{{item.orderStatus !== undefined ? item.orderStatus : item.status}}">{{item.orderStatusText}}</view>
            <view class="status-tag payment-status-{{item.paymentStatus !== undefined ? item.paymentStatus : (item.status === 1 || item.status === 2 || item.status === 3 ? 1 : 0)}}">{{item.paymentStatusText}}</view>
          </view>
        </view>
        <view class="order-info" bindtap="onOrderClick" data-orderid="{{item._id}}">
          <view class="info-row">
            <text class="label">联系人：</text>
            <text>{{item.contactName}}</text>
          </view>
          <view class="info-row">
            <text class="label">联系电话：</text>
            <text>{{item.contactPhone}}</text>
          </view>
          <view class="info-row">
            <text class="label">服务时间：</text>
            <text>{{item.serviceTime}}</text>
          </view>
          <view class="info-row">
            <text class="label">创建时间：</text>
            <text>{{item.createdTime}}</text>
          </view>
          <view class="info-row">
            <text class="label">订单金额：</text>
            <text class="amount">¥{{item.totalAmount}}</text>
          </view>
        </view>
        <view class="order-actions">
          <!-- 订单动作按钮 - 根据订单状态显示不同的按钮（兼容新旧字段） -->
          <!-- 待服务且未支付：显示确认支付和开始服务 -->
          <block wx:if="{{(item.orderStatus === 0 && item.paymentStatus === 0) || (item.orderStatus === undefined && item.status === 0)}}">
            <t-button
              size="small"
              theme="success"
              class="btn-success"
              data-orderid="{{item._id}}"
              data-status="1"
              bindtap="updateOrderStatus">确认支付</t-button>
            <t-button
              size="small"
              theme="primary"
              class="btn-primary"
              data-orderid="{{item._id}}"
              bindtap="startService">开始服务</t-button>
          </block>
          <!-- 待服务且已支付：显示开始服务 -->
          <block wx:elif="{{(item.orderStatus === 0 && item.paymentStatus === 1) || (item.orderStatus === undefined && item.status === 1)}}">
            <t-button
              size="small"
              theme="primary"
              class="btn-primary"
              data-orderid="{{item._id}}"
              data-status="2"
              bindtap="updateOrderStatus">开始服务</t-button>
          </block>
          <!-- 服务中：显示标记服务完成 -->
          <block wx:elif="{{item.orderStatus === 1 || (item.orderStatus === undefined && item.status === 2)}}">
            <t-button
              size="small"
              theme="primary"
              class="btn-primary"
              data-orderid="{{item._id}}"
              data-status="3"
              bindtap="updateOrderStatus">服务完成</t-button>
          </block>
          <!-- 服务完成且未支付：显示确认收款 -->
          <block wx:elif="{{(item.orderStatus === 2 && item.paymentStatus === 0) || (item.orderStatus === undefined && item.status === 5)}}">
            <t-button
              size="small"
              theme="success"
              class="btn-success"
              data-orderid="{{item._id}}"
              bindtap="recordOfflinePayment">确认线下收款</t-button>
          </block>
          <!-- 服务完成且已支付：显示完成订单 -->
          <block wx:elif="{{item.orderStatus === 2 && item.paymentStatus === 1}}">
            <t-button
              size="small"
              theme="primary"
              class="btn-primary"
              data-orderid="{{item._id}}"
              data-status="3"
              bindtap="updateOrderStatus">完成订单</t-button>
          </block>
          <!-- 非已完成、非已取消状态：显示取消订单 -->
          <block wx:if="{{item.orderStatus !== undefined ? (item.orderStatus !== 3 && item.orderStatus !== 4) : (item.status !== 3 && item.status !== 4)}}">
            <t-button
              size="small"
              theme="danger"
              class="btn-danger"
              data-orderid="{{item._id}}"
              data-status="4"
              bindtap="updateOrderStatus">取消订单</t-button>
          </block>
        </view>
      </view>
    </view>
  </view>
</view>
