.category-edit-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 160rpx;
}

/* 类型选择 */
.type-radio {
  display: flex;
  justify-content: flex-end;
}

.type-text {
  color: #999;
  font-size: 28rpx;
}

/* 状态分组 */
.status-group {
  margin-top: 20rpx;
}

.status-radio {
  display: flex;
  justify-content: flex-end;
}

/* 商品数量提示 */
.product-count-tip {
  margin: 20rpx 32rpx;
  padding: 20rpx;
  background-color: #fff7e6;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #fa9550;
}

/* 提交按钮区域 */
.submit-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background-color: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}