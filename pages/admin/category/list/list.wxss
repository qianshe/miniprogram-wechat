.admin-category-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 页面头部 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
  z-index: 10;
  position: relative;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

/* 搜索框 */
.search-container {
  padding: 20rpx 32rpx;
  background-color: #fff;
}

.search-box {
  position: relative;
}

.search-input {
  width: 100%;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 70rpx 0 28rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.search-icon {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
}

.search-icon-text {
  font-size: 32rpx;
  line-height: 1;
}

/* 类型筛选 */
.type-filter {
  display: flex;
  padding: 0 32rpx 24rpx;
  background-color: #fff;
  gap: 24rpx;
}

.filter-item {
  padding: 12rpx 36rpx;
  font-size: 28rpx;
  color: #666;
  background-color: #f8f9fa;
  border-radius: 16rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  font-weight: 500;
}

.filter-item.active {
  color: #fff;
  background: var(--admin-primary);
  box-shadow: 0 6rpx 16rpx var(--admin-primary-light);
  transform: translateY(-2rpx);
}

/* 分类列表 */
.category-list {
  padding: 24rpx 32rpx;
  position: relative;
}

.list-area {
  width: 100%;
  position: relative;
}

.category-item-movable {
  width: 100%;
  position: absolute;
  left: 0;
}

.category-item {
  height: 100%;
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s;
  position: relative;
}

.category-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  height: 100%;
  box-sizing: border-box;
}

.category-main {
  flex: 1;
}

.category-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}

.category-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.product-count {
  font-size: 24rpx;
  color: #999;
}

.category-extra {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  min-width: 120rpx;
}

.category-sort {
  font-size: 24rpx;
  color: #999;
}

.category-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.category-status.status-on {
  color: #00a870;
  background-color: rgba(0, 168, 112, 0.1);
}

.category-status.status-off {
  color: var(--admin-danger);
  background-color: rgba(192, 85, 70, 0.1);
}

.drag-handle {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx;
  opacity: 0.5;
}

.drag-handle-text {
  font-size: 36rpx;
  line-height: 1;
  color: #ccc;
  letter-spacing: -4rpx;
}

/* 滑动操作按钮 */
.swipe-actions {
  display: flex;
  height: 100%;
}

.swipe-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 100%;
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.edit-btn {
  background-color: var(--admin-primary);
}

.toggle-btn {
  background-color: var(--admin-warning);
}

.delete-btn {
  background-color: var(--admin-danger);
}

/* 加载更多 */
.load-more {
  padding: 32rpx;
  text-align: center;
}

.loading {
  font-size: 28rpx;
  color: #999;
}

.no-more {
  padding: 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

/* 骨架屏样式 */
.skeleton-list {
  width: 100%;
}

.skeleton-item {
  background-color: #fff;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.skeleton-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  height: 100%;
  box-sizing: border-box;
}

.skeleton-main {
  flex: 1;
}

.skeleton-extra {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
  min-width: 120rpx;
}

.skeleton-row {
  height: 32rpx;
  background: rgba(0,0,0,0.05);
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  animation: skeleton-blink 1.5s infinite ease-in-out;
}

.skeleton-row:last-child {
  margin-bottom: 0;
}

.skeleton-row.short {
  width: 80rpx;
  height: 24rpx;
}

.skeleton-row.medium {
  width: 200rpx;
  height: 24rpx;
}

.skeleton-row.long {
  width: 300rpx;
  height: 32rpx;
  margin-bottom: 20rpx;
}

@keyframes skeleton-blink {
  0% { opacity: 0.6; }
  50% { opacity: 1; }
  100% { opacity: 0.6; }
}

/* 加载更多动画 */
.loading-spinner {
  display: inline-block;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: var(--admin-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 12rpx;
  vertical-align: middle;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
