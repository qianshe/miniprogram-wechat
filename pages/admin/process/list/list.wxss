.admin-process-container {
  min-height: 100vh;
  background: #f6f0e7;
  padding-bottom: 40rpx;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  padding: 28rpx 32rpx 20rpx;
  background: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.page-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #333333;
  letter-spacing: 1rpx;
}

.page-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8c8175;
}

.summary-chip {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #f3ede5;
  color: #7a6652;
  font-size: 24rpx;
  line-height: 1;
  white-space: nowrap;
}

.search-container {
  padding: 20rpx 32rpx 16rpx;
  background: #fff;
}

.search-box {
  position: relative;
}

.search-input {
  width: 100%;
  height: 72rpx;
  background: #f5f1eb;
  border-radius: 40rpx;
  padding: 0 70rpx 0 28rpx;
  font-size: 28rpx;
  color: #333333;
  box-sizing: border-box;
}

.search-icon {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999999;
}

.search-icon-text {
  font-size: 32rpx;
  line-height: 1;
}

.type-filter {
  display: flex;
  gap: 20rpx;
  padding: 0 32rpx 24rpx;
  background: #fff;
}

.filter-item {
  padding: 12rpx 28rpx;
  border-radius: 16rpx;
  background: #f3efe8;
  color: #7d7266;
  font-size: 26rpx;
  font-weight: 500;
}

.filter-item.active {
  background: #a67c52;
  color: #ffffff;
}

.process-list {
  padding: 24rpx 32rpx;
}

.step-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.step-card {
  background: #ffffff;
  border-radius: 22rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(166, 124, 82, 0.08);
}

.step-card-header {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.step-order {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #f3ede5;
  color: #7a6652;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.step-title-group {
  flex: 1;
  min-width: 0;
}

.step-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.4;
}

.step-description {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8c8175;
  line-height: 1.6;
}

.step-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 24rpx;
}

.status-pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-pill.status-on {
  background: rgba(0, 168, 112, 0.12);
  color: #00805a;
}

.status-pill.status-off {
  background: rgba(192, 85, 70, 0.12);
  color: #c05546;
}

.meta-text {
  font-size: 22rpx;
  color: #8c8175;
}

.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skeleton-item {
  background: #ffffff;
  border-radius: 22rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.skeleton-title,
.skeleton-line {
  background: linear-gradient(90deg, #f2ede5 25%, #ebe4d9 37%, #f2ede5 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease infinite;
  border-radius: 12rpx;
}

.skeleton-title {
  width: 42%;
  height: 34rpx;
}

.skeleton-line {
  width: 100%;
  height: 24rpx;
  margin-top: 18rpx;
}

.skeleton-line.short {
  width: 68%;
}

.load-more,
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 0;
  font-size: 24rpx;
  color: #8c8175;
}

.load-more-text {
  color: #8c8175;
}

@keyframes shimmer {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
