<view class="container">
  <view class="page-header">
    <view class="page-title">{{isEdit ? '编辑商品' : '新增商品'}}</view>
  </view>

  <view class="form-content">
    <t-cell-group theme="card">
      <t-input label="商品名称" placeholder="请输入商品名称" value="{{formData.name}}" bind:change="onNameChange" />
      <t-input label="商品价格" placeholder="请输入价格" type="number" value="{{formData.price}}" bind:change="onPriceChange" suffix="元" />
      <t-input label="进价" placeholder="请输入进价" type="number" value="{{formData.costPrice}}" bind:change="onCostPriceChange" suffix="元" />
      <t-input label="库存" placeholder="请输入库存数量" type="number" value="{{formData.stock}}" bind:change="onStockChange" />
      
      <t-cell title="商品分类" arrow hover note="{{selectedCategoryName || '请选择分类'}}" bind:click="onCategoryPicker" />
      
      <t-cell title="商品图片" bordered="{{false}}">
        <view class="upload-container" slot="note">
          <view style="width: 100%;">
            <t-button
              size="small"
              theme="primary"
              variant="outline"
              bind:tap="onSelectImage"
              disabled="{{fileList.length >= 9}}"
            >上传图片（{{fileList.length}}/9）</t-button>

            <view wx:if="{{fileList.length > 0}}" style="margin-top: 20rpx; display: flex; flex-direction: column; gap: 20rpx;">
              <view wx:for="{{fileList}}" wx:key="url" data-index="{{index}}" style="display: flex; align-items: center; gap: 20rpx;">
                <image
                  src="{{item.url}}"
                  mode="aspectFill"
                  data-index="{{index}}"
                  bindtap="onPreviewImage"
                  style="width: 120rpx; height: 120rpx; border-radius: 12rpx; background: #f5f5f5;"
                />
                <view style="flex: 1; display: flex; align-items: center; justify-content: flex-end; gap: 12rpx; flex-wrap: wrap;">
                  <view wx:if="{{index === coverIndex}}" style="font-size: 24rpx; color: #0052d9;">封面图</view>
                  <t-button
                    wx:else
                    size="small"
                    variant="outline"
                    data-index="{{index}}"
                    bind:tap="onSetCover"
                  >设为封面</t-button>
                  <t-button
                    size="small"
                    theme="danger"
                    variant="text"
                    data-index="{{index}}"
                    bind:tap="onRemoveImage"
                  >删除</t-button>
                </view>
              </view>
            </view>

            <view style="margin-top: 12rpx; font-size: 24rpx; color: #999;">首图默认为封面图，可手动指定封面，最多上传9张</view>
          </view>
        </view>
      </t-cell>
      
      <t-textarea label="商品描述" placeholder="请输入商品详细描述" value="{{formData.description}}" bind:change="onDescriptionChange" autosize />
      
      <t-cell title="上架状态">
        <t-switch value="{{formData.status === 1}}" bind:change="onStatusChange" slot="note" />
      </t-cell>
    </t-cell-group>

    <view class="submit-btn">
      <t-button theme="primary" size="large" block bind:tap="onSubmit">保存</t-button>
    </view>
  </view>

  <t-picker
    visible="{{categoryVisible}}"
    value="{{[formData.category]}}"
    title="选择分类"
    cancelBtn="取消"
    confirmBtn="确认"
    bindchange="onCategoryChange"
    bindpick="onColumnChange"
    bindcancel="onPickerCancel"
  >
    <t-picker-item options="{{categories}}" />
  </t-picker>
</view>
