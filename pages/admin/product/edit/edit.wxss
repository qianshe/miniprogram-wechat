.container {
  padding: 24rpx;
  padding-bottom: 180rpx; /* 为底部按钮留出空间 */
  background-color: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 30rpx;
  padding: 10rpx 0;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a1a1a;
  letter-spacing: -1rpx;
}

/* 表单分组 */
.form-section {
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.02);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  padding: 30rpx 32rpx 10rpx;
}

.upload-container {
  display: flex;
  justify-content: flex-end;
  padding: 10rpx 0;
}

/* 底部固定按钮栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.submit-btn {
  flex: 1;
}
