.page-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 200rpx;
  box-sizing: border-box;
}

/* 顶部区域 */
.header-section {
  padding: 40rpx 32rpx;
  background-color: var(--bg-color);
}

.header-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 12rpx;
  letter-spacing: -1rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: var(--text-sub);
}

/* 图片上传区域 */
.upload-section {
  padding: 0 32rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.upload-card {
  width: 100%;
  height: 400rpx;
  background-color: #fff;
  border-radius: 32rpx;
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 2rpx dashed #e0e0e0; /* 添加虚线边框 */
}

/* 覆盖 TDesign 上传组件样式，使其充满容器 */
.custom-upload {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0; /* 隐藏实际上传组件，只用作触发 */
  z-index: 10;
}

/* 修复 TDesign 上传组件内部布局 */
.t-upload__grid {
  width: 100% !important;
  height: 100% !important;
}

.t-upload__item {
  width: 100% !important;
  height: 100% !important;
  margin: 0 !important;
}

/* 确保上传后的图片充满容器 */
.t-upload__item image {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
  gap: 20rpx;
  pointer-events: none;
  width: 100%;
  height: 100%;
  background-color: #fafafa; /* 浅色背景 */
}

.upload-tips {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 20rpx;
  text-align: center;
}

/* 表单容器 */
.form-container {
  padding: 0 32rpx;
}

.form-card {
  background-color: #fff;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-sm);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 32rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid var(--primary-color);
  line-height: 1;
}

/* 输入框组 */
.input-group {
  margin-bottom: 32rpx;
}

.input-group:last-child {
  margin-bottom: 0;
}

.input-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
  margin-left: 8rpx;
}

/* 自定义填充式输入框 */
.filled-input {
  background-color: #f7f8fa !important; /* 浅灰背景 */
  border-radius: 16rpx !important;
  padding: 24rpx 32rpx !important;
  font-size: 28rpx;
  color: var(--text-main);
  transition: all 0.3s;
}

.filled-input:active {
  background-color: #f0f1f3 !important;
}

.placeholder-style {
  color: #bbb;
}

.textarea-input {
  min-height: 200rpx;
  width: auto !important; /* 修复 textarea 宽度问题 */
}

/* 选择器触发器样式 */
.picker-trigger {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 48rpx; /* 保持高度一致 */
}

.text-value {
  color: var(--text-main);
}

.text-placeholder {
  color: #bbb;
}

/* 栅格布局 */
.grid-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.grid-col {
  flex: 1;
}

/* 设置行 */
.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.setting-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.setting-desc {
  font-size: 24rpx;
  color: var(--text-sub);
}

/* 底部按钮 */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  padding: 24rpx 48rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.submit-btn {
  font-weight: 600;
  font-size: 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(var(--primary-color-rgb), 0.3);
}
