.page-container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 200rpx;
  box-sizing: border-box;
}

/* 顶部区域 */
.header-section {
  padding: 40rpx 32rpx;
  background-color: var(--bg-color);
}

.header-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 12rpx;
  letter-spacing: -1rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: var(--text-sub);
}

/* 图片上传区域 */
.upload-section {
  padding: 0 32rpx 40rpx;
  display: flex;
  flex-direction: column;
}

.upload-group {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

/* 上传按钮样式 */
.upload-add {
  width: 220rpx;
  height: 220rpx;
  background-color: #f7f7f7;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #dcdcdc;
  box-sizing: border-box;
}

.upload-add:active {
  background-color: #eeeeee;
}

.upload-text {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 16rpx;
}

/* 图片预览样式 */
.upload-preview {
  width: 220rpx;
  height: 220rpx;
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
  display: block;
}

/* 删除按钮 */
.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-bottom-left-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.upload-tips {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 20rpx;
  margin-left: 8rpx;
}

/* 表单容器 */
.form-container {
  padding: 0 32rpx;
}

.form-card {
  background-color: #fff;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-sm);
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 32rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid var(--primary-color);
  line-height: 1;
}

/* 输入框组 */
.input-group {
  margin-bottom: 32rpx;
}

.input-group:last-child {
  margin-bottom: 0;
}

.input-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
  margin-left: 8rpx;
}

/* 自定义填充式输入框 */
.filled-input {
  background-color: #f7f8fa !important;
  border: 2rpx solid #e5e7eb !important;
  border-radius: 16rpx !important;
  padding: 24rpx 32rpx !important;
  font-size: 28rpx;
  color: var(--text-main);
  transition: all 0.3s;
  box-sizing: border-box; /* 确保高度计算包含 padding */
}

.filled-input:focus {
  border-color: var(--primary-color) !important;
  background-color: #fff !important;
}

.filled-input:active {
  background-color: #f0f1f3 !important;
}

.placeholder-style {
  color: var(--text-sub);
}

.textarea-input {
  min-height: 200rpx;
  width: auto !important; /* 修复 textarea 宽度问题 */
}

/* 选择器触发器样式 */
.picker-trigger {
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
  height: 96rpx !important; /* 固定高度，与 t-input 保持一致 */
  padding: 0 32rpx !important; /* 移除垂直 padding，使用 flex 居中 */
  width: 100%;
  box-sizing: border-box;
  background-color: #f7f8fa; /* 确保背景色存在 */
}

.text-value, .text-placeholder {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  line-height: 96rpx; /* 垂直居中辅助 */
}

.text-value {
  color: var(--text-main);
}

.text-placeholder {
  color: var(--text-sub);
}

/* ... (中间省略) ... */

/* 弹窗样式 */
.custom-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  backdrop-filter: blur(4px);
}

.custom-modal-container {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  z-index: 1001;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.15);
}

.picker-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx;
  position: relative;
  background-color: #fff;
  border-bottom: 2rpx solid #f5f5f5;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.picker-close {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 10rpx;
}

.picker-content {
  max-height: 60vh;
  min-height: 300rpx;
  background-color: #fff;
}

.category-list {
  padding: 16rpx 24rpx;
}

.category-cell {
  border-radius: 16rpx !important;
  margin-bottom: 16rpx !important;
  transition: all 0.3s;
  background-color: #f9f9f9 !important;
}

.category-cell::after {
  display: none !important; /* 移除默认边框 */
}

.category-cell-active {
  background-color: rgba(var(--primary-color-rgb), 0.08) !important;
}

.category-title {
  font-size: 28rpx;
  color: var(--text-main);
}

.category-title-active {
  color: var(--primary-color) !important;
  font-weight: 600;
}
