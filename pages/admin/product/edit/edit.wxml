<view class="container">
  <view class="page-header">
    <view class="page-title">{{isEdit ? '编辑商品' : '新增商品'}}</view>
  </view>

  <!-- 基本信息 -->
  <view class="form-section">
    <view class="section-title">基本信息</view>
    <t-cell-group theme="card">
      <t-input label="商品名称" placeholder="请输入商品名称" value="{{formData.name}}" bind:change="onNameChange" />
      <t-cell title="商品分类" arrow hover note="{{selectedCategoryName || '请选择分类'}}" bind:click="onCategoryPicker" />
      <t-textarea label="商品描述" placeholder="请输入商品详细描述" value="{{formData.description}}" bind:change="onDescriptionChange" autosize />
    </t-cell-group>
  </view>

  <!-- 价格与库存 -->
  <view class="form-section">
    <view class="section-title">价格与库存</view>
    <t-cell-group theme="card">
      <t-input label="商品价格" placeholder="0.00" type="number" value="{{formData.price}}" bind:change="onPriceChange" suffix="元" />
      <t-input label="市场原价" placeholder="0.00" type="number" value="{{formData.originalPrice}}" bind:change="onOriginalPriceChange" suffix="元" />
      <t-input label="库存数量" placeholder="0" type="number" value="{{formData.stock}}" bind:change="onStockChange" />
    </t-cell-group>
  </view>

  <!-- 商品图片 -->
  <view class="form-section">
    <view class="section-title">商品图片</view>
    <t-cell-group theme="card">
      <t-cell title="主图上传" description="建议尺寸 800x800" bordered="{{false}}">
        <view class="upload-container" slot="note">
          <t-upload
            mediaType="{{['image']}}"
            max="{{1}}"
            files="{{fileList}}"
            bind:add="onAddImage"
            bind:remove="onRemoveImage"
          />
        </view>
      </t-cell>
    </t-cell-group>
  </view>

  <!-- 上架设置 -->
  <view class="form-section">
    <view class="section-title">上架设置</view>
    <t-cell-group theme="card">
      <t-cell title="立即上架" description="关闭后商品将存入仓库">
        <t-switch value="{{formData.status === 1}}" bind:change="onStatusChange" slot="note" />
      </t-cell>
    </t-cell-group>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-bar">
    <t-button class="submit-btn" theme="primary" size="large" block bind:tap="onSubmit">保存商品</t-button>
  </view>

  <t-picker
    visible="{{categoryVisible}}"
    value="{{[formData.categoryId]}}"
    title="选择分类"
    cancelBtn="取消"
    confirmBtn="确认"
    bindchange="onCategoryChange"
    bindpick="onColumnChange"
    bindcancel="onPickerCancel"
  >
    <t-picker-item options="{{categories}}" />
  </t-picker>
</view>
