<view class="page-container">
  <!-- 顶部导航/标题 -->
  <view class="header-section">
    <view class="header-title">{{isEdit ? '编辑商品' : '创建新商品'}}</view>
    <view class="header-subtitle">请完善以下商品信息</view>
  </view>

  <!-- 图片上传区域 (朋友圈风格) -->
  <view class="upload-section">
    <view class="upload-group">
      <!-- 已有图片展示 -->
      <view
        wx:for="{{fileList}}"
        wx:key="url"
        style="display: flex; flex-direction: column; gap: 10rpx;"
      >
        <view class="upload-preview" bindtap="onPreviewImage" data-index="{{index}}">
          <image src="{{item.url}}" mode="aspectFill" class="preview-image" />
          <view class="delete-btn" catchtap="onRemoveImage" data-index="{{index}}">
            <t-icon name="close" size="32rpx" color="#fff" />
          </view>
          <view
            wx:if="{{index === coverIndex}}"
            style="position: absolute; left: 10rpx; bottom: 10rpx; background: rgba(0,82,217,.85); color: #fff; font-size: 22rpx; padding: 4rpx 10rpx; border-radius: 999rpx;"
          >封面图</view>
        </view>
        <view
          wx:if="{{index !== coverIndex}}"
          data-index="{{index}}"
          catchtap="onSetCover"
          style="font-size: 24rpx; color: #0052d9; text-align: center;"
        >设为封面</view>
      </view>

      <!-- 上传按钮 (未满 9 张时显示) -->
      <view class="upload-add" bindtap="onSelectImage" wx:if="{{fileList.length < 9}}">
        <t-icon name="add" size="64rpx" color="#999" />
        <text class="upload-text">上传图片</text>
        <text class="upload-text">{{fileList.length}}/9</text>
      </view>

      <view wx:if="{{fileList.length >= 9}}" style="font-size: 24rpx; color: #999; align-self: center;">已达上限 9 张</view>
    </view>
    <view class="upload-tips">首图默认为封面图，可指定/替换封面。选择图片后将先裁成 1:1 方图，再上传；建议尺寸 800x800 像素</view>
  </view>

  <view class="form-container">
    
    <!-- 基本信息卡片 -->
    <view class="form-card">
      <view class="card-title">基本信息</view>
      
      <view class="input-group">
        <view class="input-label">商品名称</view>
        <t-input 
          placeholder="请输入商品名称" 
          value="{{formData.name}}" 
          bind:change="onNameChange" 
          borderless="{{true}}"
          class="filled-input"
          placeholder-class="placeholder-style"
        />
      </view>

      <view class="input-group">
        <view class="input-label">商品分类</view>
        <view class="filled-input picker-trigger" bindtap="onCategoryPicker">
          <view class="{{selectedCategoryName ? 'text-value' : 'text-placeholder'}}">
            {{selectedCategoryName || '请选择商品分类'}}
          </view>
          <t-icon name="chevron-right" size="40rpx" color="#ccc" />
        </view>
      </view>

      <view class="input-group">
        <view class="input-label">商品描述</view>
        <t-textarea 
          placeholder="请输入商品详细描述..." 
          value="{{formData.description}}" 
          bind:change="onDescriptionChange" 
          autosize 
          borderless="{{true}}"
          class="filled-input textarea-input"
          placeholder-class="placeholder-style"
          maxlength="200"
          indicator
        />
      </view>
    </view>

    <!-- 价格与库存卡片 -->
    <view class="form-card">
      <view class="card-title">价格与库存</view>
      
      <view class="grid-row">
        <view class="grid-col">
          <view class="input-group">
            <view class="input-label">销售价格</view>
            <t-input 
              type="number" 
              placeholder="0.00" 
              value="{{formData.price}}" 
              bind:change="onPriceChange" 
              borderless="{{true}}"
              class="filled-input"
              suffix="元"
            />
          </view>
        </view>
        <view class="grid-col">
          <view class="input-group">
            <view class="input-label">进价</view>
            <t-input 
              type="number" 
              placeholder="0.00" 
              value="{{formData.costPrice}}" 
              bind:change="onCostPriceChange" 
              borderless="{{true}}"
              class="filled-input"
              suffix="元"
            />
          </view>
        </view>
      </view>

      <view class="input-group">
        <view class="input-label">库存数量</view>
        <t-input 
          type="number" 
          placeholder="0" 
          value="{{formData.stock}}" 
          bind:change="onStockChange" 
          borderless="{{true}}"
          class="filled-input"
        />
      </view>
    </view>

    <!-- 设置卡片 -->
    <view class="form-card">
      <view class="setting-row">
        <view class="setting-info">
          <view class="setting-title">立即上架</view>
          <view class="setting-desc">开启后商品将在店铺中可见</view>
        </view>
        <t-switch 
          value="{{formData.status === 1}}" 
          bind:change="onStatusChange" 
          colors="{{['var(--primary-color)', '#e6e6e6']}}" 
        />
      </view>
    </view>

  </view>

  <!-- 底部按钮 -->
  <view class="footer-bar">
    <t-button 
      theme="primary" 
      size="large" 
      block 
      shape="round" 
      class="submit-btn" 
      bind:tap="onSubmit"
    >
      保存商品
    </t-button>
  </view>

  <!-- 分类选择弹窗 (自定义居中弹窗) -->
  <view class="custom-modal-mask" wx:if="{{categoryVisible}}" bindtap="onPickerCancel" catchtouchmove="true"></view>
  <view class="custom-modal-container" wx:if="{{categoryVisible}}" catchtouchmove="true">
    <view class="picker-header">
      <view class="picker-title">选择分类</view>
      <view class="picker-close" bindtap="onPickerCancel">
        <t-icon name="close" size="40rpx" color="#999" />
      </view>
    </view>
    <scroll-view scroll-y="{{true}}" class="picker-content">
      <view class="category-list">
        <t-cell-group>
          <t-cell
            wx:for="{{categories}}"
            wx:key="value"
            title="{{item.label}}"
            bind:click="onSelectCategory"
            data-value="{{item.value}}"
            data-label="{{item.label}}"
            t-class="category-cell {{formData.category === item.value ? 'category-cell-active' : ''}}"
            t-class-title="category-title {{formData.category === item.value ? 'category-title-active' : ''}}"
            bordered="{{false}}"
          >
             <t-icon wx:if="{{formData.category === item.value}}" name="check" slot="right-icon" color="var(--primary-color)"/>
          </t-cell>
        </t-cell-group>
      </view>
    </scroll-view>
  </view>
</view>
