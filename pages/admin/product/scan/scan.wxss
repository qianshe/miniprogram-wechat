.scan-container {
  padding: 30rpx;
  min-height: 100vh;
  background-color: var(--bg-color);
}

.page-header {
  margin-bottom: 30rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-main);
}

.result-section {
  background-color: #fff;
  border-radius: var(--border-radius);
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: var(--shadow-md);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 24rpx;
}

.scan-image-container {
  width: 100%;
  height: 400rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #f0f0f0;
}

.scan-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.product-info {
  margin-bottom: 30rpx;
}

.product-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.product-name {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-main);
  text-align: center;
  margin-bottom: 16rpx;
}

.product-price {
  display: flex;
  align-items: center;
  justify-content: center;
}

.current-price {
  font-size: 48rpx;
  color: var(--danger-color);
  font-weight: bold;
}

.original-price {
  font-size: 28rpx;
  color: var(--text-sub);
  text-decoration: line-through;
  margin-left: 16rpx;
}

.info-divider {
  height: 1px;
  background-color: #f0f0f0;
  margin: 32rpx 0;
}

.info-row {
  display: flex;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.info-label {
  width: 160rpx;
  color: var(--text-sub);
}

.info-value {
  flex: 1;
  color: var(--text-main);
}

.info-value.description {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.action-buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
}

.action-btn {
  width: 48%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.3s;
}

.action-btn.primary {
  background-color: var(--danger-color);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(244, 67, 54, 0.3);
}

.action-btn.secondary {
  background-color: #fff;
  color: var(--text-main);
  box-shadow: var(--shadow-sm);
}

.action-btn:active {
  transform: scale(0.98);
  box-shadow: none;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-icon {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 30rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: var(--text-sub);
}

.scan-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.placeholder-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
  color: #e0e0e0;
}

.placeholder-text {
  font-size: 30rpx;
  color: var(--text-sub);
  margin-bottom: 60rpx;
}

.scan-btn {
  width: 320rpx;
  height: 88rpx;
  line-height: 88rpx;
  background-color: var(--primary-color);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
  transition: all 0.3s;
}

.scan-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(7, 193, 96, 0.2);
}

.error-message {
  text-align: center;
  font-size: 28rpx;
  color: var(--danger-color);
  margin: 30rpx 0;
}

.retry-btn {
  color: #2196f3;
  margin-top: 20rpx;
  font-size: 28rpx;
  padding: 10rpx 20rpx;
}

.scan-tips {
  margin-top: 80rpx;
  width: 80%;
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  box-shadow: var(--shadow-sm);
}

.tips-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

.tips-item {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.bottom-buttons {
  margin-top: 50rpx;
}

.bottom-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #fff;
  color: var(--text-main);
  font-size: 30rpx;
  border-radius: 44rpx;
  box-shadow: var(--shadow-sm);
}