<view class="admin-products-container">
  <!-- 页面头部 -->
  <view class="page-header">
    <view class="page-title">商品管理</view>
    <view class="action-buttons">
      <view class="action-btn-item">
        <t-button class="action-btn" theme="default" size="small" icon="download" variant="outline" bindtap="exportProducts">导出</t-button>
      </view>
      <view class="action-btn-item">
        <t-button class="action-btn" theme="default" size="small" icon="upload" variant="outline" bindtap="importProducts">导入</t-button>
      </view>
      <view class="action-btn-item">
        <t-button class="action-btn" theme="default" size="small" icon="scan" bindtap="scanProduct">扫码</t-button>
      </view>
      <view class="action-btn-item">
        <t-button class="action-btn" theme="primary" size="small" icon="add" bindtap="createProduct">新增</t-button>
      </view>
    </view>
  </view>
  
  <!-- 搜索框 -->
  <view class="search-container">
    <view class="search-input-box">
      <t-search
        placeholder="搜索商品名称"
        bind:change="onSearchInput"
        bind:submit="onSearchConfirm"
        bind:clear="onSearchClear"
        value="{{keyword}}"
        shape="round"
      />
    </view>
    <view class="category-filter-btn {{selectedCategoryId ? 'active' : ''}}" bindtap="showCategoryPicker">
      <text>{{selectedCategoryName || '分类'}}</text>
      <t-icon name="filter" size="32rpx" />
    </view>
  </view>
  
  <!-- 排序选项 -->
  <view class="sort-options">
    <view class="sort-item {{orderBy === 'sales' ? 'active' : ''}}" bindtap="changeOrderBy" data-orderby="sales">
      销量
      <view class="sort-icon {{orderBy === 'sales' ? (orderDirection === 'desc' ? 'desc' : 'asc') : ''}}"></view>
    </view>
    <view class="sort-item {{orderBy === 'stock' ? 'active' : ''}}" bindtap="changeOrderBy" data-orderby="stock">
      库存
      <view class="sort-icon {{orderBy === 'stock' ? (orderDirection === 'desc' ? 'desc' : 'asc') : ''}}"></view>
    </view>
  </view>
  
  <!-- 骨架屏加载状态 -->
  <view class="skeleton-list" wx:if="{{isLoading && page === 1}}">
    <view class="skeleton-item" wx:for="{{[1,2,3,4]}}" wx:key="*this">
      <view class="skeleton-thumb"></view>
      <view class="skeleton-content">
        <view>
          <view class="skeleton-row long"></view>
          <view class="skeleton-row medium"></view>
        </view>
        <view>
          <view class="skeleton-row short"></view>
          <view class="skeleton-row short"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 产品列表 -->
  <view class="product-list" wx:else>
    <t-empty wx:if="{{products.length === 0 && !isLoading}}" description="暂无相关商品" icon="info-circle-filled" />
    
    <block wx:else>
      <view class="product-item" wx:for="{{products}}" wx:key="id" bindtap="editProduct" data-id="{{item.id}}">
        <view class="product-thumb">
          <image src="{{item.thumb}}" mode="aspectFill" lazy-load></image>
          <view class="product-status {{item.status === 1 ? 'status-on' : 'status-off'}}">
            {{item.status === 1 ? '已上架' : '已下架'}}
          </view>
        </view>
        
        <view class="product-info">
          <view class="product-header">
            <view class="product-name">{{item.name}}</view>
            <view class="product-tags">
              <view class="product-category">{{item.categoryName || '未分类'}}</view>
            </view>
          </view>
          
          <view class="product-meta">
            <view class="product-price">
              <text class="currency">¥</text>{{item.price}}
            </view>
            <text class="original-price" wx:if="{{item.originalPrice > item.price}}">¥{{item.originalPrice}}</text>
          </view>
          
          <view class="product-stats">
            <text>销量 {{item.sales}}</text>
            <text>库存 {{item.stock}}</text>
          </view>
          
          <view class="product-actions" catchtap="return">
            <t-button size="small" theme="default" variant="outline" shape="round" catchtap="editProduct" data-id="{{item.id}}">编辑</t-button>
            <t-button size="small" theme="{{item.status === 1 ? 'danger' : 'primary'}}" variant="outline" shape="round" catchtap="toggleProductStatus" data-id="{{item.id}}" data-status="{{item.status}}">
              {{item.status === 1 ? '下架' : '上架'}}
            </t-button>
            <t-button size="small" theme="danger" variant="text" catchtap="deleteProduct" data-id="{{item.id}}">删除</t-button>
          </view>
        </view>
      </view>
      
      <!-- 加载更多 -->
      <view class="load-more" wx:if="{{isLoading && page > 1}}">
        <view class="loading-spinner"></view>
        <text>正在加载更多...</text>
      </view>
      <view class="no-more" wx:if="{{!hasMore && products.length > 0}}">
        - 到底了 -
      </view>
    </block>
  </view>
  
  <!-- 分类选择弹窗 -->
  <view class="filter-mask" wx:if="{{categoryVisible}}" catchtap="onPickerCancel"></view>
  <view class="filter-drawer" wx:if="{{categoryVisible}}" catchtouchmove="true">
    <view class="filter-panel">
      <view class="filter-header">
        <text>选择分类</text>
        <t-icon name="close" size="20" bindtap="onPickerCancel"></t-icon>
      </view>
      <view class="filter-content">
        <view class="category-list">
          <view
            class="category-item {{selectedCategoryId === '' ? 'active' : ''}}"
            bindtap="onSelectCategory"
            data-value=""
            data-label="全部分类"
          >
            <text>全部分类</text>
            <t-icon wx:if="{{selectedCategoryId === ''}}" name="check" color="var(--primary-color)"/>
          </view>
          <view
            wx:for="{{categories}}"
            wx:key="id"
            class="category-item {{selectedCategoryId === item._id ? 'active' : ''}}"
            bindtap="onSelectCategory"
            data-value="{{item._id}}"
            data-label="{{item.name}}"
          >
            <text>{{item.name}}</text>
            <t-icon wx:if="{{selectedCategoryId === item._id}}" name="check" color="var(--primary-color)"/>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
