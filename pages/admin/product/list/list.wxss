.admin-products-container {
  padding: 24rpx;
  background-color: #f7f8fa;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 头部样式 */
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0 30rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a1a1a;
  letter-spacing: -1rpx;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
}

/* 搜索区域 */
.search-container {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 20rpx;
  background: #fff;
  padding: 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.02);
}

.search-container t-search {
  flex: 1;
}

.category-dropdown {
  width: 220rpx;
}

.category-dropdown t-dropdown-menu {
  background: transparent;
}

.category-dropdown .t-dropdown-menu__item {
  background: #f2f3f5;
  border-radius: 12rpx;
  height: 80rpx;
  padding: 0 24rpx;
}

/* 排序选项 */
.sort-options {
  display: flex;
  background: #fff;
  padding: 8rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.02);
}

.sort-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.sort-item.active {
  color: #0052d9;
  font-weight: 600;
  background-color: rgba(0, 82, 217, 0.05);
}

.sort-icon {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  margin-left: 8rpx;
  opacity: 0.3;
  transition: all 0.3s;
}

.sort-item.active .sort-icon {
  opacity: 1;
}

.sort-icon.asc {
  border-bottom: 10rpx solid currentColor;
}

.sort-icon.desc {
  border-top: 10rpx solid currentColor;
}

/* 产品列表 */
.product-list {
  padding-bottom: 40rpx;
}

.product-item {
  display: flex;
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  padding: 24rpx;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
  overflow: hidden;
}

.product-item:active {
  transform: scale(0.995);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.product-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-right: 24rpx;
  position: relative;
  background-color: #f2f3f5;
  flex-shrink: 0;
}

.product-thumb image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.product-item:active .product-thumb image {
  transform: scale(1.05);
}

.product-status {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
  border-radius: 8rpx;
  backdrop-filter: blur(4px);
  z-index: 1;
}

.status-on {
  background-color: rgba(7, 193, 96, 0.9);
}

.status-off {
  background-color: rgba(0, 0, 0, 0.5);
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0; /* 防止文本溢出 */
}

.product-header {
  margin-bottom: 12rpx;
}

.product-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.product-category {
  font-size: 22rpx;
  color: #0052d9;
  background: rgba(0, 82, 217, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.product-meta {
  display: flex;
  align-items: baseline;
  margin-top: auto;
  margin-bottom: 16rpx;
}

.product-price {
  font-size: 40rpx;
  color: #fa5151;
  font-weight: 800;
  margin-right: 12rpx;
  display: flex;
  align-items: baseline;
}

.currency {
  font-size: 24rpx;
  margin-right: 4rpx;
}

.original-price {
  font-size: 24rpx;
  color: #bbb;
  text-decoration: line-through;
}

.product-stats {
  font-size: 24rpx;
  color: #999;
  display: flex;
  gap: 20rpx;
}

.product-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  border-top: 1rpx solid #f5f5f5;
  padding-top: 20rpx;
  margin-top: 20rpx;
}

/* 骨架屏样式 */
.skeleton-list {
  padding-bottom: 30rpx;
}

.skeleton-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
}

.skeleton-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #f2f3f5;
  margin-right: 24rpx;
  animation: skeleton-blink 1.5s infinite ease-in-out;
}

.skeleton-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.skeleton-row {
  height: 32rpx;
  background: #f2f3f5;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  animation: skeleton-blink 1.5s infinite ease-in-out;
}

.skeleton-row.short {
  width: 40%;
}

.skeleton-row.medium {
  width: 70%;
}

.skeleton-row.long {
  width: 90%;
}

@keyframes skeleton-blink {
  0% { opacity: 0.6; }
  50% { opacity: 1; }
  100% { opacity: 0.6; }
}

/* 加载更多 */
.load-more, .no-more {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 30rpx 0;
}

.loading-spinner {
  display: inline-block;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #0052d9;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 12rpx;
  vertical-align: middle;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}