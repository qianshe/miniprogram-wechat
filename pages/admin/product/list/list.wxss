.admin-products-container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
}

.scan-btn {
  background-color: #2196f3;
  color: #fff;
  font-size: 28rpx;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  line-height: 1.5;
  margin-right: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(33, 150, 243, 0.3);
}

.create-btn {
  background-color: var(--primary-color);
  color: #fff;
  font-size: 28rpx;
  padding: 12rpx 32rpx;
  border-radius: 30rpx;
  line-height: 1.5;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.search-container {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 20rpx;
}

.search-container t-search {
  flex: 1;
}

.category-dropdown {
  width: 200rpx;
  margin-left: 20rpx;
}

.category-dropdown t-dropdown-menu {
  background: transparent;
}

.category-dropdown .t-dropdown-menu__item {
  background: #fff;
  border-radius: 40rpx;
  height: 80rpx;
  padding: 0 20rpx;
  box-shadow: var(--shadow-sm);
}

/* 排序选项优化 */
.sort-options {
  display: flex;
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.sort-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.sort-item.active {
  color: #07c160;
  font-weight: bold;
  background-color: #e8f5e9;
  border-radius: 8rpx;
  padding: 10rpx 0;
}

.sort-icon {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  margin-left: 8rpx;
}

.sort-icon.asc {
  border-bottom: 10rpx solid #07c160;
}

.sort-icon.desc {
  border-top: 10rpx solid #07c160;
}

/* 产品列表样式优化 */
.product-list {
  padding-bottom: 30rpx;
}

.loading, .empty {
  text-align: center;
  padding: 100rpx 0;
  color: var(--text-sub);
  font-size: 28rpx;
}

.product-item {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  position: relative;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s;
}

.product-item:active {
  transform: scale(0.99);
}

.product-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 8rpx;
  overflow: hidden;
  margin-right: 20rpx;
  position: relative;
  background-color: #f0f0f0;
}

.product-thumb image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-status {
  position: absolute;
  top: 0;
  left: 0;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  color: #fff;
  border-bottom-right-radius: 8rpx;
}

.status-on {
  background-color: #07c160;
}

.status-off {
  background-color: #999;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  line-height: 1.4;
}

.product-category {
  font-size: 24rpx;
  color: #999;
  background: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  align-self: flex-start;
  margin-bottom: 12rpx;
}

.product-price {
  font-size: 36rpx;
  color: #fa5151;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.original-price {
  font-size: 24rpx;
  color: var(--text-sub);
  text-decoration: line-through;
}

.product-sales {
  font-size: 24rpx;
  color: #999;
}

.product-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
}

.load-more, .no-more {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 20rpx 0;
}