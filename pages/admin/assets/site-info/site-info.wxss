.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 32rpx;
  box-sizing: border-box;
}

.header {
  margin-bottom: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
}

.loading-wrap {
  display: flex;
  justify-content: center;
  padding-top: 120rpx;
}

.card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 32rpx;
}

.field {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.field:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.field-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 4rpx;
}

.field-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.field-input {
  width: 100%;
  height: 72rpx;
  background: #f8f8f8;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.footer {
  margin-top: 8rpx;
}
