.container {
  padding-bottom: 140rpx;
  background: var(--bg-color);
  min-height: 100vh;
  padding: 20rpx;
}

.address-section {
  background: #fff;
  padding: 32rpx;
  margin-bottom: 24rpx;
  position: relative;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 白事系统地址样式 */
.white-theme .address-section {
  border-left: 8rpx solid var(--primary-color);
}

/* 红事系统地址样式 */
.red-theme .address-section {
  border-left: 8rpx solid var(--danger-color);
}

.address-info {
  flex: 1;
  padding-right: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.user-info text {
  margin-right: 24rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main);
}

.address-detail {
  color: var(--text-sub);
  font-size: 26rpx;
  line-height: 1.4;
}

.no-address {
  color: var(--text-sub);
  font-size: 28rpx;
}

.arrow {
  color: #ccc;
  font-size: 32rpx;
}

.goods-list {
  background: #fff;
  padding: 0 32rpx;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
}

.goods-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-image {
  width: 140rpx;
  height: 140rpx;
  margin-right: 24rpx;
  border-radius: 12rpx;
  background: #f8f8f8;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.goods-name {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
  margin-bottom: 8rpx;
}

.goods-price-quantity {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-price {
  font-weight: bold;
  font-size: 30rpx;
  color: var(--text-main);
}

.goods-quantity {
  color: var(--text-sub);
  font-size: 26rpx;
}

.remarks-section {
  background: #fff;
  padding: 32rpx;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
}

.remarks-label {
  font-size: 28rpx;
  color: var(--text-main);
  margin-right: 20rpx;
  font-weight: 500;
}

.remarks-section input {
  flex: 1;
  height: 60rpx;
  font-size: 28rpx;
  color: var(--text-main);
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.total-amount {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
}

.amount {
  font-weight: bold;
  font-size: 36rpx;
  color: var(--danger-color);
  margin-left: 10rpx;
}

.submit-btn {
  width: 240rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  color: #fff;
  border-radius: 40rpx;
  margin: 0;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.15);
  transition: all 0.3s;
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.1);
}

/* 白事系统提交按钮 */
.white-theme .submit-btn {
  background: var(--primary-color);
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
}

/* 红事系统提交按钮 */
.red-theme .submit-btn {
  background: var(--danger-color);
  box-shadow: 0 8rpx 20rpx rgba(244, 67, 54, 0.3);
}

.submit-btn[disabled] {
  background: #ccc;
  box-shadow: none;
}
