<view class="container">
  <c-confirm-address-sheet
    address="{{address}}"
    address-list="{{addressList}}"
    visible="{{showAddressModal}}"
    selected-address-id="{{selectedAddressId}}"
    bindopen="selectAddress"
    bindclose="hideAddressModal"
    bindselect="onConfirmAddressSelect"
    bindwechat="useWechatAddress"
    bindmanage="goToAddressManage"
  ></c-confirm-address-sheet>

  <c-confirm-item-list
    count-text="共{{orderItems.length}}项"
    items="{{confirmItemRows}}"
  ></c-confirm-item-list>

  <c-confirm-form-card title="服务时间" compact="{{true}}">
    <picker mode="date" value="{{serviceTime}}" bindchange="onServiceTimeChange">
      <view class="confirm-field plain-field {{serviceTime ? 'has-value' : ''}}">{{serviceTime || '请选择服务时间'}}</view>
    </picker>
  </c-confirm-form-card>

  <c-confirm-price-summary rows="{{priceSummaryRows}}"></c-confirm-price-summary>

  <c-confirm-form-card title="订单备注" custom-class="remarks-card">
    <input 
      class="remarks-input"
      type="text" 
      placeholder="请输入订单备注" 
      value="{{remarks}}"
      bindinput="onRemarksChange"
    />
  </c-confirm-form-card>

  <view class="disclaimer-text">本小程序仅用于展示与需求登记，最终以电话/微信沟通及线下结算为准。</view>

  <view class="bottom-placeholder"></view>

  <!-- 底部结算栏 -->
  <view class="footer">
    <view class="total-amount">
      合计：<text class="amount">¥{{totalAmount}}</text>
    </view>
    <button 
      class="submit-btn" 
      bindtap="submitOrder" 
      loading="{{loading}}"
      disabled="{{loading}}"
    >
      提交意向单
    </button>
  </view>
</view>
