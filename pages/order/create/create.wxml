<wxs src="../../../utils/tools.wxs" module="tools" />
<!--pages/create-order/create-order.wxml-->
<view class="create-order-container">
  <!-- 订单信息 -->
  <t-cell-group title="订单信息">
    <t-cell title="客户名称" arrow>
      <t-input slot="note" placeholder="请输入客户名称" bind:change="onCustomerNameChange" value="{{customerName}}" />
    </t-cell>
    <t-cell title="联系电话" arrow>
      <t-input slot="note" placeholder="请输入联系电话" bind:change="onPhoneChange" value="{{phone}}" type="number" />
    </t-cell>
    <t-cell title="选择商品" arrow bindtap="showProductSelector" />
  </t-cell-group>

  <view class="product-list" wx:if="{{selectedProducts.length}}">
    <view class="product-item" wx:for="{{selectedProducts}}" wx:key="id">
      <text class="product-name">{{item.name}}</text>
      <view class="quantity-control">
        <button class="quantity-btn" bindtap="decreaseQuantity" data-index="{{index}}">-</button>
        <text class="quantity-text">{{item.quantity}}</text>
        <button class="quantity-btn" bindtap="increaseQuantity" data-index="{{index}}">+</button>
      </view>
      <text class="product-price">￥{{tools.formatPrice(item.price * item.quantity)}}</text>
      <button class="remove-btn" bindtap="removeProduct" data-index="{{index}}">×</button>
    </view>
  </view>

  <!-- 调试输出框 -->
  <view class="debug-box" wx:if="{{debugText}}">
    <view class="debug-header">
      <text class="debug-title">调试输出:</text>
      <button class="copy-btn" bindtap="copyDebugText">复制</button>
    </view>
    <text class="debug-content" selectable="true">{{debugText}}</text>
  </view>

  <!-- 底部固定按钮 -->
  <view class="bottom-bar">
    <button class="voice-btn" bindtap="startVoiceInput">🎤 语音</button>
    <view class="total-amount">
      <text>合计：</text>
      <text class="amount">￥{{totalAmount}}</text>
    </view>
    <button class="create-btn" bindtap="createOrder">创建订单</button>
  </view>
</view>

<!-- 商品选择弹出层 -->
<t-popup visible="{{showProductSelector}}" placement="bottom" bind:visible-change="onPopupChange">
  <view class="popup-content">
    <view class="popup-header">
      <text class="popup-title">选择商品</text>
      <t-button variant="text" bindtap="hideProductSelector">×</t-button>
    </view>
    <view class="search-container">
      <view class="search-box">
        <input
          class="search-input"
          type="text"
          placeholder="搜索商品"
          value="{{searchValue}}"
          bindinput="onSearchChange"
          confirm-type="search"
        />
        <view class="search-icon" wx:if="{{searchValue}}" bindtap="onSearchClear">
          <text class="search-icon-text">×</text>
        </view>
      </view>
    </view>
    <scroll-view
      scroll-y
      class="product-scroll"
      bindscrolltolower="onLoadMoreProducts"
    >
      <block wx:if="{{filteredProducts.length > 0}}">
        <view class="product-option"
              wx:for="{{filteredProducts}}"
              wx:key="id"
              bindtap="selectProduct"
              data-product="{{item}}">
          <text class="product-name">{{item.name}}</text>
          <text class="product-price">¥{{item.price}}</text>
        </view>
      </block>
      <view class="loading-tips" wx:if="{{productsLoading}}">加载中...</view>
      <view class="no-more-tips" wx:elif="{{!productsPagination.hasMore && filteredProducts.length > 0}}">
        没有更多了
      </view>
      <view class="empty-tips" wx:elif="{{!productsLoading && filteredProducts.length === 0}}">
        暂无商品
      </view>
    </scroll-view>
  </view>
</t-popup>
