<view class="order-detail {{systemType}}-theme">
  <view class="loading" wx:if="{{loading}}">加载中...</view>
  <block wx:elif="{{orderInfo}}">
    <!-- 状态栏 -->
    <view class="status-bar {{systemType}}-status-{{orderInfo.status}}">
      <text class="status">{{orderInfo.statusText}}</text>
      <view class="status-desc">{{orderInfo.statusDesc}}</view>
    </view>

    <!-- 状态时间线 -->
    <view class="timeline">
      <view class="timeline-item {{orderInfo.status >= 0 ? (orderInfo.status === 0 ? 'current' : 'active') : ''}}">
        <view class="timeline-dot"></view>
        <text class="timeline-text">下单</text>
        <text class="timeline-time">{{orderInfo.timelineCreatedTime || ''}}</text>
      </view>
      <view class="timeline-line {{orderInfo.status >= 1 ? 'active' : ''}}"></view>
      <view class="timeline-item {{orderInfo.status >= 1 ? (orderInfo.status === 1 ? 'current' : 'active') : ''}}">
        <view class="timeline-dot"></view>
        <text class="timeline-text">支付</text>
        <text class="timeline-time">{{orderInfo.status >= 1 ? (orderInfo.timelinePayTime || '-') : ''}}</text>
      </view>
      <view class="timeline-line {{orderInfo.status >= 2 && orderInfo.status !== 4 ? 'active' : ''}}"></view>
      <view class="timeline-item {{orderInfo.status >= 2 && orderInfo.status !== 4 ? (orderInfo.status === 2 ? 'current' : 'active') : ''}}">
        <view class="timeline-dot"></view>
        <text class="timeline-text">服务中</text>
        <text class="timeline-time">{{orderInfo.status >= 2 && orderInfo.status !== 4 ? (orderInfo.timelineProcessTime || '-') : ''}}</text>
      </view>
      <view class="timeline-line {{orderInfo.status >= 3 && orderInfo.status !== 4 ? 'active' : ''}}"></view>
      <view class="timeline-item {{orderInfo.status >= 3 && orderInfo.status !== 4 ? 'active' : ''}}">
        <view class="timeline-dot"></view>
        <text class="timeline-text">完成</text>
        <text class="timeline-time">{{orderInfo.status >= 3 && orderInfo.status !== 4 ? (orderInfo.timelineCompleteTime || '-') : ''}}</text>
      </view>
    </view>

    <view class="section">
      <view class="section-title">基本信息</view>
      <view class="info-item">
        <text class="label">订单编号</text>
        <view class="value-with-action">
          <text class="value">{{orderInfo.orderNo}}</text>
          <t-button size="small" theme="default" bindtap="copyOrderNo">复制</t-button>
        </view>
      </view>
      <view class="info-item">
        <text class="label">下单时间</text>
        <text class="value">{{orderInfo.createdTime}}</text>
      </view>
      <view class="info-item">
        <text class="label">服务时间</text>
        <text class="value">{{orderInfo.serviceTime}}</text>
      </view>
    </view>

    <view class="section">
      <view class="section-title">联系信息</view>
      <view class="info-item">
        <text class="label">联系人</text>
        <text class="value">{{orderInfo.contactName}}</text>
      </view>
      <view class="info-item">
        <text class="label">联系电话</text>
        <view class="value-with-action">
          <text class="value">{{orderInfo.contactPhone}}</text>
          <t-button size="small" theme="primary" bindtap="callPhone">拨打</t-button>
        </view>
      </view>
      <view class="info-item">
        <text class="label">服务地址</text>
        <view class="value-with-action">
          <text class="value address">{{orderInfo.address}}</text>
          <t-button size="small" theme="default" bindtap="viewLocation" wx:if="{{orderInfo.latitude && orderInfo.longitude}}">查看</t-button>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">商品信息</view>
      <view class="goods-list">
        <view class="goods-item" wx:for="{{orderInfo.items}}" wx:key="productId">
          <image class="goods-image" src="{{item.productImage || '/assets/images/default-product.png'}}" mode="aspectFill"></image>
          <view class="goods-info">
            <text class="goods-name">{{item.productName}}</text>
            <view class="goods-price-row">
              <text class="goods-price">¥{{item.productPrice}}</text>
              <text class="quantity">x{{item.quantity}}</text>
            </view>
          </view>
          <text class="subtotal">¥{{item.subtotal}}</text>
        </view>
      </view>
      <view class="price-summary">
        <view class="price-item">
          <text>商品金额</text>
          <text>¥{{orderInfo.totalAmount}}</text>
        </view>
        <view class="price-item" wx:if="{{orderInfo.discountAmount > 0}}">
          <text>优惠金额</text>
          <text class="discount">-¥{{getFormattedDiscountAmount()}}</text>
        </view>
        <view class="price-item total">
          <text>实付金额</text>
          <text class="total-amount {{systemType}}-color">¥{{orderInfo.totalAmount}}</text>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{orderInfo.remark}}">
      <view class="section-title">备注</view>
      <view class="remark">{{orderInfo.remark}}</view>
    </view>

    <view class="actions">
      <!-- 管理员按钮 -->
      <block wx:if="{{isAdmin}}">
        <!-- 待支付(0): 下一步, 取消订单 -->
        <block wx:if="{{orderInfo.status === 0}}">
          <t-button theme="default" class="btn-secondary" bindtap="handleAdminCancel">取消订单</t-button>
          <t-button theme="primary" class="btn-primary" bindtap="handleNextStep">下一步</t-button>
        </block>
        <!-- 已支付(1): 上一步, 下一步, 取消订单 -->
        <block wx:elif="{{orderInfo.status === 1}}">
          <t-button theme="default" class="btn-secondary" bindtap="handlePrevStep">上一步</t-button>
          <t-button theme="default" class="btn-secondary" bindtap="handleAdminCancel">取消订单</t-button>
          <t-button theme="primary" class="btn-primary" bindtap="handleNextStep">下一步</t-button>
        </block>
        <!-- 处理中(2): 上一步, 下一步, 取消订单 -->
        <block wx:elif="{{orderInfo.status === 2}}">
          <t-button theme="default" class="btn-secondary" bindtap="handlePrevStep">上一步</t-button>
          <t-button theme="default" class="btn-secondary" bindtap="handleAdminCancel">取消订单</t-button>
          <t-button theme="primary" class="btn-primary" bindtap="handleNextStep">下一步</t-button>
        </block>
        <!-- 已完成(3): 上一步 -->
        <block wx:elif="{{orderInfo.status === 3}}">
          <t-button theme="default" class="btn-secondary" bindtap="handlePrevStep">上一步</t-button>
        </block>
        <!-- 已取消(4): 无按钮 -->
      </block>
      <!-- 普通用户按钮 -->
      <block wx:else>
        <block wx:if="{{orderInfo.status === 0}}">
          <t-button theme="default" bindtap="handleCancel">取消订单</t-button>
          <t-button theme="primary" bindtap="handlePay">立即支付</t-button>
        </block>
        <block wx:elif="{{orderInfo.status === 1 || orderInfo.status === 2}}">
          <t-button theme="danger" bindtap="applyRefund">申请退款</t-button>
        </block>
        <block wx:elif="{{orderInfo.status === 3 || orderInfo.status === 4}}">
          <t-button theme="default" bindtap="deleteOrder">删除订单</t-button>
          <t-button theme="primary" bindtap="rebuyOrder">再次购买</t-button>
        </block>
      </block>
    </view>
  </block>
  <t-empty wx:else description="订单不存在">
    <t-button theme="primary" bindtap="goBack">返回列表</t-button>
  </t-empty>
</view>
