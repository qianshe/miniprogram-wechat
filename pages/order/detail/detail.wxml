<view class="order-detail {{systemType}}-theme">
  <view class="loading" wx:if="{{loading}}">加载中...</view>
  <block wx:elif="{{orderInfo}}">
    <!-- 状态栏 -->
    <view class="status-bar {{systemType}}-status-{{orderInfo.orderStatus}}">
      <text class="status">{{orderInfo.displayStatusText}}</text>
      <view class="status-desc">{{orderInfo.flowStatusDesc || orderInfo.statusDesc}}</view>
    </view>

    <!-- 双状态标签（管理端显示） -->
    <view class="order-status-section" wx:if="{{isAdmin}}">
      <view class="status-label">订单状态</view>
      <view class="status-tags">
        <view class="status-tag flow-status-{{orderInfo.orderStatus}}">{{orderInfo.orderStatusText}}</view>
        <view wx:if="{{orderInfo.showPaymentStatusTag}}" class="status-tag payment-status-{{orderInfo.paymentStatus}}">{{orderInfo.paymentStatusText}}</view>
      </view>
    </view>

    <!-- 状态时间线（基于双字段状态系统：orderStatus + paymentStatus） -->
    <view class="timeline">
      <view class="timeline-item {{orderInfo.orderStatus === 0 && orderInfo.paymentStatus === 0 ? 'current' : 'active'}}">
        <view class="timeline-dot"></view>
        <text class="timeline-text">下单</text>
        <text class="timeline-time">{{orderInfo.timelineCreatedTime || ''}}</text>
      </view>
      <view class="timeline-line {{orderInfo.paymentStatus === 1 || orderInfo.orderStatus >= 1 ? 'active' : ''}}"></view>
      <view class="timeline-item {{orderInfo.paymentStatus === 1 ? (orderInfo.orderStatus === 0 ? 'current' : 'active') : ''}}">
        <view class="timeline-dot"></view>
        <text class="timeline-text">收款确认</text>
        <text class="timeline-time">{{orderInfo.paymentStatus === 1 ? (orderInfo.timelinePayTime || '-') : ''}}</text>
      </view>
      <view class="timeline-line {{orderInfo.orderStatus >= 1 && orderInfo.orderStatus !== 4 ? 'active' : ''}}"></view>
      <view class="timeline-item {{orderInfo.orderStatus >= 1 && orderInfo.orderStatus !== 4 ? (orderInfo.orderStatus === 1 ? 'current' : 'active') : ''}}">
        <view class="timeline-dot"></view>
        <text class="timeline-text">{{orderInfo.orderStatus === 2 ? '服务完成' : '服务中'}}</text>
        <text class="timeline-time">{{orderInfo.orderStatus >= 1 && orderInfo.orderStatus !== 4 ? (orderInfo.timelineProcessTime || '-') : ''}}</text>
      </view>
      <view class="timeline-line {{orderInfo.orderStatus >= 3 && orderInfo.orderStatus !== 4 ? 'active' : ''}}"></view>
      <view class="timeline-item {{orderInfo.orderStatus === 3 ? 'active' : ''}}">
        <view class="timeline-dot"></view>
        <text class="timeline-text">完成</text>
        <text class="timeline-time">{{orderInfo.orderStatus === 3 ? (orderInfo.timelineCompleteTime || '-') : ''}}</text>
      </view>
    </view>

    <view class="section">
      <view class="section-title">基本信息</view>
      <view class="info-item info-item--center">
        <text class="label">订单编号</text>
        <view class="value-with-action value-with-action--center-btn">
          <text class="value">{{orderInfo.orderNo}}</text>
          <t-button size="small" theme="default" bindtap="copyOrderNo">复制</t-button>
        </view>
      </view>
      <view class="info-item">
        <text class="label">下单时间</text>
        <text class="value">{{orderInfo.createdTime}}</text>
      </view>
      <view class="info-item">
        <text class="label">服务时间</text>
        <text class="value">{{orderInfo.serviceTime}}</text>
      </view>
    </view>

    <view class="section">
      <view class="section-title">联系信息</view>
      <view class="info-item">
        <text class="label">联系人</text>
        <text class="value">{{orderInfo.contactName}}</text>
      </view>
      <view class="info-item info-item--center">
        <text class="label">联系电话</text>
        <view class="value-with-action value-with-action--center-btn">
          <text class="value">{{orderInfo.contactPhone}}</text>
          <t-button
            wx:if="{{isAdmin && orderInfo.contactPhone}}"
            size="small"
            theme="default"
            bindtap="handleCallContact"
          >拨打</t-button>
        </view>
      </view>
      <view class="info-item">
        <text class="label">服务地址</text>
        <view class="value-with-action">
          <text class="value address">{{orderInfo.address}}</text>
          <t-button size="small" theme="default" bindtap="viewLocation" wx:if="{{orderInfo.latitude && orderInfo.longitude}}">查看</t-button>
        </view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">商品信息</view>
      <!-- 原始商品 -->
      <view class="goods-list" wx:if="{{orderInfo.originalItems.length > 0}}">
        <view class="goods-item" wx:for="{{orderInfo.originalItems}}" wx:key="productId">
          <image class="goods-image" src="{{item.productImage || '/assets/images/default-product.png'}}" mode="aspectFill"></image>
          <view class="goods-info">
            <text class="goods-name">{{item.productName}}</text>
            <view class="goods-price-row">
              <text class="goods-price">¥{{item.productPrice}}</text>
              <text class="goods-quantity">×{{item.quantity}}</text>
            </view>
          </view>
          <text class="subtotal">¥{{item.subtotal}}</text>
        </view>
      </view>
      <!-- 原始商品小计 -->
      <view class="goods-section-subtotal" wx:if="{{orderInfo.appendedItems.length > 0 && orderInfo.originalItems.length > 0}}">
        <text class="subtotal-label">原始商品小计</text>
        <text class="subtotal-value">¥{{orderInfo.originalSubtotal}}</text>
      </view>

      <!-- 追加商品 -->
      <view class="appended-section" wx:if="{{orderInfo.appendedItems.length > 0}}">
        <view class="appended-header">
          <text class="appended-title">追加商品</text>
          <text class="appended-badge">+{{orderInfo.appendedItems.length}}项</text>
        </view>
        <view class="goods-list appended-goods-list">
          <view class="goods-item appended-item" wx:for="{{orderInfo.appendedItems}}" wx:key="productId">
            <image class="goods-image" src="{{item.productImage || '/assets/images/default-product.png'}}" mode="aspectFill"></image>
            <view class="goods-info">
              <view class="goods-name-row">
                <text class="goods-name">{{item.productName}}</text>
              </view>
              <view class="goods-price-row">
                <text class="goods-price">¥{{item.productPrice}}</text>
                <text class="goods-quantity">×{{item.quantity}}</text>
              </view>
              <text class="appended-time">追加于 {{item.appendedTime}}</text>
            </view>
            <text class="subtotal">¥{{item.subtotal}}</text>
          </view>
        </view>
        <!-- 追加商品小计 -->
        <view class="goods-section-subtotal">
          <text class="subtotal-label">追加商品小计</text>
          <text class="subtotal-value">¥{{orderInfo.appendedSubtotal}}</text>
        </view>
      </view>

      <view class="price-summary">
        <view class="price-item">
          <text>商品金额</text>
          <text>¥{{orderInfo.totalAmount}}</text>
        </view>
        <view class="price-item" wx:if="{{orderInfo.discountAmount > 0}}">
          <text>优惠金额</text>
          <text class="discount">-¥{{getFormattedDiscountAmount()}}</text>
        </view>
        <view class="price-item total">
          <text>实付金额</text>
          <text class="total-amount {{systemType}}-color">¥{{orderInfo.totalAmount}}</text>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{orderInfo.remark}}">
      <view class="section-title">备注</view>
      <view class="remark">{{orderInfo.remark}}</view>
    </view>

    <!-- 用户端状态提示（放在内容流中，避免撑高底部固定栏） -->
    <view wx:if="{{!isAdmin && orderInfo.orderStatus < 3}}" class="section section-compact status-tip-section">
      <view class="user-status-tip user-status-tip-inline">
        <text wx:if="{{orderInfo.orderStatus === 0 && orderInfo.paymentStatus === 0}}">订单已提交，请联系工作人员安排服务；费用可在线下于服务前或服务后支付。</text>
        <text wx:if="{{orderInfo.orderStatus === 0 && orderInfo.paymentStatus === 1}}">订单已确认收款，等待工作人员安排服务。</text>
        <text wx:if="{{orderInfo.orderStatus === 1 && orderInfo.paymentStatus === 0}}">服务进行中，如尚未付款，可在线下支付，待管理员确认收款后生效。</text>
        <text wx:if="{{orderInfo.orderStatus === 1 && orderInfo.paymentStatus === 1}}">服务进行中，请耐心等待...</text>
        <text wx:if="{{orderInfo.orderStatus === 2 && orderInfo.paymentStatus === 0}}">服务已完成，请线下支付尾款；管理员确认收款后订单才会完成。</text>
        <text wx:if="{{orderInfo.orderStatus === 2 && orderInfo.paymentStatus === 1}}">服务已完成，已确认收款。</text>
      </view>
    </view>

    <view class="actions">
      <!-- 管理员按钮（双字段状态系统） -->
      <block wx:if="{{isAdmin}}">
        <!-- 开始处理：仅 CREATED 状态可用 -->
        <t-button wx:if="{{showStartProcessingBtn}}" theme="primary" class="btn-primary" bindtap="handleStartProcessing">开始处理</t-button>
        <!-- 标记服务完成：仅 PROCESSING 状态可用 -->
        <t-button wx:if="{{showMarkServiceDoneBtn}}" theme="primary" class="btn-primary" bindtap="handleMarkServiceDone">标记服务完成</t-button>
        <!-- 确认收款：未支付且订单未完成/未取消时可用 -->
        <t-button wx:if="{{showConfirmPaymentBtn}}" theme="success" class="btn-success" bindtap="handleConfirmPaymentNew">确认收款</t-button>
        <!-- 追加商品：未支付 且 服务未完成 -->
        <t-button wx:if="{{showAppendItemsBtn}}" theme="default" class="btn-append" bindtap="handleAppendItems">追加商品</t-button>
        <!-- 取消订单：仅 CREATED 或 PROCESSING 状态可用 -->
        <t-button wx:if="{{showCancelBtn}}" theme="danger" class="btn-danger" bindtap="handleCancelOrderNew">取消订单</t-button>
        <!-- 无操作提示：已完成或已取消 -->
        <view wx:if="{{showNoActionTip}}" class="no-action-tip">订单已结束，无可用操作</view>
      </block>
      <!-- 用户端操作按钮（双字段状态系统） -->
      <view class="user-action-buttons" wx:if="{{!isAdmin}}">
        <!-- 取消订单按钮 -->
        <t-button wx:if="{{showUserCancelBtn}}"
                  theme="default"
                  class="btn-cancel-light"
                  bindtap="handleUserCancelOrder">
          取消订单
        </t-button>
        
        <!-- 追加商品按钮 -->
        <t-button wx:if="{{showAppendItemsBtn}}"
                  theme="primary"
                  class="btn-append"
                  bindtap="handleAppendItems">
          追加商品
        </t-button>
        
        <!-- 订单结束状态 -->
        <view wx:if="{{orderInfo.orderStatus >= 3}}" class="ended-actions">
          <t-button theme="default" class="btn-delete" bindtap="deleteOrder">删除订单</t-button>
          <t-button theme="primary" class="btn-rebuy" bindtap="rebuyOrder" wx:if="{{orderInfo.orderStatus === 3}}">再次购买</t-button>
        </view>
      </view>
    </view>
  </block>
  <t-empty wx:else description="订单不存在">
    <t-button theme="primary" bindtap="goBack">返回列表</t-button>
  </t-empty>
</view>