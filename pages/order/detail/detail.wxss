.container {
  padding-bottom: 150rpx;
  background: var(--bg-color);
  min-height: 100vh;
}

.order-detail {
  padding: 20rpx;
  padding-bottom: 200rpx;
}

/* 状态栏 */
.status-bar {
  padding: 40rpx 32rpx;
  color: #fff;
  border-radius: var(--border-radius);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-md);
  position: relative;
  overflow: hidden;
}

.status {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.status-desc {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 白事系统状态栏 */
.white-theme .status-bar {
  background: linear-gradient(135deg, var(--primary-color), #05a050);
}

/* 红事系统状态栏 */
.red-theme .status-bar {
  background: linear-gradient(135deg, var(--danger-color), #b71c1c);
}

/* 时间线 */
.timeline {
  display: flex;
  align-items: flex-start;
  padding: 40rpx 30rpx;
  background: #fff;
  border-radius: var(--border-radius);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.timeline-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  position: relative;
  color: var(--text-sub);
}

.timeline-item.active {
  color: #07c160;
  font-weight: 500;
}

.timeline-item.current {
  color: #fa8c16;
  font-weight: 500;
}

.timeline-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #e0e0e0;
  margin-bottom: 16rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 2rpx #e0e0e0;
}

.timeline-item.active .timeline-dot {
  background: #07c160;
  box-shadow: 0 0 0 2rpx #07c160;
}

.timeline-item.current .timeline-dot {
  background: #fa8c16;
  box-shadow: 0 0 0 2rpx #fa8c16;
}

.timeline-text {
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.timeline-time {
  font-size: 20rpx;
  color: var(--text-sub);
  font-weight: normal;
  min-height: 28rpx;
  line-height: 28rpx;
}

.timeline-line {
  flex: 1;
  height: 4rpx;
  background: #e0e0e0;
  margin: 0 4rpx;
  margin-top: 14rpx;
  border-radius: 2rpx;
}

.timeline-line.active {
  background: #07c160;
}

/* 信息区块 */
.section {
  background: #fff;
  border-radius: var(--border-radius);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  color: var(--text-main);
  padding-left: 16rpx;
  border-left: 6rpx solid var(--primary-color);
  line-height: 1;
}

.red-theme .section-title {
  border-left-color: var(--danger-color);
}

.info-item {
  display: flex;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.info-item:last-child {
  margin-bottom: 0;
}

.label {
  color: var(--text-sub);
  width: 160rpx;
  flex-shrink: 0;
}

.value {
  color: var(--text-main);
  flex: 1;
}

.value-with-action {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.value-with-action .value {
  flex: 1;
  margin-right: 16rpx;
}

.value-with-action t-button {
  flex-shrink: 0;
  min-width: 120rpx;
}

.value.address {
  word-break: break-all;
}

/* 商品列表 */
.goods-list {
  margin-bottom: 0;
}

.goods-item {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.goods-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  background: #f8f8f8;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.goods-name {
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 10rpx;
  font-weight: 500;
}

.goods-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.goods-price {
  color: var(--text-main);
  font-size: 30rpx;
  font-weight: 500;
}

.quantity {
  color: var(--text-sub);
  font-size: 26rpx;
}

/* 价格汇总 */
.price-summary {
  padding-top: 24rpx;
  border-top: 1rpx solid #f5f5f5;
  margin-top: 10rpx;
}

.price-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  color: var(--text-main);
}

.price-item.total {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 0;
  padding-top: 16rpx;
  border-top: 1rpx dashed #eee;
}

.discount {
  color: #ff9800;
}

.total-amount {
  color: var(--danger-color);
  font-weight: bold;
  font-size: 36rpx;
}

/* 二维码容器 */
.qrcode-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  background: #fff;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
}

.qrcode-image {
  width: 360rpx;
  height: 360rpx;
  margin-bottom: 24rpx;
}

.qrcode-tip {
  font-size: 26rpx;
  color: var(--text-sub);
}

/* 底部按钮 */
.actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: flex-end;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.back-btn {
  min-width: 200rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #f5f5f5;
  color: var(--text-main);
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.loading {
  text-align: center;
  padding: 60rpx 0;
  color: var(--text-sub);
  font-size: 28rpx;
}
