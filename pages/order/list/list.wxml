<view class="orders-container">
  <!-- 搜索框 -->
  <view class="search-container">
    <t-search
      placeholder="搜索订单号"
      value="{{searchKeyword}}"
      bind:change="onSearchChange"
      bind:submit="onSearchConfirm"
      bind:clear="onSearchClear"
    />
    <view class="filter-btn" bindtap="toggleFilterPanel">
      <t-icon name="filter" size="20" />
      <text>筛选</text>
    </view>
  </view>

  <!-- 筛选面板 -->
  <view class="filter-mask" wx:if="{{showFilterPanel}}" catchtap="toggleFilterPanel" catchtouchmove="true"></view>
  <view class="filter-drawer" wx:if="{{showFilterPanel}}">
    <view class="filter-panel">
      <view class="filter-header">
        <text>筛选条件</text>
        <t-icon name="close" size="20" bindtap="toggleFilterPanel" />
      </view>
      <scroll-view scroll-y class="filter-content">
        <view class="filter-item">
          <text class="filter-label">订单时间</text>
          <view class="date-range">
            <picker mode="date" value="{{startDate}}" bindchange="onStartDateChange">
              <view class="date-picker">{{startDate || '开始日期'}}</view>
            </picker>
            <text class="date-separator">至</text>
            <picker mode="date" value="{{endDate}}" bindchange="onEndDateChange">
              <view class="date-picker">{{endDate || '结束日期'}}</view>
            </picker>
          </view>
        </view>
        <view class="filter-item">
          <text class="filter-label">价格区间</text>
          <view class="price-range">
            <t-input
              type="number"
              placeholder="最低价"
              value="{{minPrice}}"
              bind:change="onMinPriceChange"
            />
            <text class="price-separator">至</text>
            <t-input
              type="number"
              placeholder="最高价"
              value="{{maxPrice}}"
              bind:change="onMaxPriceChange"
            />
          </view>
        </view>
      </scroll-view>
      <view class="filter-footer">
        <t-button theme="default" bindtap="resetFilter">重置</t-button>
        <t-button theme="primary" bindtap="applyFilter">确定</t-button>
      </view>
    </view>
  </view>

  <!-- 原生标签页 -->
  <view class="status-tabs">
    <scroll-view class="tabs-scroll" scroll-x enable-flex>
      <view class="tabs-container">
        <view 
          wx:for="{{statusTabs}}" 
          wx:key="value"
          class="tab-item {{activeTab === item.value ? 'active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onTabClick"
        >
          <text class="tab-label">{{item.label}}</text>
          <view class="tab-underline" wx:if="{{activeTab === item.value}}"></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <view class="order-list">
    <view class="loading-wrapper" wx:if="{{loading}}">
      <view class="loading-text">加载中...</view>
    </view>
    <t-empty wx:elif="{{!orders.length}}" description="暂无订单" />
    <view class="orders" wx:else>
      <view class="order-item"
            wx:for="{{orders}}"
            wx:key="_id"
            bindtap="onOrderClick"
            data-orderid="{{item.orderNo}}">
        <view class="order-header">
          <text class="order-no">订单号：{{item.orderNo}}</text>
          <text class="order-status status-{{item.status}}">{{item.statusText}}</text>
        </view>
        <view class="order-info">
          <view class="info-row">
            <text class="label">创建时间：</text>
            <text>{{item.createdTime}}</text>
          </view>
          <view class="info-row" wx:if="{{item.status === 'completed' && item.completedTime}}">
            <text class="label">完成时间：</text>
            <text>{{item.completedTime}}</text>
          </view>
        </view>
        <view class="order-footer">
          <text class="amount">¥{{item.totalAmount}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
