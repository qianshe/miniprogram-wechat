.orders-container {
  padding: 20rpx;
  background: var(--bg-color);
  min-height: 100vh;
}

/* 搜索框样式优化 */
.search-container {
  display: flex;
  padding: 20rpx 24rpx;
  background: #fff;
  align-items: center;
  margin-bottom: 20rpx;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
}

.search-box {
  flex: 1;
  position: relative;
}

.search-input {
  width: 100%;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 70rpx 0 32rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.search-icon {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-sub);
}

.search-icon-text {
  font-size: 32rpx;
  line-height: 1;
}

.filter-btn {
  min-width: 140rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  padding: 0 20rpx;
  background: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: var(--text-main);
  border: 1rpx solid #eee;
  box-shadow: var(--shadow-sm);
}

.filter-btn-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  font-size: 24rpx;
  line-height: 1;
  color: var(--text-sub);
  font-weight: 600;
}

.filter-close-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  font-size: 40rpx;
  line-height: 1;
  color: var(--text-sub);
}

.filter-btn .iconfont {
  font-size: 32rpx;
  margin-right: 8rpx;
}

/* 原生标签页样式 */
.status-tabs {
  background: #fff;
  border-radius: var(--border-radius);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  position: sticky;
  top: 0;
  z-index: 10;
}

.tabs-scroll {
  width: 100%;
  white-space: nowrap;
}

.tabs-container {
  display: flex;
  padding: 10rpx 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 20rpx;
  position: relative;
  transition: all 0.3s ease;
  min-width: 120rpx;
}

.tab-label {
  font-size: 28rpx;
  color: var(--text-sub);
  font-weight: 400;
  transition: all 0.3s ease;
}

.tab-item.active .tab-label {
  color: var(--primary-color);
  font-weight: 600;
  font-size: 30rpx;
}

.tab-underline {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: var(--primary-color);
  border-radius: 3rpx;
  animation: slideIn 0.3s ease;
}

@keyframes slideIn {
  from {
    width: 0;
    opacity: 0;
  }
  to {
    width: 40rpx;
    opacity: 1;
  }
}

/* 红色主题 */
.red-theme .tab-item.active .tab-label {
  color: var(--danger-color);
}

.red-theme .tab-underline {
  background: var(--danger-color);
}

/* 订单列表 */
.order-list {
  padding: 0;
}

.order-item {
  background: #fff;
  border-radius: var(--border-radius);
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

/* 多选模式下的订单项布局 */
.order-item.select-mode {
  padding-left: 20rpx;
  display: flex;
  align-items: flex-start;
}

.order-item.select-mode.selected {
  background: rgba(7, 193, 96, 0.05);
  border: 2rpx solid var(--primary-color);
}

.red-theme .order-item.select-mode.selected {
  background: rgba(244, 67, 54, 0.05);
  border-color: var(--danger-color);
}

/* 状态条装饰 */
.order-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: var(--primary-color);
}

.red-theme .order-item::before {
  background: var(--danger-color);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  margin-bottom: 24rpx;
}

.order-no {
  font-size: 28rpx;
  color: var(--text-main);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-weight: 500;
}

.order-status {
  font-size: 26rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 600;
}

/* 旧状态样式（兼容） */
.status-0 { /* 待支付 */
  color: #ff9800;
  background: rgba(255, 152, 0, 0.1);
}

.status-1 { /* 已支付 */
  color: var(--primary-color);
  background: rgba(7, 193, 96, 0.1);
}

.status-2 { /* 处理中 */
  color: #2196f3;
  background: rgba(33, 150, 243, 0.1);
}

.status-3 { /* 已完成 */
  color: var(--primary-color);
  background: rgba(7, 193, 96, 0.12);
}

.status-4 { /* 已取消 */
  color: var(--text-sub);
  background: #f5f5f5;
}

.status-5 { /* 已服务待付款 */
  color: #e91e63;
  background: rgba(233, 30, 99, 0.12);
}

.red-theme .status-1 {
  color: var(--danger-color);
  background: rgba(244, 67, 54, 0.1);
}

/* ========== 双状态标签系统（新） ========== */

/* 状态标签容器 */
.order-status-tags {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

/* 通用状态标签样式 */
.status-tag {
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
}

/* 订单流程状态颜色 */
.flow-status-0 { /* 待服务 */
  background: #e3f2fd;
  color: #1976d2;
}

.flow-status-1 { /* 服务中 */
  background: #fff3e0;
  color: #f57c00;
}

.flow-status-2 { /* 服务完成 */
  background: #e8f5e9;
  color: #388e3c;
}

.flow-status-3 { /* 已完成 */
  background: #f5f5f5;
  color: #757575;
}

.flow-status-4 { /* 已取消 */
  background: #ffebee;
  color: #d32f2f;
}

/* 支付状态颜色 */
.payment-status-0 { /* 待支付 */
  background: #fff8e1;
  color: #ffa000;
}

.payment-status-1 { /* 已支付 */
  background: #e8f5e9;
  color: #388e3c;
}

/* 红色主题流程状态 */
.red-theme .flow-status-0 {
  background: #ffebee;
  color: #c62828;
}

.red-theme .flow-status-1 {
  background: #fff3e0;
  color: #e65100;
}

.red-theme .flow-status-2 {
  background: #fce4ec;
  color: #c2185b;
}

/* 订单操作按钮区域 */
.order-actions {
  display: flex;
  gap: 16rpx;
}

.order-amount {
  display: flex;
  align-items: center;
}

.amount-label {
  font-size: 26rpx;
  color: var(--text-sub);
}

/* 操作按钮样式 */
.btn {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  border: none;
  line-height: 1.2;
}

.btn::after {
  border: none;
}

.btn-pay {
  background: #07c160;
  color: #fff;
}

.btn-cancel-light {
  background: #fff;
  color: #d32f2f;
  border: 1rpx solid rgba(211, 47, 47, 0.35);
}

.red-theme .btn-pay {
  background: var(--danger-color);
}

/* 订单信息区域 */
.order-info {
  padding: 0;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  font-size: 28rpx;
  font-weight: 500;
}

.info-row .label {
  color: var(--text-sub);
  margin-right: 8rpx;
  min-width: 140rpx;
  font-weight: 400;
}

.info-row text:not(.label) {
  color: var(--text-main);
  font-weight: 500;
}

.goods-list {
  padding: 10rpx 0;
}

.goods-item {
  display: flex;
  margin-bottom: 24rpx;
}

.goods-item:last-child {
  margin-bottom: 0;
}

.goods-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  background: #f8f8f8;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.goods-name {
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-price-quantity {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-price {
  font-size: 30rpx;
  color: var(--text-main);
  font-weight: 500;
}

.goods-quantity {
  font-size: 26rpx;
  color: var(--text-sub);
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx solid #f5f5f5;
  margin-top: 20rpx;
}

.order-time {
  font-size: 24rpx;
  color: var(--text-sub);
}

.order-total {
  font-size: 26rpx;
  color: var(--text-main);
}

.order-info .info-row text.amount {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--danger-color);
}

/* 筛选弹窗优化 */
.filter-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 999;
}

.filter-drawer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  padding: 0 0 env(safe-area-inset-bottom);
}

.filter-panel {
  background: #fff;
  padding: 30rpx 30rpx 24rpx;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.12);
  box-sizing: border-box;
  max-height: 72vh;
  overflow: auto;
}

.filter-header {
  padding: 0 0 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2rpx solid #e8e8e8;
}

.filter-header text {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.filter-content {
  padding: 32rpx 0;
  max-height: 60vh;
  overflow-y: auto;
}

.filter-item {
  margin-bottom: 48rpx;
}

.filter-item:last-child {
  margin-bottom: 0;
}

.filter-label {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 24rpx;
  display: block;
}

.date-range, .price-range {
  display: flex;
  align-items: center;
}

.date-picker, .price-input {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  text-align: center;
  border: 2rpx solid #e0e0e0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.date-picker {
  padding: 0 16rpx;
}

.price-input {
  padding: 0 16rpx;
  box-sizing: border-box;
}

.date-separator, .price-separator {
  margin: 0 24rpx;
  color: #666;
  font-size: 28rpx;
  font-weight: 500;
}

.filter-footer {
  margin-top: 32rpx;
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.reset-btn, .apply-btn {
  width: 46%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.reset-btn {
  background: #f5f5f5;
  color: var(--text-main);
}

.apply-btn {
  background: var(--primary-color);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.red-theme .apply-btn {
  background: var(--danger-color);
  box-shadow: 0 4rpx 12rpx rgba(244, 67, 54, 0.3);
}

/* 加载状态 */
.loading-wrapper {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.loading-text {
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.loading, .empty, .load-more, .no-more {
  text-align: center;
  padding: 40rpx 0;
  color: var(--text-sub);
  font-size: 26rpx;
}

/* 底部操作栏 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
  transition: transform 0.3s ease;
}

.bottom-actions.hidden {
  transform: translateY(100%);
}

/* 左侧选择区域 */
.actions-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.select-all-wrapper {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
}

.select-all-label {
  font-size: 28rpx;
  color: var(--text-main);
  margin-left: 12rpx;
}

.selected-info {
  font-size: 26rpx;
  color: var(--text-sub);
}

/* 右侧按钮区域 */
.actions-right {
  display: flex;
  align-items: center;
}

.total-amount {
  font-size: 26rpx;
  color: var(--text-main);
  margin-right: 24rpx;
}

.total-amount .price {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--danger-color);
  margin-left: 8rpx;
}

.confirm-purchase-btn {
  min-width: 180rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 32rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.confirm-purchase-btn.disabled {
  background: #ccc;
  box-shadow: none;
}

.red-theme .confirm-purchase-btn {
  background: var(--danger-color);
  box-shadow: 0 4rpx 12rpx rgba(244, 67, 54, 0.3);
}

.red-theme .confirm-purchase-btn.disabled {
  background: #ccc;
  box-shadow: none;
}

/* 多选模式下为底部操作栏留出空间 */
.orders-container.select-mode {
  padding-bottom: 160rpx;
}
