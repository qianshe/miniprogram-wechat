.orders-container {
  padding: 20rpx;
  background: var(--bg-color);
  min-height: 100vh;
}

/* 搜索框样式优化 */
.search-container {
  display: flex;
  padding: 20rpx 24rpx;
  background: #fff;
  align-items: center;
  margin-bottom: 20rpx;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
}

.search-box {
  flex: 1;
  position: relative;
}

.search-input {
  width: 100%;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 70rpx 0 32rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.search-icon {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-sub);
}

.filter-btn {
  min-width: 140rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  padding: 0 20rpx;
  background: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: var(--text-main);
  border: 1rpx solid #eee;
  box-shadow: var(--shadow-sm);
}

.filter-btn .iconfont {
  font-size: 32rpx;
  margin-right: 8rpx;
}

/* 标签页样式 */
.custom-tabs {
  background: #fff;
  margin-bottom: 24rpx;
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-sm);
  padding: 10rpx 0;
}

/* 订单列表 */
.order-list {
  padding: 0;
}

.order-item {
  background: #fff;
  border-radius: var(--border-radius);
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
}

/* 状态条装饰 */
.order-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: var(--primary-color);
}

.red-theme .order-item::before {
  background: var(--danger-color);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  margin-bottom: 24rpx;
}

.order-no {
  font-size: 26rpx;
  color: var(--text-sub);
  font-family: monospace;
}

.order-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

/* 状态样式 */
.status-0 { /* 待支付 */
  color: #ff9800;
  background: rgba(255, 152, 0, 0.1);
}

.status-1 { /* 已支付 */
  color: var(--primary-color);
  background: rgba(7, 193, 96, 0.1);
}

.status-2 { /* 已取消 */
  color: var(--text-sub);
  background: #f5f5f5;
}

.status-3 { /* 已退款 */
  color: var(--text-main);
  background: #eee;
}

.red-theme .status-1 {
  color: var(--danger-color);
  background: rgba(244, 67, 54, 0.1);
}

.goods-list {
  padding: 10rpx 0;
}

.goods-item {
  display: flex;
  margin-bottom: 24rpx;
}

.goods-item:last-child {
  margin-bottom: 0;
}

.goods-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 24rpx;
  background: #f8f8f8;
}

.goods-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}

.goods-name {
  font-size: 28rpx;
  color: var(--text-main);
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.goods-price-quantity {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-price {
  font-size: 30rpx;
  color: var(--text-main);
  font-weight: 500;
}

.goods-quantity {
  font-size: 26rpx;
  color: var(--text-sub);
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
  border-top: 1rpx solid #f5f5f5;
  margin-top: 20rpx;
}

.order-time {
  font-size: 24rpx;
  color: var(--text-sub);
}

.order-total {
  font-size: 26rpx;
  color: var(--text-main);
}

.amount {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--danger-color);
}

/* 筛选弹窗优化 */
.filter-header {
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f5f5f5;
}

.filter-header text {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
}

.filter-content {
  padding: 32rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.filter-item {
  margin-bottom: 48rpx;
}

.filter-label {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
  margin-bottom: 24rpx;
  display: block;
}

.date-range, .price-range {
  display: flex;
  align-items: center;
}

.date-picker, .price-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--text-main);
  text-align: center;
  border: 1rpx solid #eee;
}

.date-separator, .price-separator {
  margin: 0 20rpx;
  color: var(--text-sub);
}

.filter-footer {
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  border-top: 1rpx solid #f5f5f5;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.reset-btn, .apply-btn {
  width: 46%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.reset-btn {
  background: #f5f5f5;
  color: var(--text-main);
}

.apply-btn {
  background: var(--primary-color);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.red-theme .apply-btn {
  background: var(--danger-color);
  box-shadow: 0 4rpx 12rpx rgba(244, 67, 54, 0.3);
}

/* 加载状态 */
.loading, .empty, .load-more, .no-more {
  text-align: center;
  padding: 40rpx 0;
  color: var(--text-sub);
  font-size: 26rpx;
}
