.container {
  background: var(--bg-color, #f6f0e7);
  min-height: 100vh;
  padding: 24rpx 24rpx calc(156rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0ebe3;
  border-top-color: #b8865c;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* Section styling matching order pages */
.section {
  background: #fff;
  border-radius: var(--border-radius, 16rpx);
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 12rpx rgba(0,0,0,0.06));
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main, #333);
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid var(--primary-color, #b8865c);
  line-height: 1;
}

/* Info Rows */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f8f5f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: var(--text-sub, #999);
  flex-shrink: 0;
  margin-right: 24rpx;
}

.info-value {
  font-size: 26rpx;
  color: var(--text-main, #333);
  text-align: right;
  flex: 1;
}

/* Goods List matching detail.wxss somewhat */
.goods-list {
  display: flex;
  flex-direction: column;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.goods-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #f8f8f8;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.placeholder-thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-sub, #999);
  font-size: 22rpx;
  border: 1rpx dashed #e0e0e0;
  box-sizing: border-box;
}

.goods-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.goods-name {
  font-size: 28rpx;
  color: var(--text-main, #333);
  font-weight: 500;
  margin-bottom: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.goods-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.goods-qty {
  font-size: 24rpx;
  color: var(--text-sub, #999);
}

.goods-subtotal {
  font-size: 28rpx;
  color: var(--primary-color, #b8865c);
  font-weight: 600;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 24rpx;
  margin-top: 10rpx;
  border-top: 1rpx solid #f5f5f5;
}

.total-label {
  font-size: 28rpx;
  color: var(--text-main, #333);
  font-weight: 600;
}

.total-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color, #b8865c);
}

/* Form Rows */
.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f8f5f0;
}

.form-row:last-child {
  border-bottom: none;
}

.form-row-textarea {
  align-items: flex-start;
  flex-direction: column;
}

.form-label {
  font-size: 26rpx;
  color: var(--text-main, #666);
  flex-shrink: 0;
  width: 160rpx;
}

.form-label.required::before {
  content: '*';
  color: #e64340;
  margin-right: 4rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main, #333);
  text-align: right;
  height: 60rpx;
  line-height: 60rpx;
}

.form-picker {
  flex: 1;
  text-align: right;
}

.placeholder-text {
  color: #ccc;
  font-size: 28rpx;
}

.form-value {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main, #333);
  text-align: right;
}

.form-row-textarea .form-value {
  text-align: left;
  margin-top: 16rpx;
  line-height: 1.5;
  width: 100%;
}

.form-address {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  min-width: 0;
}

.address-copy {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  min-width: 0;
}

.address-text {
  font-size: 26rpx;
  color: var(--text-main, #333);
  text-align: right;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.address-placeholder {
  font-size: 26rpx;
  color: #ccc;
  text-align: right;
}

.address-import-tip {
  font-size: 20rpx;
  color: var(--primary-color, #b8865c);
  background: rgba(184, 134, 92, 0.1);
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  text-align: right;
}

.address-arrow {
  font-size: 32rpx;
  color: #ccc;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  font-size: 26rpx;
  color: var(--text-main, #333);
  line-height: 1.6;
  padding: 16rpx 0;
  box-sizing: border-box;
}

.readonly-tip {
  text-align: center;
  padding: 20rpx;
  font-size: 24rpx;
  color: #999;
  background: #fff9f0;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

/* Action Bar */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, var(--package-accent, #c9a86c) 0%, var(--primary-color, #b8865c) 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(184,134,92,0.3);
  margin: 0;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.submit-btn.disabled {
  background: #ccc;
  box-shadow: none;
}

.submit-btn.outline {
  background: #f5f5f5;
  color: var(--text-main, #333);
  box-shadow: none;
  border: 1rpx solid #e0e0e0;
}

.submit-btn.outline:active {
  background: #ebebeb;
}

/* Address Modal */
.address-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 9999;
}

.address-modal {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 10000;
  max-height: 70vh;
  overflow-y: auto;
  padding-bottom: env(safe-area-inset-bottom);
}

.address-modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  padding: 32rpx;
  text-align: center;
  border-bottom: 1rpx solid #f5f5f5;
}

.address-modal-empty {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}

.address-item {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f8f5f0;
}

.address-item:active {
  background: #fdf9f4;
}

.address-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.address-item-detail {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}
