.append-items-container {
  min-height: 100vh;
  background: var(--bg-color, #f5f5f5);
  padding: 20rpx;
  padding-bottom: 280rpx;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60vh;
  color: var(--text-sub, #999);
  font-size: 28rpx;
}

.section {
  background: var(--card-bg, #fff);
  margin-bottom: 24rpx;
  border-radius: var(--border-radius, 16rpx);
  padding: 32rpx;
  box-shadow: var(--shadow-sm, 0 2rpx 10rpx rgba(0, 0, 0, 0.05));
}

.order-info-section .section-title {
  margin-bottom: 20rpx;
}

.order-info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.order-info-item:last-child {
  padding-bottom: 0;
}

.order-info-label {
  color: var(--text-sub, #666);
}

.order-info-value {
  color: var(--text-main, #333);
  font-weight: 500;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-main, #333);
  padding-left: 16rpx;
  border-left: 6rpx solid var(--primary-color, #07c160);
  line-height: 1;
}

.product-list {
  margin-top: 16rpx;
}

.product-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 20rpx;
}

.product-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.product-info {
  flex: 1;
  min-width: 0;
}

.product-name {
  font-size: 28rpx;
  color: var(--text-main, #333);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
  margin-bottom: 12rpx;
}

.product-price-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.product-unit-price {
  font-size: 24rpx;
  color: var(--text-sub, #999);
}

.product-subtotal {
  font-size: 28rpx;
  color: var(--danger-color, #e53935);
  font-weight: 600;
  white-space: nowrap;
}

.product-action {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

/* 自定义数量选择器 */
.stepper-wrapper {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  overflow: hidden;
}

.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  background: #f5f5f5;
  transition: background 0.2s;
}

.stepper-btn:active {
  background: #e0e0e0;
}

.stepper-btn.minus {
  color: #666;
}

.stepper-btn.minus.disabled {
  color: #ccc;
  pointer-events: none;
}

.stepper-btn.plus {
  color: var(--primary-color, #1677ff);
  font-weight: 600;
}

.stepper-value {
  min-width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  background: #fff;
}

/* 删除按钮 */
.delete-btn {
  padding: 10rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(229, 57, 53, 0.08);
  border-radius: 24rpx;
  transition: background 0.2s;
}

.delete-btn:active {
  background: rgba(229, 57, 53, 0.16);
}

.delete-text {
  font-size: 24rpx;
  color: var(--danger-color, #e53935);
  font-weight: 500;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--card-bg, #fff);
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.amount-info {
  margin-bottom: 20rpx;
}

.amount-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: var(--text-sub, #666);
  margin-bottom: 12rpx;
}

.amount-row:last-child {
  margin-bottom: 0;
}

.amount-row.total {
  font-size: 30rpx;
  color: var(--text-main, #333);
  font-weight: 600;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.amount-row .label {
  color: var(--text-sub, #666);
}

.amount-row .value.append {
  color: #ff9800;
  font-weight: 500;
}

.amount-row .value.total-value {
  color: var(--danger-color, #e53935);
  font-size: 36rpx;
  font-weight: bold;
}

.submit-btn {
  width: 100%;
}

.popup-content {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--card-bg, #fff);
  border-radius: 16rpx;
  overflow: hidden;
}

.product-selector-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
}

.product-selector-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.product-selector-panel {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 90vw;
  height: 70vh;
  transform: translate(-50%, -50%);
  border-radius: 16rpx;
  overflow: hidden;
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  flex-shrink: 0;
}

.popup-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main, #333);
}

.category-product-wrapper {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.category-sidebar {
  width: 180rpx;
  flex-shrink: 0;
  background: var(--bg-color, #f5f5f5);
  height: 100%;
}

.category-item {
  padding: 28rpx 20rpx;
  font-size: 26rpx;
  color: var(--text-sub, #666);
  text-align: center;
  border-left: 4rpx solid transparent;
  background: var(--bg-color, #f5f5f5);
}

.category-item.active {
  background: var(--card-bg, #fff);
  color: var(--primary-color, #07c160);
  font-weight: 500;
  border-left-color: var(--primary-color, #07c160);
}

.product-scroll {
  flex: 1;
  overflow-y: auto;
  background: var(--card-bg, #fff);
}

.product-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  background: var(--card-bg, #fff);
  transition: background-color 0.2s;
}

.product-option:active {
  background: #f9f9f9;
}

.product-option.selected {
  background: #e8f5e9;
}

.product-option .product-name {
  font-size: 28rpx;
  color: var(--text-main, #333);
  flex: 1;
  margin-right: 20rpx;
  margin-bottom: 0;
}

.product-option .product-price {
  font-size: 28rpx;
  color: var(--danger-color, #e53935);
  font-weight: 500;
  min-width: auto;
}

.product-option .selected-tag {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: var(--primary-color, #07c160);
  background: #e8f5e9;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.loading-tips,
.no-more-tips,
.empty-tips {
  text-align: center;
  padding: 40rpx;
  color: var(--text-sub, #999);
  font-size: 26rpx;
}

.swipe-cell-content {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  gap: 16rpx;
  background: var(--card-bg, #fff);
}

.swipe-delete-btn {
  width: 120rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--danger-color, #e53935);
  color: #fff;
  font-size: 28rpx;
}
