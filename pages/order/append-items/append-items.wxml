<wxs src="../../../utils/tools.wxs" module="tools" />
<view class="append-items-container">
  <view class="loading" wx:if="{{loading}}">加载中...</view>
  <block wx:else>
    <!-- 当前订单信息 -->
    <t-cell-group title="当前订单">
      <t-cell title="订单编号" note="{{orderNo}}" />
      <t-cell title="原订单金额" note="¥{{originalAmount}}" />
    </t-cell-group>

    <!-- 已选商品列表 -->
    <view class="section">
      <view class="section-header">
        <text class="section-title">追加商品</text>
        <t-button size="small" theme="primary" bindtap="showProductSelector">+ 选择商品</t-button>
      </view>
      <view class="product-list" wx:if="{{selectedProducts.length}}">
        <view class="product-item" wx:for="{{selectedProducts}}" wx:key="id">
          <text class="product-name">{{item.name}}</text>
          <view class="quantity-control">
            <button class="quantity-btn" bindtap="decreaseQuantity" data-index="{{index}}">-</button>
            <text class="quantity-text">{{item.quantity}}</text>
            <button class="quantity-btn" bindtap="increaseQuantity" data-index="{{index}}">+</button>
          </view>
          <text class="product-price">¥{{tools.formatPrice(item.price * item.quantity)}}</text>
          <button class="remove-btn" bindtap="removeProduct" data-index="{{index}}">×</button>
        </view>
      </view>
      <t-empty wx:else description="请选择要追加的商品" />
    </view>

    <!-- 底部固定栏 -->
    <view class="bottom-bar">
      <view class="amount-info">
        <view class="amount-row">
          <text class="label">原金额：</text>
          <text class="value">¥{{originalAmount}}</text>
        </view>
        <view class="amount-row">
          <text class="label">追加金额：</text>
          <text class="value append">+¥{{appendAmount}}</text>
        </view>
        <view class="amount-row total">
          <text class="label">追加后总计：</text>
          <text class="value total-value">¥{{newTotalAmount}}</text>
        </view>
      </view>
      <t-button theme="primary" class="submit-btn" bindtap="submitAppend" disabled="{{selectedProducts.length === 0}}">确认追加</t-button>
    </view>
  </block>
</view>

<!-- 商品选择弹出层 -->
<t-popup visible="{{showProductSelector}}" placement="bottom" bind:visible-change="onPopupChange">
  <view class="popup-content">
    <view class="popup-header">
      <text class="popup-title">选择商品</text>
      <t-button variant="text" bindtap="hideProductSelector">×</t-button>
    </view>
    <view class="search-container">
      <t-search placeholder="搜索商品" bind:change="onSearchChange" value="{{searchValue}}" />
    </view>
    <scroll-view scroll-y class="product-scroll" bindscrolltolower="onLoadMoreProducts">
      <block wx:if="{{filteredProducts.length > 0}}">
        <view class="product-option" wx:for="{{filteredProducts}}" wx:key="id" bindtap="selectProduct" data-product="{{item}}">
          <text class="product-name">{{item.name}}</text>
          <text class="product-price">¥{{item.price}}</text>
        </view>
      </block>
      <view class="loading-tips" wx:if="{{productsLoading}}">加载中...</view>
      <view class="no-more-tips" wx:elif="{{!productsPagination.hasMore && filteredProducts.length > 0}}">没有更多了</view>
      <view class="empty-tips" wx:elif="{{!productsLoading && filteredProducts.length === 0}}">暂无商品</view>
    </scroll-view>
  </view>
</t-popup>
