<wxs src="../../../utils/tools.wxs" module="tools" />
<view class="append-items-container">
  <view class="loading" wx:if="{{loading}}">加载中...</view>
  <block wx:else>
    <view class="section order-info-section">
      <view class="section-title">当前订单</view>
      <view class="order-info-item">
        <text class="order-info-label">订单编号</text>
        <text class="order-info-value">{{orderNo}}</text>
      </view>
      <view class="order-info-item">
        <text class="order-info-label">原订单金额</text>
        <text class="order-info-value">¥{{originalAmount}}</text>
      </view>
    </view>

    <view class="section">
      <view class="section-header">
        <text class="section-title">追加商品</text>
        <t-button size="small" theme="primary" bindtap="showProductSelector">+ 选择商品</t-button>
      </view>
      <view class="product-list" wx:if="{{selectedProducts.length}}">
        <view class="product-item" wx:for="{{selectedProducts}}" wx:key="id">
          <view class="product-info">
            <text class="product-name">{{item.name}}</text>
            <view class="product-price-row">
              <text class="product-unit-price">¥{{item.price}}/件</text>
              <text class="product-subtotal">¥{{tools.formatPrice(item.price * item.quantity)}}</text>
            </view>
          </view>
          <view class="product-action">
            <view class="stepper-wrapper">
              <view class="stepper-btn minus {{item.quantity <= 1 ? 'disabled' : ''}}" bindtap="onQuantityMinus" data-index="{{index}}">−</view>
              <text class="stepper-value">{{item.quantity}}</text>
              <view class="stepper-btn plus" bindtap="onQuantityPlus" data-index="{{index}}">+</view>
            </view>
            <view class="delete-btn" bindtap="onDeleteProduct" data-index="{{index}}">
              <text class="delete-text">删除</text>
            </view>
          </view>
        </view>
      </view>
      <t-empty wx:else description="请选择要追加的商品" />
    </view>

    <view class="bottom-bar" wx:if="{{!showProductSelector}}">
      <view class="amount-info">
        <view class="amount-row">
          <text class="label">原金额</text>
          <text class="value">¥{{originalAmount}}</text>
        </view>
        <view class="amount-row">
          <text class="label">追加金额</text>
          <text class="value append">+¥{{appendAmount}}</text>
        </view>
        <view class="amount-row total">
          <text class="label">追加后总计</text>
          <text class="value total-value">¥{{newTotalAmount}}</text>
        </view>
      </view>
      <t-button theme="primary" class="submit-btn" bindtap="submitAppend" disabled="{{selectedProducts.length === 0}}">确认追加</t-button>
    </view>
  </block>
</view>

<template name="productSelectorContent">
  <view class="popup-content">
    <view class="popup-header">
      <text class="popup-title">选择商品</text>
      <t-button variant="text" bindtap="hideProductSelector">关闭</t-button>
    </view>
    <view class="category-product-wrapper">
      <scroll-view scroll-y class="category-sidebar">
        <view 
          class="category-item {{currentCategoryIndex === index ? 'active' : ''}}"
          wx:for="{{categories}}"
          wx:key="id"
          bindtap="onCategoryChange"
          data-index="{{index}}"
        >
          {{item.name}}
        </view>
      </scroll-view>
      <scroll-view scroll-y class="product-scroll" bindscrolltolower="onLoadMoreProducts">
        <block wx:if="{{filteredProducts.length > 0}}">
          <view class="product-option {{tools.isProductSelected(selectedProducts, item.id) ? 'selected' : ''}}" wx:for="{{filteredProducts}}" wx:key="id" bindtap="selectProduct" data-index="{{index}}">
            <text class="product-name">{{item.name}}</text>
            <text class="product-price">¥{{item.price}}</text>
            <text class="selected-tag" wx:if="{{tools.isProductSelected(selectedProducts, item.id)}}">已选</text>
          </view>
        </block>
        <view class="loading-tips" wx:if="{{productsLoading}}">加载中...</view>
        <view class="no-more-tips" wx:elif="{{!productsPagination.hasMore && filteredProducts.length > 0}}">没有更多了</view>
        <view class="empty-tips" wx:elif="{{!productsLoading && filteredProducts.length === 0}}">暂无商品</view>
      </scroll-view>
    </view>
  </view>
</template>

<view wx:if="{{showProductSelector}}" class="product-selector-modal" catchtouchmove="preventTouchMove">
  <view class="product-selector-mask" bindtap="hideProductSelector"></view>
  <view class="product-selector-panel" catchtap="stopPropagation">
    <template is="productSelectorContent" data="{{categories, currentCategoryIndex, filteredProducts, selectedProducts, productsLoading, productsPagination}}"/>
  </view>
</view>
