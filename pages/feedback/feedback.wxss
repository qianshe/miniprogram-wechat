.feedback-container {
  padding: 30rpx;
  background: #fff;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 二维码区域样式 */
.qrcode-section {
  padding: 40rpx 30rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  text-align: center;
  width: 100%;
  box-sizing: border-box;
}

.qrcode-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.qrcode-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 32rpx;
  line-height: 1.5;
}

.qrcode-image {
  width: 400rpx;
  height: 400rpx;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.qrcode-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
}
