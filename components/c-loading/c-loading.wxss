/* 加载状态组件样式 */
.c-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.c-loading-spinner {
  border: 4rpx solid var(--package-border, #efe7dc);
  border-top-color: var(--primary-color, #b8865c);
  border-radius: 50%;
  animation: c-loading-spin 0.8s linear infinite;
}

/* 尺寸 - 小 */
.c-loading.size-small .c-loading-spinner {
  width: 24rpx;
  height: 24rpx;
  border-width: 3rpx;
}
.c-loading.size-small .c-loading-text {
  font-size: 22rpx;
  margin-top: 12rpx;
}

/* 尺寸 - 中（默认） */
.c-loading.size-medium .c-loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border-width: 4rpx;
}
.c-loading.size-medium .c-loading-text {
  font-size: 26rpx;
  margin-top: 16rpx;
}

/* 尺寸 - 大 */
.c-loading.size-large .c-loading-spinner {
  width: 56rpx;
  height: 56rpx;
  border-width: 5rpx;
}
.c-loading.size-large .c-loading-text {
  font-size: 30rpx;
  margin-top: 20rpx;
}

.c-loading-text {
  color: var(--text-sub, #6b6b6b);
}

@keyframes c-loading-spin {
  to {
    transform: rotate(360deg);
  }
}
